text(local) LittlerootTown_ProfessorBirchsLab_Text_HeardYouBeatRivalTakePokedex {
	"Prof. Birch: Oh, hi, {PLAYER}{KUN}!\p"
	"I heard you beat {RIVAL} on\n"
	"your first try. That's excellent!\p"
	"{RIVAL}'s been helping with my research\n"
	"for a long time.\p"
	"{RIVAL} has an extensive history as\n"
	"a Trainer already.\p"
	"Here, {PLAYER}{KUN}, as promised\n"
	"here is a Pok\eDex for you."
}

text(local) LittlerootTown_ProfessorBirchsLab_Text_ExplainPokedex {
	"Prof. Birch: The Pok\eDex is a high-tech\n"
	"tool that automatically makes a record\l"
	"of any Pok\emon you meet or catch.\p"
	"My kid, {RIVAL}, goes everywhere\n"
	"with it.\p"
	"Whenever my kid catches a rare Pok\emon\n"
	"and records its data in the Pok\eDex,\l"
	"why, {RIVAL} looks for me while I'm out\l"
	"doing fieldwork, and shows me."
}

text(local) LittlerootTown_ProfessorBirchsLab_Text_MayGotPokedexTooTakeThese {
	"May: Oh, wow, {PLAYER}{KUN}!\n"
	"You got a Pok\eDex, too!\p"
	"That's great! Just like me!\n"
	"I've got something for you, too!"
}

text(local) LittlerootTown_ProfessorBirchsLab_Text_CatchCutePokemonWithPokeBalls {
	"May: It's fun if you can get a lot of\n"
	"Pok\emon!\p"
	"I'm going to look all over the place\n"
	"because I want different Pok\emon.\p"
	"If I find any cute Pok\emon, I'll catch\n"
	"them with Pok\e Balls!"
}

text(local) LittlerootTown_ProfessorBirchsLab_Text_OhYourBagsFull {
	"Oh? Your Bag's full."
}

text(local) LittlerootTown_ProfessorBirchsLab_Text_MayWhereShouldIGoNext {
	"May: I wonder where I should go look\n"
	"for Pok\emon next?"
}

text(local) LittlerootTown_ProfessorBirchsLab_Text_BrendanGotPokedexTooTakeThese {
	"Brendan: Huh\.\n"
	"So you got a Pok\eDex, too.\p"
	"Well then, here.\n"
	"I'll give you these."
}

text(local) LittlerootTown_ProfessorBirchsLab_Text_CatchCoolPokemonWithPokeBalls {
	"Brendan: You know it's more fun to\n"
	"have a whole bunch of Pok\emon.\p"
	"I'm going to explore all over the place\n"
	"to find different Pok\emon.\p"
	"If I find any cool Pok\emon, you bet\n"
	"I'll try to get them with POKé BALLS."
}

text(local) LittlerootTown_ProfessorBirchsLab_Text_HeyYourBagsFull {
	"Hey, your Bag's full."
}

text(local) LittlerootTown_ProfessorBirchsLab_Text_BrendanWhereShouldIGoNext {
	"Brendan: Where should I look for\n"
	"Pok\emon next\."
}

text(local) LittlerootTown_ProfessorBirchsLab_Text_OtherRegionsUpgradeToNational {
	"Prof. Birch: No\.…\p"
	"{PLAYER}{KUN} and {RIVAL}, I've had the two\n"
	"of you help me study Pok\emon.\p"
	"Thanks to your help, new facts\n"
	"are coming to light.\p"
	"It appears that in the Hoenn region,\n"
	"there are also Pok\emon from other\l"
	"regions.\p"
	"It goes to show how rich and varied\n"
	"the natural environments of Hoenn\l"
	"happen to be.\p"
	"That's why I think it's necessary for\n"
	"me to upgrade your Pok\eDex to\l"
	"the National Mode.\p"
	"Here, let me see your Pok\eDex units."
}

text(local) LittlerootTown_ProfessorBirchsLab_Text_CompletedDexChoosePokemon {
	"Prof. Birch: Oh, {PLAYER}{KUN}!\n"
	"Let's have a look at your Pok\eDex.\p"
	"\. \. \. \. \. \.\n"
	"\. \. \. \. \. \.\p"
	"Yes, there's no doubt about it.\p"
	"You really have completed the Hoenn\n"
	"region's Pok\eDex.\p"
	"That's more than just impressive.\p"
	"I have a gift for you.\p"
	"Consider it my show of appreciation\n"
	"for the fantastic work you've done.\p"
	"My gift is a rare Pok\emon only found\n"
	"in another region!\p"
	"You can have any one of these\n"
	"three Pok\emon!"
}

text(local) LittlerootTown_ProfessorBirchsLab_Text_GrassyPatchWaiting {
	"Prof. Birch: Listen, {PLAYER}{KUN}.\n"
	"You've completed the Hoenn Pok\eDex,\l"
	"but your Pok\emon journey isn't over.\p"
	"There is no end to the road\n"
	"that is Pok\emon.\p"
	"Somewhere, there is a grassy patch\n"
	"that's waiting for you!"
}

text(local) LittlerootTown_ProfessorBirchsLab_Text_BetterLeaveOthersAlone {
	"You received the promised Pok\emon.\n"
	"Better leave the others alone."
}


script(local) Script_BirchLab_PokedexEvent {
	lockall
	call(BirchLab_PokedexEvent_InitialMovements)
	call(BirchLab_PokedexEvent_EmphasisBirchBeforeTalking)
	msgbox(LittlerootTown_ProfessorBirchsLab_Text_HeardYouBeatRivalTakePokedex)
	call(BirchLab_PokedexEvent_GivePokedex)
	msgbox(LittlerootTown_ProfessorBirchsLab_Text_ExplainPokedex)
	call(BirchLab_PokedexEvent_GiveStarterItems)
	applymovement(LOCALID_PLAYER, Common_Movement_WalkInPlaceFasterUp)
	msgbox(BirchLab_PokedexEvent_GoodLuckOnYourAdventure)

	setvar(VAR_QUEST_INTRO_STATE, 9) // Quest Complete
	setvar(VAR_RIVAL_STATE, 5) // Rival in house after Pokedex.
	setflag(FLAG_ADVENTURE_STARTED)
	setvar(VAR_OLDALE_TOWN_STATE, 1)
	releaseall
	end
}

script(local) BirchLab_PokedexEvent_InitialMovements {
	applymovement(LOCALID_PLAYER, moves(
		walk_up * 7
	))
	applymovement(LOCALID_BIRCHS_LAB_RIVAL, moves(
		delay_8 * 5
		walk_right
		walk_up * 3
		walk_right
	))
	waitmovement(0)
	return
}

script(local) BirchLab_PokedexEvent_EmphasisBirchBeforeTalking {
	applymovement(LOCALID_BIRCHS_LAB_BIRCH, moves(walk_in_place_faster_down))
	waitmovement(0)
	return
}

script(local) BirchLab_PokedexEvent_GivePokedex {
	
	// Received PokeDex
	playfanfare(MUS_OBTAIN_ITEM)
	msgbox(BirchLab_PokedexEvent_ReceivedPokedex_Text)
	waitfanfare
	closemessage

	// Set appropriate flags
	setflag(FLAG_SYS_POKEDEX_GET) // Unlock Pokedex menu option
	special(SetUnlockedPokedexFlags)
	setflag(FLAG_RECEIVED_POKEDEX_FROM_BIRCH)

	return
}
text(local) BirchLab_PokedexEvent_ReceivedPokedex_Text {
	"{PLAYER} received the Pok\eDex!"
}

script(local) BirchLab_PokedexEvent_GiveStarterItems {
	// Give all starter items to the player.
	giveitemfast(ITEM_POKE_BALL, 99)
	giveitemfast(ITEM_QUICK_BALL, 99)
	giveitemfast(ITEM_ORAN_BERRY, 10)

	// Birch gives Poke & Quick balls.
	msgbox(BirchLab_PokedexEvent_BirchBall_Text, MSGBOX_NPC)
	playfanfare(MUS_OBTAIN_ITEM)
	msgbox(BirchLab_PokedexEvent_RecievedBalls_Text)
	waitfanfare
	closemessage

	// Face rival for berries
	applymovement(LOCALID_PLAYER, moves( face_left))
	waitmovement(0)

	// Rival gives Berries
	msgbox(BirchLab_PokedexEvent_RivalBerry_BeforeText,MSGBOX_NPC)
	waitmessage
	playfanfare(MUS_OBTAIN_ITEM)
	msgbox(BirchLab_PokedexEvent_RecievedBerries_Text)
	waitfanfare
	closemessage

	msgbox(BirchLab_PokedexEvent_RivalBerry_AfterText, MSGBOX_NPC)
	waitmessage

	return
}

text(local) BirchLab_PokedexEvent_BirchBall_Text {
	"Prof. Birch: Oh, also {PLAYER}{KUN},\n"
	"these will help get you started\l"
	"on completing the Pok\eDex."
}

text(local) BirchLab_PokedexEvent_RecievedBalls_Text {
	"{PLAYER} received 99 Pok\e Balls\n"
	"and 99 Quick Balls!"
}

text(local) BirchLab_PokedexEvent_RivalBerry_BeforeText {
	"{RIVAL}: Take these as a gift from me.\n"
	"They can be suprisingly helpful\l"
	"in a battle." 
}
text(local) BirchLab_PokedexEvent_RivalBerry_AfterText {
	"Remember though, while most held\n"
	"items are returned after battle,\l"
	"berries are not.\p"
	"Thankfully though, they are pretty\n"
	"easy to grow more of!"
}

text(local) BirchLab_PokedexEvent_RecievedBerries_Text {
	"{PLAYER} received 10 Oran Berries."
}

text(local) BirchLab_PokedexEvent_GoodLuckOnYourAdventure {
	"Prof Birch: Well thats all the gifts\n"
	"your Mom and I prepared, and then some.\p"
	"Now, good luck on your Pokémon journey.\n"
}

script LittlerootTown_ProfessorBirchsLab_EventScript_ScottAboardSSTidalCall {
	lockall
	pokenavcall(LittlerootTown_ProfessorBirchsLab_Text_ScottAboardSSTidalCall)
	waitmessage
	clearflag(FLAG_SCOTT_CALL_BATTLE_FRONTIER)
	releaseall
	end
}

text(local) LittlerootTown_ProfessorBirchsLab_Text_ScottAboardSSTidalCall {
	"\. \. \. \. \. \.\n"
	"\. \. \. \. \. Beep!\p"
	"Scott: Hi, hi, {PLAYER}!\n"
	"It's me, Scott.\p"
	"I'm aboard the S.S. Tidal now.\n"
	"It feels great to be on the sea!\p"
	"By the way…\p"
	"There's this place that I'd like to\n"
	"invite you to for a visit.\p"
	"If you're interested, board a ferry\n"
	"at either Slateport or Lilycove.\p"
	"I'll fill you in on the details when\n"
	"we meet. I'll be waiting!\p"
	"\. \. \. \. \. \.\n"
	"\. \. \. \. \. Click!"
}