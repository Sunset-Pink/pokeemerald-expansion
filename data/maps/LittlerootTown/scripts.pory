raw`
LittlerootTown_EventScript_SetRivalLeftForRoute103::
	setflag FLAG_RIVAL_LEFT_FOR_ROUTE103
	return

LittlerootTown_EventScript_MoveRivalFromOldale::
	setvar VAR_OLDALE_RIVAL_STATE, 2
	setflag FLAG_HIDE_OLDALE_TOWN_RIVAL
	return

LittlerootTown_EventScript_SetExitedHouseAfterLatiSSTicketEvent::
	setvar VAR_RIVAL_HOUSE_STATE, 5
	return

LittlerootTown_EventScript_GoodLuck::
	msgbox LittlerootTown_Text_GoodLuckCatchingPokemon, MSGBOX_DEFAULT
	release
	end

LittlerootTown_Text_GoodLuckCatchingPokemon:
	.string "Are you going to catch POKéMON?\n"
	.string "Good luck!$"
`

mapscripts LittlerootTown_MapScripts {
	MAP_SCRIPT_ON_TRANSITION: Script_LittlerootTown_OnTransition
	MAP_SCRIPT_ON_FRAME_TABLE [
		VAR_QUEST_INTRO_STATE, 1: Script_LittlerootTown_Intro_StepOffTruck

	]
	//MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE []
}

//LittlerootTown_OnTransition:
//	call_if_eq VAR_RIVAL_HOUSE_STATE, 4, LittlerootTown_EventScript_SetExitedHouseAfterLatiSSTicketEvent
//  call_if_eq VAR_OLDALE_RIVAL_STATE, 1, LittlerootTown_EventScript_MoveRivalFromOldale
//	end


script(local) Script_LittlerootTown_OnTransition {
	setflag(FLAG_VISITED_LITTLEROOT_TOWN)
	call(Common_EventScript_SetupRivalGfxId)
	if(checkplayergender == FEMALE) {
		setobjectxyperm(LOCALID_LITTLEROOT_MOM, 14, 8)
	}
	if(var(VAR_QUEST_INTRO_STATE) < 6) {
		call(LittlerootTown_Twin_Reposition_ByRoute)
	} elif(var(VAR_QUEST_INTRO_STATE) == 6) {
		call(LittlerootTown_Twin_Reposition_Default)
	}
	end
}

script Script_LittlerootTown_Intro_StepOffTruck {
	lockall
	if(checkplayergender == MALE) {
		setvar(VAR_0x8004, 5)
		setvar(VAR_0x8005, 8)
	} else {
		setvar(VAR_0x8004, 14)
		setvar(VAR_0x8005, 8)
	}
	call(Script_LittlerootTown_Intro_GoInsideWithMom)
	if(checkplayergender == MALE) {
		setflag(FLAG_HIDE_LITTLEROOT_TOWN_BRENDANS_HOUSE_TRUCK)
		warpsilent(MAP_LITTLEROOT_TOWN_BRENDANS_HOUSE_1F, 8 ,8)
	} else {
		setflag(FLAG_HIDE_LITTLEROOT_TOWN_MAYS_HOUSE_TRUCK)
		warpsilent(MAP_LITTLEROOT_TOWN_MAYS_HOUSE_1F, 2, 8)
	}
	waitstate
	releaseall
	end
}

script Script_LittlerootTown_Intro_OpenDoor {
	opendoor(VAR_0x8004, VAR_0x8005)
	waitdooranim
	return
}

script Script_LittlerootTown_Intro_CloseDoor {
	closedoor(VAR_0x8004, VAR_0x8005)
	waitdooranim
	return
}

script Script_LittlerootTown_Intro_GoInsideWithMom {
	delay(15)
	playse(SE_LEDGE)
	applymovement(LOCALID_PLAYER, moves(
		jump_right
		delay_16 *3
	))
	waitmovement(0)
	call(Script_LittlerootTown_Intro_OpenDoor)
	addobject(LOCALID_LITTLEROOT_MOM)
	applymovement(LOCALID_LITTLEROOT_MOM, moves(
		walk_down
	))
	waitmovement(0)
	call(Script_LittlerootTown_Intro_CloseDoor)
	delay(10)
	applymovement(LOCALID_LITTLEROOT_MOM, moves(
		walk_down
		walk_in_place_faster_left
	))
	waitmovement(0)
	msgbox(LittlerootTown_Mom_OurNewHome_Text)
	closemessage
	applymovement(LOCALID_LITTLEROOT_MOM, moves(
		delay_16
		delay_8
		walk_up
	))
	applymovement(LOCALID_PLAYER, moves(
		delay_16
		delay_8
		walk_right
		walk_in_place_faster_up
	))
	waitmovement(0)
	call(Script_LittlerootTown_Intro_OpenDoor)
	applymovement(LOCALID_LITTLEROOT_MOM, moves(
		walk_up
		set_invisible
	))
	applymovement(LOCALID_PLAYER, moves(
		walk_up *2
	))
	waitmovement
	setflag(FLAG_HIDE_LITTLEROOT_TOWN_MOM_OUTSIDE)
	setvar(VAR_QUEST_INTRO_STATE, 1)
	hideplayer
	call(Script_LittlerootTown_Intro_CloseDoor)
	clearflag(FLAG_HIDE_LITTLEROOT_TOWN_FAT_MAN)
	clearflag(FLAG_HIDE_MAP_NAME_POPUP)
	return
}

script LittlerootTown_FatMan {
	msgbox(LittlerootTown_FatMan_UsePCToStoreItems_Text, MSGBOX_NPC)
	end
}

text(local) LittlerootTown_FatMan_UsePCToStoreItems_Text {
	"If you use a PC, you can store items\n"
	"and Pokemon.\p"
	"The power of science is staggering!"
}

script LittlerootTown_Boy {
	msgbox(LittlerootTown_Boy_ProfBitch_Text, MSGBOX_NPC)
	end
}

text(local) LittlerootTown_Boy_ProfBitch_Text {
	"Prof. Birch tries to spend time\n"
	"in the wild. But he is absolutely\l"
	"useless in the field.\p"
	"One time he got absolutely swarmed\n"
	"by some Zigzagoons. Talk about\l"
	"useless.\p"
	"Might as well start calling him\n"
	"Prof. Bitch."
}

text(local) LittlerootTown_Mom_OurNewHome_Text {
	"Mom: {PLAYER}, we're here, honey!\p"
	"It must be tiring riding with our things\n"
	"in the moving truck.\p"
	"Well, this is Littleroot Town.\p"
	"How do you like it?\n"
	"This is our new home!\p"
	"It has a quaint feel, but it seems to be\n"
	"an easy place to live, don't you think?\p"
	"And, you get your own room, {PLAYER}!\n"
	"Let's go inside.$"
}

