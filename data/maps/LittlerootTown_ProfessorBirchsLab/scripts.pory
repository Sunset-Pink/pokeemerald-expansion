mapscripts LittlerootTown_ProfessorBirchsLab_MapScripts {
	MAP_SCRIPT_ON_TRANSITION: Script_LittlerootTown_ProfessorBirchsLab_OnTransition
	MAP_SCRIPT_ON_FRAME_TABLE [
		VAR_QUEST_INTRO_STATE, 8: Script_BirchLab_PokedexEvent
	]
}

script Script_LittlerootTown_ProfessorBirchsLab_OnTransition {
	call(Common_EventScript_SetupRivalGfxId)
	if(var(VAR_QUEST_INTRO_STATE) < 7) {
		setvar(VAR_TEMP_F, 0)
	}

	if(var(VAR_QUEST_INTRO_STATE) == 8) {
		setobjectxyperm(LOCALID_BIRCHS_LAB_BIRCH, 6, 4)
		setobjectmovementtype(LOCALID_BIRCHS_LAB_BIRCH, MOVEMENT_TYPE_FACE_DOWN)
		addobject(LOCALID_BIRCHS_LAB_RIVAL)
		clearflag(FLAG_HIDE_LITTLEROOT_TOWN_BIRCHS_LAB_RIVAL)
	}
}

script LittlerootTown_ProfessorBirchsLab_EventScript_Rival {
	lock
	faceplayer
	if(checkplayergender == MALE) {
		msgbox(LittlerootTown_ProfessorBirchsLab_Text_MayWhereShouldIGoNext, MSGBOX_NPC)
	} else {
		msgbox(LittlerootTown_ProfessorBirchsLab_Text_BrendanWhereShouldIGoNext, MSGBOX_NPC)
	}
	release
	end
}

script Script_LittlerootTown_ProfessorBirchsLab_Interact_Books {
	msgbox(Text_LittlerootTown_ProfessorBirchsLab_Books, MSGBOX_SIGN)
	end
}

text(local) Text_LittlerootTown_ProfessorBirchsLab_Books {
	"It's a book that's too hard to read."
}

script Script_LittlerootTown_ProfessorBirchsLab_Interact_Machine {
	msgbox(Text_LittlerootTown_ProfessorBirchsLab_Machine, MSGBOX_SIGN)
	end
}

text(local) Text_LittlerootTown_ProfessorBirchsLab_Machine {
	"It's a serious-looking machine.\n"
	"The Prof. must use this for research."
}

script Script_LittlerootTown_ProfessorBirchsLab_Interact_PC {
	msgbox(Text_LittlerootTown_ProfessorBirchsLab_PC, MSGBOX_SIGN)
	waitmessage
	end
}

text(local) Text_LittlerootTown_ProfessorBirchsLab_PC {
	"It's a PC used for research.\n"
	"Better not mess around with it."
}

script Script_LittlerootTown_ProfessorBirchsLab_Interact_Bookshelf {
	msgbox(Text_LittlerootTown_ProfessorBirchsLab_Bookshelf)
	end
}

text(local) Text_LittlerootTown_ProfessorBirchsLab_Bookshelf {
	"It's crammed with books on Pok\emon."
}


// Starter Selection

// Left/Grass Starter
script Script_LittlerootTown_ProfessorBirchsLab_Interact_Pokeballs_Left {
	lockall
	if(var(VAR_QUEST_INTRO_STATE) <= 5) {
		msgbox(Text_LittlerootTown_ProfessorBirchsLab_Pokeballs_BeforeSelection)
	}elif(flag(FLAG_SYS_POKEMON_GET) == FALSE) {
		bufferstarterinfo(STR_VAR_1, 0)
		showmonpic(VAR_0x8006, 10, 3)
		msgbox("Do you want to choose {STR_VAR_1}?", MSGBOX_YESNO)
		if(var(VAR_RESULT) == NO) {
			hidemonpic
			msgbox("You did not choose this Pok\emon")
			releaseall
			return
		}
		setvar(VAR_STARTER_MON, 0)
		call(Script_LittlerootTown_ProfessorBirchsLab_GiveStarter)
		playfanfare(MUS_OBTAIN_ITEM)
		msgbox("{PLAYER} received the {STR_VAR_1}")
		waitfanfare
		removeobject(LOCALID_BIRCHS_LAB_LEFT_BALL)
		call(Script_LittlerootTown_ProfessorBirchsLab_Starter_PostChose)
	} else {
		msgbox("Better not get greedy!")
	}
	releaseall
	end
}

// Middle/Fire Starter
