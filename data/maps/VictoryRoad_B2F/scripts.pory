mapscripts VictoryRoad_B2F_MapScripts {}

raw`
VictoryRoad_B2F_EventScript_Vito::
	trainerbattle_single TRAINER_VITO, VictoryRoad_B2F_Text_VitoIntro, VictoryRoad_B2F_Text_VitoDefeat
	msgbox VictoryRoad_B2F_Text_VitoPostBattle, MSGBOX_AUTOCLOSE
	end

VictoryRoad_B2F_EventScript_Owen::
	trainerbattle_single TRAINER_OWEN, VictoryRoad_B2F_Text_OwenIntro, VictoryRoad_B2F_Text_OwenDefeat
	msgbox VictoryRoad_B2F_Text_OwenPostBattle, MSGBOX_AUTOCLOSE
	end

VictoryRoad_B2F_EventScript_Caroline::
	trainerbattle_single TRAINER_CAROLINE, VictoryRoad_B2F_Text_CarolineIntro, VictoryRoad_B2F_Text_CarolineDefeat
	msgbox VictoryRoad_B2F_Text_CarolinePostBattle, MSGBOX_AUTOCLOSE
	end

VictoryRoad_B2F_EventScript_Julie::
	trainerbattle_single TRAINER_JULIE, VictoryRoad_B2F_Text_JulieIntro, VictoryRoad_B2F_Text_JulieDefeat
	msgbox VictoryRoad_B2F_Text_JuliePostBattle, MSGBOX_AUTOCLOSE
	end

VictoryRoad_B2F_EventScript_Felix::
	trainerbattle_single TRAINER_FELIX, VictoryRoad_B2F_Text_FelixIntro, VictoryRoad_B2F_Text_FelixDefeat
	msgbox VictoryRoad_B2F_Text_FelixPostBattle, MSGBOX_AUTOCLOSE
	end

VictoryRoad_B2F_EventScript_Dianne::
	trainerbattle_single TRAINER_DIANNE, VictoryRoad_B2F_Text_DianneIntro, VictoryRoad_B2F_Text_DianneDefeat
	msgbox VictoryRoad_B2F_Text_DiannePostBattle, MSGBOX_AUTOCLOSE
	end
`

text(local) VictoryRoad_B2F_Text_VitoIntro {
    "I trained together with my whole family,\n"
    "every one of us!\l"
	"I'm not losing to anyone!"
}

text(local) VictoryRoad_B2F_Text_VitoDefeat {
	"Better than my family?!\n"
	"Is that possible?!"
}

text(local) VictoryRoad_B2F_Text_VitoPostBattle {
	"I was better than everyone in my\n"
	"family. I've never lost before\.\p"
	"I've lost my confidence\.\n"
	"Maybe I'll go home\."
}

text(local) VictoryRoad_B2F_Text_OwenIntro {
	"I'd heard that there was a tough\n"
	"little kid around. Do they mean you?"
}

text(local) VictoryRoad_B2F_Text_OwenDefeat {
	"The little shrimp is tough!"
}

text(local) VictoryRoad_B2F_Text_OwenPostBattle {
	"The rumors I heard, that tough little\n"
	"kid is from Petalburg City."
}

text(local) VictoryRoad_B2F_Text_CarolineIntro {
	"You must be getting a little tired."
}

text(local) VictoryRoad_B2F_Text_CarolineDefeat {
	"No signs of tiring at all!"
}

text(local) VictoryRoad_B2F_Text_CarolinePostBattle {
	"Victory Road and the Pok\emon League\n"
	"are long and grueling challenges.\l"
	"Beware of fatigue!"
}

text(local) VictoryRoad_B2F_Text_JulieIntro {
	"You shouldn't get complacent just\n"
	"because you have a lot of Gym Badge.\p"
	"There's always going to be someone\n"
	"who's better than you!"
}

text(local) VictoryRoad_B2F_Text_JulieDefeat {
	"You're better than me!"
}

text(local) VictoryRoad_B2F_Text_JuliePostBattle {
	"Gaze on your collected Badges and\n"
	"remember the Trainers you've faced."
}

text(local) VictoryRoad_B2F_Text_FelixIntro {
	"I've come this far, but the tension's\n"
	"giving me awful stomach pain\."
}

text(local) VictoryRoad_B2F_Text_FelixDefeat {
	"Ooh\.\n"
	"It hurts\."
}

text(local) VictoryRoad_B2F_Text_FelixPostBattle {
	"I can't help getting all tense knowing\n"
	"that I'm nearing the Pok\emon League.\p"
	"It's all I can do to feign calm."
}

text(local) VictoryRoad_B2F_Text_DianneIntro {
	"The elite among the elite gather in\n"
	"this cave.\p"
	"How are you finding it?"
}

text(local) VictoryRoad_B2F_Text_DianneDefeat{
	"Not rattled in the least bit!"
}

text(local) VictoryRoad_B2F_Text_DiannePostBattle {
	"You do have guts! I like that!\n"
	"Keep it going!"
}