script PetalburgCity_EventScript_ShowGymToPlayer {
	lockall
	applymovement(LOCALID_GYM_BOY, Common_Movement_FacePlayer)
	waitmovement(0)
	playbgm(MUS_FOLLOW_ME, FALSE)
	playse(SE_PIN)
	applymovement(LOCALID_GYM_BOY, Common_Movement_ExclamationMark)
	waitmovement(0)
	applymovement(LOCALID_GYM_BOY, Common_Movement_Delay48)
	waitmovement(0)
	switch(var(VAR_0x8008)) {
		case 0: call(PetalburgCity_EventScript_BoyApproachPlayer0)
		case 1: call(PetalburgCity_EventScript_BoyApproachPlayer1)
		case 2: call(PetalburgCity_EventScript_BoyApproachPlayer2)
		case 3: call(PetalburgCity_EventScript_BoyApproachPlayer3)
	}
	msgbox(PetalburgCity_Text_AreYouRookieTrainer)
	closemessage
	switch(var(VAR_0x8008)) {
		case 0: call(PetalburgCity_EventScript_LeadPlayerToGym0)
		case 1: call(PetalburgCity_EventScript_LeadPlayerToGym1)
		case 2: call(PetalburgCity_EventScript_LeadPlayerToGym2)
		case 3: call(PetalburgCity_EventScript_LeadPlayerToGym3)
	}
	msgbox(PetalburgCity_Text_ThisIsPetalburgGym)
	applymovement(LOCALID_GYM_BOY, Common_Movement_WalkInPlaceFasterRight)
	applymovement(LOCALID_PLAYER, Common_Movement_WalkInPlaceFasterRight)
	waitmovement(0)
	msgbox(PetalburgCity_Text_ThisIsGymSign)
	closemessage
	applymovement(LOCALID_GYM_BOY, moves(
		walk_down
		walk_left * 11
	))
	waitmovement(0)
	fadedefaultbgm
	releaseall
	end
}

