text gText_ConfirmSave {
	"Would you like to save the game?"
}

text gText_AlreadySavedFile {
	"There is already a saved file.\n"
	"Is it okay to overwrite it?"
}

text gText_SavingDontTurnOff {
	"Saving\.\n"
	"Don't turn off the power."
}

text gText_PlayerSavedGame {
	"{PLAYER} saved the game."
}

text gText_DifferentSaveFile {
	"Warning!\p"
	"There is a different game file that\n"
	"is already saved.\p"
	"If you save now, the other file's\n"
	"adventure, including items and\l"
	"Pok\emon, will be entirely lost.\p"
	"Are you sure you want to save now\n"
	"and overwrite the other save file?"
}

text gText_SaveError {
	"Save error.\p"
	"Please exchange the\n"
	"backup memory."
}

text gText_SavingDontTurnOffPower {
	"Saving\.\n"
	"Don't turn off the power."
}
