mapscripts RusturfTunnel_MapScripts {
	MAP_SCRIPT_ON_TRANSITION: RusturfTunnel_OnTransition
	MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_RUSTURF_TUNNEL_STATE, 4: RusturfTunnel_EventScript_ClearTunnelScene
        VAR_RUSTURF_TUNNEL_STATE, 5: RusturfTunnel_EventScript_ClearTunnelScene
    ]
}

script(local) RusturfTunnel_OnTransition {
    if(var(VAR_RUSTURF_TUNNEL_STATE) == 2) {
        setobjectxyperm(LOCALID_RUSTURF_TUNNEL_PEEKO, 13, 4)
	    setobjectxyperm(LOCALID_RUSTURF_TUNNEL_GRUNT, 13, 5)
    }
	end
}

script RusturfTunnel_EventScript_Wanda {
	lock
	faceplayer
	msgbox(RusturfTunnel_Text_BoyfriendOnOtherSideOfRock)
	closemessage
	applymovement(VAR_LAST_TALKED, Common_Movement_FaceOriginalDirection)
	waitmovement(0)
	release
	end
}

script RusturfTunnel_EventScript_WandasBoyfriend {
	lock
	faceplayer
    if(flag(FLAG_TEMP_1)) {
       msgbox(RusturfTunnel_Text_ToGetToVerdanturf) 
    } else {
        setflag(FLAG_TEMP_1)
        msgbox(RusturfTunnel_Text_WhyCantTheyKeepDigging)
    }
	closemessage
	applymovement(VAR_LAST_TALKED, Common_Movement_FaceOriginalDirection)
	waitmovement(0)
	release
	end
}

script RusturfTunnel_EventScript_ClearTunnelScene {
	lockall
    if(var(VAR_TEMP_1) == 1) {
        applymovement(LOCALID_RUSTURF_TUNNEL_WANDAS_BF, Common_Movement_WalkInPlaceFasterUp)
        waitmovement(0)
        applymovement(LOCALID_PLAYER, Common_Movement_WalkInPlaceFasterDown)
        waitmovement(0)
    } elif (var(VAR_TEMP_1) == 2) {
        applymovement(LOCALID_RUSTURF_TUNNEL_WANDAS_BF, moves(
            walk_up
            walk_in_place_fast_right
        ))
        waitmovement(0)
    }

    // Boyfriend notices
    playse(SE_PIN)
	applymovement(LOCALID_RUSTURF_TUNNEL_WANDAS_BF, Common_Movement_ExclamationMark)
	waitmovement(0)
	applymovement(LOCALID_RUSTURF_TUNNEL_WANDAS_BF, Common_Movement_Delay48)
	waitmovement(0)

	msgbox(RusturfTunnel_Text_YouShatteredBoulderTakeHM)
    if(var(VAR_TEMP_1) == 2 || var(VAR_TEMP_1) == 3) {
        closemessage
        applymovement(LOCALID_RUSTURF_TUNNEL_WANDAS_BF, moves(walk_right))
        waitmovement(0)
    }

	giveitem(ITEM_HM_STRENGTH)
	setflag(FLAG_RECEIVED_HM_STRENGTH)
	msgbox(RusturfTunnel_Text_ExplainStrength)
	closemessage

    // Boyfriend approaches Wanda
    if(var(VAR_TEMP_1) == 1) {
        applymovement(LOCALID_PLAYER, moves(
            walk_left
	        walk_in_place_faster_right
        ))
        applymovement(LOCALID_RUSTURF_TUNNEL_WANDAS_BF, moves(
            walk_in_place_fast_up * 2
            walk_fast_up
            walk_fast_right
        ))
        waitmovement(0)
    } else {
        applymovement(LOCALID_PLAYER, moves(
            walk_right
	        walk_in_place_faster_left
        ))
        applymovement(LOCALID_RUSTURF_TUNNEL_WANDAS_BF, moves(
            walk_in_place_fast_right * 2
            walk_fast_right
            walk_in_place_faster_up
        ))
        waitmovement(0)
        applymovement(LOCALID_RUSTURF_TUNNEL_WANDA, Common_Movement_WalkInPlaceFasterDown)
        waitmovement(0)
    }
	msgbox(RusturfTunnel_Text_WandaReunion)
	closemessage
    if(var(VAR_TEMP_1) != 1) {
        applymovement(LOCALID_PLAYER, moves(
            delay_8
            walk_in_place_faster_up
            delay_16 * 2
            walk_in_place_faster_right
        ))
    }
    applymovement(LOCALID_RUSTURF_TUNNEL_WANDA, moves(
        walk_right * 4
        walk_down * 7
    ))
    if(var(VAR_TEMP_1) == 1) {
        applymovement(LOCALID_RUSTURF_TUNNEL_WANDAS_BF, moves(
            walk_right * 5
            walk_down * 7
        ))
    } else {
        applymovement(LOCALID_RUSTURF_TUNNEL_WANDAS_BF, moves(
            walk_up
            walk_right * 4
            walk_down * 7
        ))
        
    }
    waitmovement(0)
	call(RusturfTunnel_EventScript_SetRusturfTunnelOpen)
	releaseall
	end
}

script RusturfTunnel_EventScript_TunnelBlockagePos1 {
	setvar(VAR_TEMP_1, 1)
	end
}

script RusturfTunnel_EventScript_TunnelBlockagePos2 {
	setvar(VAR_TEMP_1, 2)
	end
}

script RusturfTunnel_EventScript_TunnelBlockagePos3 {
	setvar(VAR_TEMP_1, 3)
	end
}

script RusturfTunnel_EventScript_AquaGruntBackUp {
	lockall
	setflag (FLAG_SAFE_FOLLOWER_MOVEMENT)
	msgbox(RusturfTunnel_Text_ComeAndGetSome)
	closemessage
	applymovement(LOCALID_RUSTURF_TUNNEL_GRUNT, RusturfTunnel_Movement_GruntAndPeekoBackUp)
	applymovement(LOCALID_RUSTURF_TUNNEL_PEEKO, RusturfTunnel_Movement_GruntAndPeekoBackUp)
	waitmovement(0)
	copyobjectxytoperm(LOCALID_RUSTURF_TUNNEL_GRUNT)
	copyobjectxytoperm(LOCALID_RUSTURF_TUNNEL_PEEKO)
	setvar(VAR_RUSTURF_TUNNEL_STATE, 3)
	releaseall
	end
}

movement RusturfTunnel_Movement_GruntAndPeekoBackUp {
	lock_facing_direction
	walk_right
	unlock_facing_direction
}

script RusturfTunnel_EventScript_Peeko {
	lock
	faceplayer
	waitse
	playmoncry(SPECIES_WINGULL, CRY_MODE_NORMAL)
	msgbox(RusturfTunnel_Text_Peeko)
	waitmoncry
	release
	end
}

script RusturfTunnel_EventScript_Grunt {
	lock
	faceplayer
	playbgm(MUS_ENCOUNTER_AQUA, FALSE)
	msgbox(RusturfTunnel_Text_GruntIntro)
	trainerbattle_no_intro(TRAINER_GRUNT_RUSTURF_TUNNEL, RusturfTunnel_Text_GruntDefeat)
	msgbox(RusturfTunnel_Text_GruntTakePackage)
	giveitem(ITEM_DEVON_PARTS)
	closemessage
	applymovement(LOCALID_PLAYER, moves(
        face_down
        lock_facing_direction
        walk_up
        unlock_facing_direction
        walk_in_place_faster_left
    ))
	applymovement(LOCALID_RUSTURF_TUNNEL_GRUNT, moves( walk_fast_left * 9))
	waitmovement(0)
	removeobject(LOCALID_RUSTURF_TUNNEL_GRUNT)
	delay(50)
	addobject(LOCALID_RUSTURF_TUNNEL_BRINEY)
	applymovement(LOCALID_RUSTURF_TUNNEL_BRINEY, moves( walk_right * 7))
	waitmovement(0)
	applymovement(LOCALID_PLAYER, moves(
        walk_down
	    walk_in_place_faster_up
    ))
	applymovement(LOCALID_RUSTURF_TUNNEL_BRINEY, moves(
        delay_16
	    walk_right
    ))
	waitmovement(0)
	msgbox(RusturfTunnel_Text_PeekoGladToSeeYouSafe)
	applymovement(LOCALID_RUSTURF_TUNNEL_BRINEY, Common_Movement_FacePlayer)
	waitmovement(0)
	message(RusturfTunnel_Text_ThankYouLetsGoHomePeeko)
	waitmessage
	waitse
	playmoncry(SPECIES_WINGULL, CRY_MODE_NORMAL)
	waitbuttonpress
	waitmoncry
	closemessage
	applymovement(LOCALID_PLAYER, moves(delay_16
        delay_8
        delay_4
        walk_in_place_faster_left
    ))
	applymovement(LOCALID_RUSTURF_TUNNEL_BRINEY, moves(walk_left * 11))
	applymovement(LOCALID_RUSTURF_TUNNEL_PEEKO, moves(walk_left * 9))
	waitmovement(0)
	removeobject(LOCALID_RUSTURF_TUNNEL_BRINEY)
	removeobject(LOCALID_RUSTURF_TUNNEL_PEEKO)
	clearflag(FLAG_DEVON_GOODS_STOLEN)
	setflag(FLAG_RECOVERED_DEVON_GOODS)
	setvar(VAR_RUSTBORO_CITY_STATE, 4)
	setvar(VAR_BRINEY_HOUSE_STATE, 1)
	setflag(FLAG_HIDE_ROUTE_116_MR_BRINEY)
	release
	end
}

script RusturfTunnel_EventScript_Mike {
	trainerbattle_single(TRAINER_MIKE_2, RusturfTunnel_Text_MikeIntro, RusturfTunnel_Text_MikeDefeat)
	msgbox(RusturfTunnel_Text_MikePostBattle, MSGBOX_AUTOCLOSE)
	end
}

text(local) RusturfTunnel_Text_ComeAndGetSome {
	"What, are you coming?\n"
	"Come and get some, then!"
}

text(local) RusturfTunnel_Text_Peeko {
	"Peeko: Pii pihyoh!"
}

text(local) RusturfTunnel_Text_GruntIntro {
	"Grah, keelhaul it all!\p"
	"That hostage Pok\emon turned out to\n"
	"be worthless!\p"
	"And to think I made a getaway\.\n"
	"In this tunnel to nowhere!\p"
	"Hey! You!\n"
	"So you want to battle me?"
}

text(local) RusturfTunnel_Text_GruntDefeat {
	"Urrrggh! My career in crime comes to\n"
	"a dead end!"
}

text(local) RusturfTunnel_Text_GruntTakePackage {
	"This is plain not right\.\p"
	"The Boss told me this would be a\n"
	"slick-and-easy job to pull.\p"
	"All I had to do was steal some package\n"
	"from Devon.\p"
	"Tch!\n"
	"You want it back that badly, take it!"
}

text(local) RusturfTunnel_Text_PeekoGladToSeeYouSafe {
	"Peeko!\n"
	"Am I glad to see you're safe!"
}

text(local) RusturfTunnel_Text_ThankYouLetsGoHomePeeko {
	"Peeko owes her life to you!\p"
	"They call me Mr. Briney.\n"
	"And, you are?\p"
	"\. \. \. \. \. \. \. \.\n"
	"\. \. \. \. \. \. \. \.\p"
	"Ah, so you are {PLAYER}{KUN}!\n"
	"I sincerely thank you!\p"
	"Now, if there's anything that troubles\n"
	"you, don't hesitate to tell me!\p"
	"You can usually find me in my cottage\n"
	"by the sea near Petalburg Woods.\p"
	"Come, Peeko, we should make our way\n"
	"home.\p"
	"Peeko: Pihyoh!"
}

text(local) RusturfTunnel_Text_WhyCantTheyKeepDigging {
	"\. \.\p"
	"Why can't they keep digging?\n"
	"Is the bedrock too hard?\p"
	"My beloved awaits me in Verdanturf\n"
	"Town just beyond here\.\p"
	"If Rustboro and Verdanturf were\n"
	"joined by this tunnel, I could visit\l"
	"her every day\.\p"
	"But this\.\n"
	"What am I to do?"
}

text(local) RusturfTunnel_Text_ToGetToVerdanturf {
	"To get from Rustboro to Verdanturf,\n"
	"you need to go to Dewford, then pass\l"
	"through Slateport and Mauville\."
}

text(local) RusturfTunnel_Text_YouShatteredBoulderTakeHM {
	"Wow! You shattered that boulder\n"
	"blocking the way.\p"
	"To show you how much I appreciate it,\n"
	"I'd like you to have this HM."
}

text(local) RusturfTunnel_Text_ExplainStrength {
	"That HM contains Strength.\p"
	"If a muscular Pok\emon were to learn\n"
	"that, it would be able to move even\l"
	"large boulders."
}

text(local) RusturfTunnel_Text_WandaReunion {
	"Wanda!\n"
	"Now I can see you anytime!\p"
	"Wanda: That's\.wonderful.\p"
	"Please, take some rest at my home."
}

text(local) RusturfTunnel_Text_BoyfriendOnOtherSideOfRock {
	"On the other side of this rock\.\n"
	"My boyfriend is there.\p"
	"He\. He's not just digging the tunnel\n"
	"to come see me.\p"
	"He works his hands raw and rough\n"
	"for the benefit of everyone."
}

text(local) RusturfTunnel_Text_MikeIntro {
	"What do you call a wild man up in the\n"
	"mountains? A mountain man, right?\p"
	"So why don't they call a Pok\emon in\n"
	"the mountains a mountain Pok\emon?"
}

text(local) RusturfTunnel_Text_MikeDefeat {
	"My Pok\emon\.\n"
	"Ran out of power\."
}

text(local) RusturfTunnel_Text_MikePostBattle {
	"They halted development here to\n"
	"protect Pok\emon, right?\l"
	"There's a feel-good story!"
}

