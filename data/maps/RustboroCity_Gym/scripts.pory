text(local) RustboroCity_Gym_Text_RoxanneRegisterCall {
	"\. \. \. \. \. \.\n"
	"\. \. \. \. \. Beep!\p"
	"Roxanne: Oh, hello, {PLAYER}?\n"
	"This is Roxanne of Rustboro City.\p"
	"I heard from Brawly that you're\n"
	"moving up through the ranks of\l"
	"Trainers at an incredible clip.\p"
	"Well, I'd rather not think that\n"
	"I can't beat you.\p"
	"I promise, I will shape up my Gym\n"
	"so that you may challenge us again.\p"
	"I hope you'll be looking forward to\n"
	"that occasion as much as me!\p"
	"\. \. \. \. \. \.\n"
	"\. \. \. \. \. Click!"
}

text(local) RustboroCity_Gym_Text_RegisteredRoxanne {
	"Registered Gym Leader Roxanne\n"
	"in the Pok\eNav."
}

text(local) RustboroCity_Gym_Text_RoxannePreRematch {
	"Roxanne: I'm so glad to see you again.\n"
	"I'm Roxanne, the Gym Leader here.\p"
	"I'm sure we've both experienced many\n"
	"battles since we last met.\p"
	"I would like to see how much better\n"
	"we've become. Let us battle!"
}

text(local) RustboroCity_Gym_Text_RoxanneRematchDefeat {
	"Grr\.\n"
	"Again, I have lost\."
}

text(local) RustboroCity_Gym_Text_RoxannePostRematch {
	"Roxanne: I still have much to learn\n"
	"when it comes to battling Pok\emon.\p"
	"That awareness makes me love battling\n"
	"all that much more!"
}

text(local) RustboroCity_Gym_Text_RoxanneRematchNeedTwoMons {
	"Roxanne: I'm so glad to see you again.\n"
	"I'm Roxanne, the Gym Leader here.\p"
	"I'm sure we've both experienced many\n"
	"battles since we last met.\p"
	"I would like to see how much better\n"
	"we've become\.\p"
	"Oh, no\.\n"
	"You only have one Pok\emon with you?\p"
	"Please return with at least one more\n"
	"Pok\emon."
}

script RustboroCity_Gym_Mart {
	lock
	faceplayer
	message(gText_HowMayIServeYou)
	waitmessage
	switch(var(VAR_STONE_BADGE_LEVEL)) {
		case 9: pokemart(RustboroGym_Master_Mart)
		case 8: pokemart(RustboroGym_Silver_Mart)
		case 7: pokemart(RustboroGym_Silver_Mart)
		case 6: pokemart(RustboroGym_Silver_Mart)
		case 5: pokemart(RustboroGym_Silver_Mart)
		case 4: pokemart(RustboroGym_Silver_Mart)
		case 3: pokemart(RustboroGym_Silver_Mart)
		case 2: pokemart(RustboroGym_Bronze_Mart)
		case 1: pokemart(RustboroGym_Normal_Mart)
		case 0: pokemart(Basic_Gym_Mart)
		default: pokemart(Basic_Gym_Mart)
	}
	msgbox(gText_PleaseComeAgain)
	release
	end
}

