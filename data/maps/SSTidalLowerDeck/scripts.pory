
mapscripts SSTidalLowerDeck_MapScripts {}
raw`

SSTidalLowerDeck_EventScript_Phillip::
	trainerbattle_single TRAINER_PHILLIP, SSTidalLowerDeck_Text_PhillipIntro, SSTidalLowerDeck_Text_PhillipDefeat
	msgbox SSTidalLowerDeck_Text_PhillipPostBattle, MSGBOX_AUTOCLOSE
	end

SSTidalLowerDeck_EventScript_Leonard::
	trainerbattle_single TRAINER_LEONARD, SSTidalLowerDeck_Text_LeonardIntro, SSTidalLowerDeck_Text_LeonardDefeat
	msgbox SSTidalLowerDeck_Text_LeonardPostBattle, MSGBOX_AUTOCLOSE
	end
`

text(local) SSTidalLowerDeck_Text_PhillipIntro {
	"Arrrgh! I'm fed up and dog-tired of\n"
	"cleaning this huge place!\p"
	"Let's have a quick battle!"
}

text(local) SSTidalLowerDeck_Text_PhillipDefeat {
	"Little bro, I lost!"
}

text(local) SSTidalLowerDeck_Text_PhillipPostBattle {
	"We're the Cleanup Brothers!\p"
	"The old one dumps the detergent,\n"
	"and the young one does the scrubbing!"
}

text(local) SSTidalLowerDeck_Text_LeonardIntro {
	"This is the bottom of the ship's hull.\n"
	"There's plenty of room.\l"
	"It'll be alright for a Pok\emon battle."
}

text(local) SSTidalLowerDeck_Text_LeonardDefeat {
	"Big bro, I lost!"
}

text(local) SSTidalLowerDeck_Text_LeonardPostBattle {
	"We're the Cleanup Brothers!\p"
	"The old one dumps the detergent,\n"
	"and the young one does the scrubbing!"
}

