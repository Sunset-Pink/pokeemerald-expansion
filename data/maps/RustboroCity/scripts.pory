script RustboroCity_EventScript_ReturnGoods {
    if(var(VAR_TEMP_1) == 0) {
	    applymovement(LOCALID_RUSTBORO_DEVON_EMPLOYEE, Common_Movement_WalkInPlaceFasterUp)
    } elif (var(VAR_TEMP_1) == 1) {
	    applymovement(LOCALID_RUSTBORO_DEVON_EMPLOYEE, Common_Movement_WalkInPlaceFasterRight)
    } elif (var(VAR_TEMP_1) == 2 || var(VAR_TEMP_1) == 3) {
	    applymovement(LOCALID_RUSTBORO_DEVON_EMPLOYEE, Common_Movement_WalkInPlaceFasterDown)
    } else {
        applymovement(LOCALID_RUSTBORO_DEVON_EMPLOYEE, Common_Movement_WalkInPlaceFasterLeft)
    }
    waitmovement(0)
    playse(SE_PIN)
    applymovement(LOCALID_RUSTBORO_DEVON_EMPLOYEE, Common_Movement_ExclamationMark)
	waitmovement(0)
	applymovement(LOCALID_RUSTBORO_DEVON_EMPLOYEE, Common_Movement_Delay48)
	waitmovement(0)
    if(var(VAR_TEMP_1) == 3) {
        applymovement(LOCALID_RUSTBORO_DEVON_EMPLOYEE, moves(walk_down))
	    waitmovement(0)
    }
    if(var(VAR_TEMP_1) == 0) {
	    applymovement(LOCALID_PLAYER, Common_Movement_WalkInPlaceFasterDown)
    } elif(var(VAR_TEMP_1) == 1) {
        applymovement(LOCALID_PLAYER, Common_Movement_FaceLeft)
    } elif(var(VAR_TEMP_1) == 2 || var(VAR_TEMP_1) == 3) {
    	applymovement(LOCALID_PLAYER, Common_Movement_WalkInPlaceFasterUp)
    }
    waitmovement(0)
    msgbox(RustboroCity_Text_YouGotItThankYou)
	giveitem(ITEM_GREAT_BALL)
    if(var(VAR_RESULT) == FALSE) {
        msgbox(RustboroCity_Text_YoureLoadedWithItems)
    }
	msgbox(RustboroCity_Text_PleaseComeWithMe)
	closemessage
	setflag(FLAG_RETURNED_DEVON_GOODS)
	setflag(FLAG_HIDE_RUSTBORO_CITY_DEVON_EMPLOYEE_1)
	setvar(VAR_RUSTBORO_CITY_STATE, 5)
	delay(30)
	warp(MAP_RUSTBORO_CITY_DEVON_CORP_3F, 2, 2)
	waitstate
	releaseall
	end
}

script RustboroCity_EventScript_Rival {
	lockall
    if(!flag(FLAG_MET_RIVAL_RUSTBORO)) {
        call(RustboroCity_EventScript_PlayRivalMusic)
    }
    applymovement(LOCALID_RUSTBORO_RIVAL, Common_Movement_FacePlayer)
    waitmovement(0)
    goto(RustboroCity_EventScript_RivalEncounter)
}

script RustboroCity_EventScript_PlayRivalMusic {
    if(checkplayergender == MALE) {
        playbgm(MUS_ENCOUNTER_MAY, TRUE)
    } else {
        playbgm(MUS_ENCOUNTER_BRENDAN, TRUE)
    }
	return
}

script RustboroCity_EventScript_RivalTrigger0 {
    setvar(VAR_TEMP_1, 0)
    call(RustboroCity_EventScript_RivalTrigger)
}

script RustboroCity_EventScript_RivalTrigger {
    lockall
    call(RustboroCity_EventScript_PlayRivalMusic)
    applymovement(LOCALID_RUSTBORO_RIVAL, Common_Movement_WalkInPlaceFasterDown)
    waitmovement(0)
    playse(SE_PIN)
    applymovement(LOCALID_RUSTBORO_RIVAL, Common_Movement_ExclamationMark)
    waitmovement(0)
    applymovement(LOCALID_RUSTBORO_RIVAL, Common_Movement_Delay48)
    waitmovement(0)
    if(var(VAR_TEMP_1) == 0) {
        applymovement(LOCALID_RUSTBORO_RIVAL, moves(
            walk_down
            walk_left * 4
            walk_down
        ))
    } elif(var(VAR_TEMP_1) == 1) {
        applymovement(LOCALID_RUSTBORO_RIVAL, moves(
            walk_down
            walk_left * 3
            walk_down
        ))  
    } elif(var(VAR_TEMP_1) == 2) {
        applymovement(LOCALID_RUSTBORO_RIVAL, moves(
            walk_down
            walk_left * 2
            walk_down
        ))
    } elif(var(VAR_TEMP_1) == 3) {
        applymovement(LOCALID_RUSTBORO_RIVAL, moves(
            walk_down
            walk_left
            walk_down
        ))
    } elif(var(VAR_TEMP_1) == 4) {
        applymovement(LOCALID_RUSTBORO_RIVAL, moves(walk_down * 2))
    } elif(var(VAR_TEMP_1) == 5) {
        applymovement(LOCALID_RUSTBORO_RIVAL, moves(
            walk_down
            walk_right
            walk_down
        ))
    } elif(var(VAR_TEMP_1) == 6) {
        applymovement(LOCALID_RUSTBORO_RIVAL, moves(
            walk_down
            walk_right * 2
            walk_down
        ))
    } else {
        applymovement(LOCALID_RUSTBORO_RIVAL, moves(
            walk_down
            walk_right * 3
            walk_down
        ))
    }
    waitmovement(0)
    applymovement(LOCALID_PLAYER, Common_Movement_WalkInPlaceFasterUp)
    waitmovement(0)
    goto(RustboroCity_EventScript_RivalEncounter)
}

