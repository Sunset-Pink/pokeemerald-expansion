mapscripts RustboroCity_PokemonSchool_MapScripts {}

script RustboroCity_PokemonSchool_EventScript_Blackboard {
	lockall
	msgbox(RustboroCity_PokemonSchool_Text_BlackboardListsStatusChanges)
    do {
        message(RustboroCity_PokemonSchool_Text_ReadWhichTopic)
        waitmessage
        multichoicegrid(8, 1, MULTI_STATUS_INFO, 3, FALSE)
        switch(var(VAR_RESULT)) {
            case 0: msgbox(RustboroCity_PokemonSchool_Text_ExplainPoison)
            case 1: msgbox(RustboroCity_PokemonSchool_Text_ExplainParalysis)
            case 2: msgbox(RustboroCity_PokemonSchool_Text_ExplainSleep)
            case 3: msgbox(RustboroCity_PokemonSchool_Text_ExplainBurn)
            case 4: msgbox(RustboroCity_PokemonSchool_Text_ExplainFreeze)
        }
    } while(var(VAR_RESULT) != MULTI_B_PRESSED)
	releaseall
	end
}

