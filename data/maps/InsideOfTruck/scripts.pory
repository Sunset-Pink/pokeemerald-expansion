script Script_InsideOfTruck_GameInit_ConfigSettings_MinGrindingMenu {
    msgbox(Text_InsideOfTruck_GameInit_ConfigSettings_MinGrinding_Description)
    if(var(FLAG_IS_MIN_GRINDING_MODE)) {
        msgbox(Text_InsideOfTruck_GameInit_ConfigSettings_MinGrinding_TurnOff, MSGBOX_YESNO)
        if(var(VAR_RESULT) == YES) {
            clearflag(FLAG_IS_MIN_GRINDING_MODE)
            msgbox(Text_InsideOfTruck_GameInit_ConfigSettings_MinGrinding_Disabled)
        }
    } else {
        msgbox(Text_InsideOfTruck_GameInit_ConfigSettings_MinGrinding_TurnOn, MSGBOX_YESNO)
        if(var(VAR_RESULT) == YES) {
            clearflag(FLAG_IS_MIN_GRINDING_MODE)
            msgbox(Text_InsideOfTruck_GameInit_ConfigSettings_MinGrinding_Enabled)
        }
    }
    goto(Script_InsideOfTruck_GameInit_ConfigSettings_SettingsMenu)
}

text Text_InsideOfTruck_GameInit_ConfigSettings_MinGrinding_Description {
    "{COLOR GREEN}{SHADOW LIGHT_GREEN}Minimal Griding Mode{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY} guarantees all\n"
    "Pok\emon to have perfect IVs,\l"
    "and EVs cannot be obtained.\l"
    "Boss Pok\emon will not have EVs either.\p"
    "If this mode is disabled, obtainable\n"
    "Pok\emon will have random IVs and can be\l"
    "EV trained.\l"
    "Boss Pok\emon will be EV trained.\p"
    "If you don't know what that all means\n"
    "you want this enabled.\p"
}

text Text_InsideOfTruck_GameInit_ConfigSettings_MinGrinding_TurnOff {
    "Do you want to turn\n"
    "{COLOR RED}{SHADOW LIGHT_RED}Minimal Grinding Mode off?"
}

text Text_InsideOfTruck_GameInit_ConfigSettings_MinGrinding_TurnOn {
    "Do you want to turn\n"
    "{COLOR GREEN}{SHADOW LIGHT_GREEN}Minimal Grinding Mode on?"
}

text Text_InsideOfTruck_GameInit_ConfigSettings_MinGrinding_Enabled {
    "{COLOR GREEN}{SHADOW LIGHT_GREEN}Minimal Grinding Mode enabled."
}

text Text_InsideOfTruck_GameInit_ConfigSettings_MinGrinding_Disabled {
    "{COLOR RED}{SHADOW LIGHT_RED}Minimal Griding Mode disabled."
}

script Script_InsideOfTruck_GameInit_ConfigSettings_SetDefault {
    msgbox(Text_InsideOfTruck_GameInit_ConfigSettings_DefaultSettingsSaved)
    setdifficulty(DIFFICULTY_NORMAL)
    setflag(FLAG_IS_MIN_GRINDING_MODE)
    special(ForceBattleStyleSet)
    releaseall
}

text(local) Text_InsideOfTruck_GameInit_ConfigSettings_DefaultSettingsSaved {
    "Default settings saved.\n"
    "Good luck!"
}

script Script_InsideOfTruck_GameInit_ConfigSettings_SaveSettings {
    msgbox(Text_InsideOfTruck_GameInit_ConfigSettings_CustomSettingsSaved)
    special(ForceBattleStyleSet)
    releaseall
}

text(local) Text_InsideOfTruck_GameInit_ConfigSettings_CustomSettingsSaved {
    "Custom settings saved.\n"
    "Good luck!"
}

script Script_InsideOfTruck_Interact_MovingBox {
    msgbox(Text_InsideOfTruck_BoxPrintedWithMonLogo, MSGBOX_SIGN)
    end
}

text(local) Text_InsideOfTruck_BoxPrintedWithMonLogo {
    "The box is printed with a Pok\emon logo.\p"
    "It's a Pok\emon brand moving and\n"
    "delivery service."
}