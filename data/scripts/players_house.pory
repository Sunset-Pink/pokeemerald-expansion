script Script_PlayersHouse_1F_Interact_RunningShoesManual {
	msgbox(Text_PlayersHouse_1F_RunningShoesManual)
}

text Text_PlayersHouse_1F_RunningShoesManual {
	"It's the instruction booklet for the\n"
	"Running Shoes.\p"
	"Press the B Button to run while\n"
	"wearing your Running Shoes.\p"
	"\qoLace up your Running Shoes and hit\n"
	"the road running!\qc"
}

text Text_PlayersHouse_1F_Dad_TicketFromBriney {
	"Dad: Hm?\p"
	"Hey, it's {PLAYER}!\p"
	"It's been a while since I saw you,\n"
	"but you look…stronger, somehow.\p"
	"That's the impression I get.\n"
	"But your old man hasn't given up yet!\p"
	"Oh, yes, I have something for you.\n"
	"This came to you from someone named\l"
	"Mr. Briney."
}
text Text_PlayersHouse_1F_Dad_TicketsForFerry {
	"Dad: Hm, a Ticket for a ferry?"
	"If I recall, there are ferry ports in\n"
	"Slateport and Lilycove."
}

text Text_PlayersHouse_1F_Dad_BetterGetBackToGym {
	"I'd better get back to Petalburg Gym.\p"
	"Mom, thanks for looking after the house\n"
	"while I'm away."
}

text Text_PlayersHouse_1F_Mom_DadShouldStayLonger {
	"Mom: That Dad of yours\.\p"
	"He comes home for the first time in a\n"
	"while, but all he talks about is Pok\emon.\p"
	"He should relax and stay a little longer.$"
}

text Text_PlayersHouse_1F_Mom_BreakingNews {
	"Mom: Is that a breaking news story?"
}

text Text_PlayersHouse_1F_Mom_WhatColor {
	"Mom: {PLAYER}, did you catch that?\p"
	"What color did the announcer say\n"
	"that Pok\emon was?$"
}

text Text_PlayersHouse_1F_Mom_StillUnknownPokemon {
	"Mom: Well, isn't that something!\n"
	"There are still unknown Pok\emon.$"
}

script Script_PlayersHouse_2F_BlockStairsUntilGiftIsAccepted {
	setvar(VAR_QUEST_INTRO_STATE, 3)
	return
}


script Script_PlayersHouse_2F_Interact_MomsGift {
	lockall
	msgbox(Text_PlayersHouse_2F_MomsGift_Note)
	giveitem(ITEM_OVAL_CHARM, 1)
	giveitem(ITEM_CATCHING_CHARM, 1)
	giveitem(ITEM_SHINY_CHARM, 1)
	waitmessage
	setvar(VAR_QUEST_INTRO_STATE, 4)
	setflag(FLAG_HIDE_MOMS_GIFT_BRENDANS_HOUSE)
	setflag(FLAG_HIDE_MOMS_GIFT_MAYS_HOUSE)
	setflag(FLAG_HIDE_LITTLEROOT_TOWN_PLAYERS_HOUSE_VIGOROTHS)
	removeobject(VAR_LAST_TALKED)
	call(Script_PlayersHouse_2F_Mom_ApproachPlayer)
	msgbox(Text_PlayersHouse_2F_Mom_HowDoYouLikeYourRoom)
	waitmessage
	call(Script_PlayersHouse_2F_Mom_Leaves)
	releaseall
	end
}

text Text_PlayersHouse_2F_MomsGift_Note {
	"\qoI know moving to Hoenn wasn't\n"
	"really what you wanted. But hopefully\l"
	"these will make your time in Hoenn,\l"
	"that much more exciting!\qc - Mom"
}

script(local) Script_PlayersHouse_2F_Mom_ApproachPlayer {
	addobject(LOCALID_PLAYERS_HOUSE_2F_MOM)
	if(checkplayergender == MALE) {
		call(Script_PlayersHouse_2F_Mom_ApproachPlayer_Male)
	} else {
		call(Script_PlayersHouse_2F_Mom_ApproachPlayer_Female)
	}
	return
}

script(local) Script_PlayersHouse_2F_Mom_ApproachPlayer_North {
	if(checkplayergender == MALE) {
		applymovement(LOCALID_PLAYERS_HOUSE_2F_MOM, moves(
			walk_down * 3
			face_left
		))
		waitmovement(0)
	} else {
		applymovement(LOCALID_PLAYERS_HOUSE_2F_MOM, moves(
			walk_down * 3
			face_right
		))
		waitmovement(0)
	}
}

script(local) Script_PlayersHouse_2F_Mom_ApproachPlayer_West {
	if(checkplayergender == MALE) {
		applymovement(LOCALID_PLAYERS_HOUSE_2F_MOM, moves(
			walk_down * 3
			face_down
		))
		waitmovement(0)
	}
}


script(local) Script_PlayersHouse_2F_Mom_ApproachPlayer_South {
	applymovement(LOCALID_PLAYERS_HOUSE_2F_MOM, moves(
		walk_down * 5
		face_player
	))
	waitmovement(0)
}

script(local) Script_PlayersHouse_2F_Mom_ApproachPlayer_Male {
	switch(var(VAR_FACING)) {
		case DIR_NORTH: 
			call(Script_PlayersHouse_2F_Mom_ApproachPlayer_South)
		case DIR_SOUTH: 
			call(Script_PlayersHouse_2F_Mom_ApproachPlayer_North)
		case DIR_EAST: 
			call(Script_PlayersHouse_2F_Mom_ApproachPlayer_Male_East)
		case DIR_WEST: 
			call(Script_PlayersHouse_2F_Mom_ApproachPlayer_West)
	}
	return
}

script(local) Script_PlayersHouse_2F_Mom_ApproachPlayer_Male_East {
	applymovement(LOCALID_PLAYERS_HOUSE_2F_MOM, moves(
		walk_down * 3
		walk_left * 2
		face_player
	))
	waitmovement(0)
}

script(local) Script_PlayersHouse_2F_Mom_ApproachPlayer_Female {
	switch(var(VAR_FACING)) {
		case DIR_NORTH: 
			call(Script_PlayersHouse_2F_Mom_ApproachPlayer_South)
			break
		case DIR_SOUTH: 
			call(Script_PlayersHouse_2F_Mom_ApproachPlayer_North)
			break
		case DIR_EAST: 
			call(Script_PlayersHouse_2F_Mom_ApproachPlayer_West)
			break
		case DIR_WEST: 
			call(Script_PlayersHouse_2F_Mom_ApproachPlayer_Female_East)
			break
	}
	return
}

script(local) Script_PlayersHouse_2F_Mom_ApproachPlayer_Female_East {
	applymovement(LOCALID_PLAYERS_HOUSE_2F_MOM, moves(
		walk_down * 3
		walk_right * 2
		face_player
	))
	waitmovement(0)
}

script(local) Script_PlayersHouse_2F_Mom_Leaves {
	

	if(var(VAR_FACING) == DIR_SOUTH) {
		applymovement(LOCALID_PLAYERS_HOUSE_2F_MOM, moves(
			walk_up * 3
			set_invisible
		))
		waitmovement(0)
	} elif(var(VAR_FACING) == DIR_NORTH) {
		applymovement(LOCALID_PLAYERS_HOUSE_2F_MOM, moves(
			walk_up * 5
			set_invisible 
		))
		waitmovement(0)
	} elif(var(VAR_FACING) == DIR_WEST) {
		if(checkplayergender == MALE) {
			applymovement(LOCALID_PLAYERS_HOUSE_2F_MOM, moves(
				walk_up * 3
				set_invisible
			))
			waitmovement(0)
		} else {
			applymovement(LOCALID_PLAYERS_HOUSE_2F_MOM, moves(
				walk_left * 2
				walk_up * 3
				set_invisible
			))
			waitmovement(0)
		}
	} elif(var(VAR_FACING) == DIR_EAST) {
		if(checkplayergender == MALE) {
			applymovement(LOCALID_PLAYERS_HOUSE_2F_MOM, moves(
				walk_right * 2
				walk_up * 3 
				set_invisible
			))
			waitmovement(0)
		} else {
			applymovement(LOCALID_PLAYERS_HOUSE_2F_MOM, moves(
				walk_up * 3
				set_invisible
			))
			waitmovement(0)
		}
	}
	removeobject(LOCALID_PLAYERS_HOUSE_2F_MOM)
}

text(local) Text_PlayersHouse_2F_Mom_HowDoYouLikeYourRoom {
	"Mom: {PLAYER}, how do you like your\n"
	"new room?\p"
	"Good! Everything's put away neatly!\p"
	"They finished moving everything in\n"
	"downstairs, too.\p"
	"Pok\emon movers are so convenient!\p"
	"The movers found a notebook that look\n"
	"important, they put it on your desk.\p"
	"Otherwise, I hope you liked your gift!\n"
	"you will need to go visit Prof. Birch\l"
	"in his lab for the second part of it."
}

script Script_PlayersHouse_2F_Interact_Notebook {
	msgbox(Text_PlayersHouse_2F_Notebook, MSGBOX_SIGN)
	end
}

text(local) Text_PlayersHouse_2F_Notebook {
	"{PLAYER} flipped open the notebook.\n"
	"{UP_ARROW}{UP_ARROW}{DOWN_ARROW}{DOWN_ARROW}{LEFT_ARROW}{RIGHT_ARROW}{LEFT_ARROW}{RIGHT_ARROW}{B_BUTTON}{A_BUTTON}\l"
	"The book is filled with cheat codes.\p"
	"Effect - Code1/Code2\n"
	"DexNav All - DexAll/Dxa\l"
	"\triCaught All - CaughtAll/Cal\l"
	"Eazy Catch - EZCatch/Ezc\l"
	"Shiny Starter - ShinyS/Shs\l"
	"\triMax Money - MaxMoney/Mmy\l"
	"Shiny Legends - ShinyL/Shl\l"
	"Mono Starter - Mono\l"
	"\triCodes cannot be reverted.\p"
}

script Script_PlayersHouse_2F_Interact_GameCube {
	msgbox(Text_PlayersHouse_2F_GameCube_EnterCode, MSGBOX_YESNO)
	if(var(VAR_RESULT) == NO) {
		releaseall
		end
	}
	special(EnterCode)
	waitstate
	special(GetCodeFeedback)
	if(var(VAR_RESULT) <= 0 || var(VAR_RESULT) > 7) {
		msgbox(Text_PlayersHouse_2F_GameCube_Code_Fail)
		waitmessage
		releaseall
		end
	}
	msgbox(Text_PlayersHouse_2F_GameCube_Code_Success)
	if(var(VAR_RESULT) == 1) {
		if(flag(FLAG_DEXALL)) {
			msgbox(Text_PlayersHouse_2F_GameCube_Code_DexAll_On)
		} else {
			msgbox(Text_PlayersHouse_2F_GameCube_Code_DexAll_Off)
		}
	} elif (var(VAR_RESULT) == 2) {
		msgbox(Text_PlayersHouse_2F_GameCube_Code_CaughtAll_On)
	} elif (var(VAR_RESULT) == 3) {
		if(flag(FLAG_EZCATCH)) {
			msgbox(Text_PlayersHouse_2F_GameCube_Code_EzCatch_On)
		} else {
			msgbox(Text_PlayersHouse_2F_GameCube_Code_EzCatch_Off)
		}
	} elif (var(VAR_RESULT) == 4) {
		if(flag(FLAG_SHINY_STARTERS)) {
			msgbox(Text_PlayersHouse_2F_GameCube_Code_ShinyStarter_On)
		} else {
			msgbox(Text_PlayersHouse_2F_GameCube_Code_ShinyStarter_Off)
		}
	} elif (var(VAR_RESULT) == 5) {
		msgbox(Text_PlayersHouse_2F_GameCube_Code_MaxMoney)
	} elif (var(VAR_RESULT) == 6) {
		if(flag(FLAG_SHINY_LEGENDS)) {
			msgbox(Text_PlayersHouse_2F_GameCube_Code_ShinyLegends_On)
		} else {
			msgbox(Text_PlayersHouse_2F_GameCube_Code_ShinyLegends_Off)
		}
	} elif (var(VAR_RESULT) == 7) {
		if(flag(FLAG_MONOTYPE_STARTERS)) {
			msgbox(Text_PlayersHouse_2F_GameCube_Code_MonoStarter_On)
		} else {
			msgbox(Text_PlayersHouse_2F_GameCube_Code_MonoStarter_Off)
		}
	}
	waitmessage
	releaseall
	end
}

