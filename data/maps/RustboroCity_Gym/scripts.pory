mapscripts RustboroCity_Gym_MapScripts {}

script RustboroCity_Gym_EventScript_GymGuide {
	lock
	faceplayer
	switch(var(VAR_STONE_BADGE_LEVEL)) {
		case 1:msgbox(RustboroCity_Gym_Text_GymGuidePostVictory)
		defeault: msgbox(RustboroCity_Gym_Text_GymGuideAdvice)
	}
	release
	end
}

text(local) RustboroCity_Gym_Text_GymGuideAdvice {
	"Yo, how's it going?\p"
	"Listen, my friend!\n"
	"Would you like to become the Champion?\p"
	"I'm no Trainer, not me, but I can\n"
	"sure give you winning advice.\p"
	"That's settled, then! We'll aim for the\n"
	"Pok\emon Championship together!\p"
	"It's your job as a Trainer to collect\n"
	"Gym Badges, am I right?\p"
	"But Gym Leaders aren't pushovers!\p"
	"And that's where I come in!\n"
	"I'm here to provide expert advice!\p"
	"Roxanne, the Gym Leader, is a user\n"
	"of Rock-type Pok\emon.\p"
	"The Rock type is very durable, but\n"
	"it can't stand Water-type and\l"
	"Grass-type moves.\p"
	"Come see me afterwards, if you beat\n"
	"the Gym Leader.\p"
	"Well, go for it!"
}

text(local) RustboroCity_Gym_Text_GymGuidePostVictory {
	"Whoa! What a breathtaking victory!\n"
	"My cheering must've worked!\p"
	"Great!\n"
	"Check your Trainer Card.\p"
	"The Stone Badge you got should be\n"
	"properly recorded on it.\p"
	"In other words\.\p"
	"You've climbed the first step on\n"
	"the stairs to the Championship!\p"
	"That's got to feel awesome!"
}

script RustboroCity_Gym_EventScript_Josh {
	trainerbattle_single( TRAINER_JOSH, RustboroCity_Gym_Text_JoshIntro, RustboroCity_Gym_Text_JoshDefeat)
	msgbox(RustboroCity_Gym_Text_JoshPostBattle, MSGBOX_AUTOCLOSE)
	end
}

text(local) RustboroCity_Gym_Text_JoshIntro {
	"Don't take us Gym Trainers lightly!\n"
	"I'll show you why we're better!"
}

text(local) RustboroCity_Gym_Text_JoshDefeat {
	"You were too good for me\."
}

text(local) RustboroCity_Gym_Text_JoshPostBattle {
	"You haven't seen anything of the Rock\n"
	"type's terrifying power!"
}

script RustboroCity_Gym_EventScript_Tommy {
	trainerbattle_single(TRAINER_TOMMY, RustboroCity_Gym_Text_TommyIntro, RustboroCity_Gym_Text_TommyDefeat)
	msgbox(RustboroCity_Gym_Text_TommyPostBattle, MSGBOX_AUTOCLOSE)
	end
}

text(local) RustboroCity_Gym_Text_TommyIntro {
	"If you can't beat me, you won't stand\n"
	"a chance against Roxanne!"
}

text(local) RustboroCity_Gym_Text_TommyDefeat {
	"Wow! You've got some potential!"
}

text(local) RustboroCity_Gym_Text_TommyPostBattle {
	"Roxanne is stronger than me by\n"
	"several times.\p"
	"You'd better be on your guard!"
}

script RustboroCity_Gym_EventScript_Marc {
	trainerbattle_single(TRAINER_MARC, RustboroCity_Gym_Text_MarcIntro, RustboroCity_Gym_Text_MarcDefeat)
	msgbox(RustboroCity_Gym_Text_MarcPostBattle, MSGBOX_AUTOCLOSE)
	end
}

text(local) RustboroCity_Gym_Text_MarcIntro {
	"We might be in the middle of town,\n"
	"but so what?\p"
	"My Rock Pok\emon need room to\n"
	"rampage!"
}

text(local) RustboroCity_Gym_Text_MarcDefeat {
	"Oh, man oh man!\n"
	"Our challenger is one feisty customer!"
}

text(local) RustboroCity_Gym_Text_MarcPostBattle {
	"I have to hand it to our Leader.\p"
	"It took smarts and sense for her to\n"
	"pick the Rock type at her young age."
}

script RustboroCity_Gym_EventScript_Roxanne {
	if(var(VAR_STONE_BADGE_LEVEL) == 0) {
		trainerbattle_single(
			TRAINER_ROXANNE_NORMAL, 
			RustboroCity_Gym_Text_RoxanneIntro, 
			RustboroCity_Gym_Text_RoxanneDefeat, 
			RustboroCity_Gym_EventScript_RoxanneDefeated, 
			NO_MUSIC
		)
	} else {
		call(Roxanne_Extended_Levels)
	}
	release
	end
}

text(local) RustboroCity_Gym_Text_RoxanneIntro {
	"Roxanne: Hello, I am Roxanne, the\n"
	"Rustboro Pok\emon Gym Leader.\p"
	"I became a Gym Leader so that I might\n"
	"apply what I learned at the Pok\emon\l"
	"Trainer's School in battle.\p"
	"Would you kindly demonstrate how you\n"
	"battle, and with which Pok\emon?"
}

text(local) RustboroCity_Gym_Text_RoxanneDefeat {
	"Roxanne: So\.\n"
	"I lost\.\p"
	"It seems that I still have much more\n"
	"to learn\.\p"
	"I understand.\p"
	"The Pok\emon League's rules state\n"
	"that Trainers are to be given this\l"
	"if they defeat a Gym Leader.\p"
	"Please accept the official Pok\emon\n"
	"League Stone Badge."
}

script Roxanne_Extended_Levels {
	msgbox("What Gym Rank would you like to battle?")
	if(var(VAR_STONE_BADGE_LEVEL) >= 8 && flag(FLAG_DEFEATED_CHAMPION)) {
		dynmultipush("Master", 9)
	}
	if(var(VAR_STONE_BADGE_LEVEL) >= 7 && flag(FLAG_BADGE08_GET)) {
		dynmultipush("Hyper", 8)
	}
	if(var(VAR_STONE_BADGE_LEVEL) >= 6 && flag(FLAG_BADGE07_GET)) {
		dynmultipush("Ultra", 7)
	}
	if(var(VAR_STONE_BADGE_LEVEL) >= 5 && flag(FLAG_BADGE06_GET)) {
		dynmultipush("Platinum", 6)
	}
	if(var(VAR_STONE_BADGE_LEVEL) >= 4 && flag(FLAG_BADGE05_GET)) {
		dynmultipush("Diamond", 5)
	}
	if(var(VAR_STONE_BADGE_LEVEL) >= 3 && flag(FLAG_BADGE04_GET)) {
		dynmultipush("Gold", 4)
	}
	if(var(VAR_STONE_BADGE_LEVEL) >= 2 && flag(FLAG_BADGE03_GET)) {
		dynmultipush("Silver", 3)
	}
	if(var(VAR_STONE_BADGE_LEVEL) >= 1 && flag(FLAG_BADGE02_GET)) {
		dynmultipush("Bronze", 2)
	}
	dynmultipush("Normal", 1)
	dynmultipush("Cancel", MULTI_B_PRESSED)
	dynmultistack(0, 0, FALSE, 6, FALSE, 0, NULL)

	if(var(VAR_RESULT) == MULTI_B_PRESSED) {
		msgbox(Roxanne_Challenge_Exit, MSGBOX_NPC)
		return
	}

	switch(var(VAR_RESULT)) {
		case 9: 
			trainerbattle_single(
				TRAINER_ROXANNE_MASTER,
				RustboroCity_Gym_Text_RoxanneIntro, 
				RustboroCity_Gym_Text_RoxanneDefeat, 
				Roxanne_Master_Defeated, 
				NO_MUSIC
			)
		case 8: 
			trainerbattle_double(
				TRAINER_ROXANNE_ULTRA,
				RustboroCity_Gym_Text_RoxanneIntro, 
				RustboroCity_Gym_Text_RoxanneDefeat, 
				Roxanne_Ultra_Defeated, 
				NO_MUSIC
			)
		case 7: 
			trainerbattle_single(
				TRAINER_ROXANNE_HYPER,
				RustboroCity_Gym_Text_RoxanneIntro, 
				RustboroCity_Gym_Text_RoxanneDefeat, 
				Roxanne_Hyper_Defeated, 
				NO_MUSIC
			)
		case 6: 
			trainerbattle_single(
				TRAINER_ROXANNE_PLATINUM,
				RustboroCity_Gym_Text_RoxanneIntro, 
				RustboroCity_Gym_Text_RoxanneDefeat, 
				Roxanne_Platinum_Defeated, 
				NO_MUSIC
			)
		case 5: 
			trainerbattle_single(
				TRAINER_ROXANNE_DIAMOND,
				RustboroCity_Gym_Text_RoxanneIntro, 
				RustboroCity_Gym_Text_RoxanneDefeat, 
				Roxanne_Diamond_Defeated, 
				NO_MUSIC
			)
		case 4: 
			trainerbattle_single(
				TRAINER_ROXANNE_GOLD,
				RustboroCity_Gym_Text_RoxanneIntro, 
				RustboroCity_Gym_Text_RoxanneDefeat, 
				Roxanne_Gold_Defeated, 
				NO_MUSIC
			)
		case 3: 
			trainerbattle_single(
				TRAINER_ROXANNE_SILVER,
				RustboroCity_Gym_Text_RoxanneIntro, 
				RustboroCity_Gym_Text_RoxanneDefeat, 
				Roxanne_Silver_Defeated, 
				NO_MUSIC
			)
		case 2: 
			trainerbattle_single(
				TRAINER_ROXANNE_BRONZE,
				RustboroCity_Gym_Text_RoxanneIntro, 
				RustboroCity_Gym_Text_RoxanneDefeat, 
				Roxanne_Bronze_Defeated, 
				NO_MUSIC
			)
		case 1: 
			trainerbattle_single(
				TRAINER_ROXANNE_NORMAL,
				RustboroCity_Gym_Text_RoxanneIntro, 
				RustboroCity_Gym_Text_RoxanneDefeat, 
				Roxanne_Bronze_Defeated, 
				NO_MUSIC
			)
	}
}

text(local) Roxanne_Challenge_Exit {
	"Roxanne: Come back any time if you want\n"
	"a rematch."
}

script(local) Roxanne_Normal_Defeated {
	// Advance level if this the highest fight at the time.
	if(var(VAR_STONE_BADGE_LEVEL) == 0) {
		addvar(VAR_STONE_BADGE_LEVEL, 1)
	}
	msgbox(Roxanne_Challenge_Exit)
}

