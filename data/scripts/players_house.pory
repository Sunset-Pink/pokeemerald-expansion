script Script_PlayersHouse_1F_Interact_Mom {
	lock
	faceplayer
	msgbox(Text_PlayersHouse_1F_Mom_DontPushYourselfTooHard)
	if(flag(FLAG_HAS_MATCH_CALL)) {
		if(!flag(FLAG_ENABLE_MOM_MATCH_CALL)) {
			msgbox(Text_PlayersHouse_1F_Mom_PokeNav)
			closemessage
			delay(30)
			playfanfare(MUS_REGISTER_MATCH_CALL)
			msgbox(Text_PlayersHouse_1F_Mom_PokeNav_Registered)
			waitfanfare
			closemessage
			delay(30)
			setflag(FLAG_ENABLE_MOM_MATCH_CALL)
		}
	} elif(flag(FLAG_ENABLE_MOM_MATCH_CALL) && flag(FLAG_BADGE05_GET)) {
		msgbox(Text_PlayersHouse_1F_Mom_SomethingFromMom)
		giveitem(ITEM_AMULET_COIN)
		if(var(VAR_RESULT) == FALSE) {
			call(Common_EventScript_ShowBagIsFull)
		} else {
			setflag(FLAG_RECEIVED_AMULET_COIN)
		}
	} elif(var(VAR_QUEST_INTRO_STATE) == 4) { 
		msgbox(Text_PlayersHouse_1F_Mom_DidYouMeetBirch)
	}
	elif (flag(FLAG_ADVENTURE_STARTED)) {
		// Heal party
		msgbox(Text_PlayersHouse_1F_Mom_YouShouldRest)
		call(Common_EventScript_OutOfCenterPartyHeal)
		incrementgamestat(GAME_STAT_RESTED_AT_HOME)

	}
	call(Script_PlayersHouse_1F_Interact_Mom_Farewell)
	release
	end
}

text(local) Text_PlayersHouse_1F_Mom_DidYouMeetBirch {
	"Mom: Did you introduce yourself to\n"
	"Prof. Birch?"
}

text(local) Text_PlayersHouse_1F_Mom_YouShouldRest {
	"Mom: How are you doing, {PLAYER}?\n"
	"You look a little tired.\p"
	"I thin you should rest a bit."
}

text(local) Text_PlayersHouse_1F_Mom_SomethingFromMom {
	"Mom: Oh? Did Dad give you that Badge?\p"
	"Then here's something from your Mom!"
}

text(local) Text_PlayersHouse_1F_Mom_PokeNav {
	"Mom: What is that, honey? A Pok\eNav?\n"
	"Someone from Devon gave it to you?\p"
	"Well, honey, how about registering\n"
	"your mom?\p"
	"\. \. \."
}

text(local) Text_PlayersHouse_1F_Mom_PokeNav_Registered {
	"Registered Mom\n"
	"in the Pok\eNav."
}

script(local) Script_PlayersHouse_1F_Interact_Mom_Farewell {
	random(3)
	switch(var(VAR_RESULT)) {
		case 0: 
			msgbox(Text_PlayersHouse_1F_Mom_TakeCareHoney)
			break
		case 1:
			msgbox(Text_PlayersHouse_1F_Mom_SeeYouHoney)
			break	
		case 2:
			msgbox(Text_PlayersHouse_1F_Mom_DontPushYourselfTooHard)
			break
	}
}

text(local) Text_PlayersHouse_1F_Mom_TakeCareHoney {
	"Mom: Take care, honey!"
}

text(local) Text_PlayersHouse_1F_Mom_SeeYouHoney {
	"Mom: See you, honey!"
}

text Text_PlayersHouse_1F_Mom_DontPushYourselfTooHard {
	"Don't push yourself too hard, dear.\n"
	"You can always come home.\p"
	"Go for it, honey!"
}

script Script_PlayersHouse_1F_PetalburgGymReport {
	if(var(VAR_0x8004) == MALE) {
		applymovement(VAR_0x8005, Common_Movement_WalkInPlaceFasterRight)
	} else {
		applymovement(VAR_0x8005, Common_Movement_WalkInPlaceFasterLeft)
	}
	waitmovement(0)
	call(Script_PlayersHouse_1F_Mom_NoticesGymBroadcast)
	if(var(VAR_0x8004) == MALE) {
		applymovement(LOCALID_PLAYER, moves(
			walk_down * 2
			walk_left * 3
		))
	} else {
		applymovement(LOCALID_PLAYER, moves(
			walk_down * 2
			walk_right * 3
		))
	}
	waitmovement(0)
	playbgm(MUS_ENCOUNTER_INTERVIEWER, FALSE)
	msgbox(Text_PlayersHouse_1F_Mom_MaybeDadWillBeOn)
	closemessage
	if(var(VAR_0x8004) == MALE) {
		applymovement(VAR_0x8005, moves(
			walk_left
			walk_in_place_faster_right
		))
	} else {
		applymovement(VAR_0x8005, moves(
			walk_right
			walk_in_place_faster_left
		))
	}
	waitmovement(0)
	if(var(VAR_0x8004) == MALE) {
		applymovement(LOCALID_PLAYER, moves(
			walk_left
			face_up
		))
	} else {
		applymovement(LOCALID_PLAYER, moves(
			walk_right
			face_up
		))
	}
	call(Script_PlayersHouse_1F_TV_GymBroadcast)
	if(var(VAR_0x8004) == MALE) {
		applymovement(LOCALID_PLAYER, Common_Movement_WalkInPlaceFasterLeft)
	} else {
		applymovement(LOCALID_PLAYER, Common_Movement_WalkInPlaceFasterRight)
	}
	waitmovement(0)
	msgbox(Text_PlayersHouse_1F_Mom_ItsOver)
	msgbox(Text_PlayersHouse_1F_Mom_GoIntroduceProfBirch)
	closemessage
	setvar(VAR_TEMP_1, 1)
	if(var(VAR_0x8004) == MALE) {
		applymovement(VAR_0x8005, moves(
			walk_left
			walk_down
			walk_in_place_faster_right
		))
	} else {
		applymovement(VAR_0x8005, moves(
			walk_right
			walk_down
			walk_in_place_faster_left
		))
	}
	waitmovement(0)
	setvar(VAR_QUEST_INTRO_STATE, 5)
	releaseall
}

script Script_PlayersHouse_1F_Mom_NoticesGymBroadcast {
	playse(SE_PIN)
	applymovement(VAR_0x8005, Common_Movement_ExclamationMark)
	waitmovement(0)
	applymovement(VAR_0x8005, Common_Movement_Delay48)
	waitmovement(0)
	msgbox(Text_PlayersHouse_1F_Mom_OhComeQuickly)
	closemessage
	return
}

text(local) Text_PlayersHouse_1F_Mom_OhComeQuickly {
	"Mom: Oh! {PLAYER}, {PLAYER}!\n"
	"Quick! Come quickly!"
}

text(local) Text_PlayersHouse_1F_Mom_MaybeDadWillBeOn {
	"Mom: Look! It's Petalburg Gym!\n"
	"Maybe Dad will be on!"
}

text(local) Text_PlayersHouse_1F_Mom_ItsOver {
	"Mom: Oh\. It's over.\p"
	"I think Dad was on, but we missed him.\n"
	"Too bad."
}

script(local) Script_PlayersHouse_1F_TV_GymBroadcast {
	applymovement(LOCALID_PLAYER, Common_Movement_WalkInPlaceFasterUp)
	waitmovement(0)
	msgbox(Text_PlayersHouse_1F_Interviewer_PetalburgGym)
	fadedefaultbgm
	special(TurnOffTVScreen)
	setflag(FLAG_SYS_TV_HOME)
	delay(35)
	return
}

text(local) Text_PlayersHouse_1F_Interviewer_PetalburgGym {
	"Interviewer: \.We brought you this\n"
	"report from in front of Petalburg Gym.$"
}

text(local) Text_PlayersHouse_1F_Mom_GoIntroduceProfBirch {
	"Oh, yes.\n"
	"One of your Dad's and I's friends\l"
	"lives and works in Littleroot Town.\p"
	"Prof. Birch is his name.\n"
	"He and his family lives next door.\p" 
	"You should vist him in his lab\n"
	"for the next part of your gift!"
}

script Script_PlayersHouse_1F_Intro_EnterHouse {
	msgbox(Text_PlayersHouse_1F_Mom_ItsNiceInHere)
	applymovement(VAR_0x8004, Common_Movement_FacePlayer)
	waitmovement
	if(var(VAR_0x8005) == MALE) {
		applymovement(LOCALID_PLAYER, Common_Movement_WalkInPlaceFasterRight)
	} else {
		applymovement(LOCALID_PLAYER, Common_Movement_WalkInPlaceFasterLeft)
	}
	msgbox(Text_PlayersHouse_1F_Mom_MoversAndGift)
	closemessage
	applymovement(LOCALID_PLAYER, moves(walk_up))
	applymovement(VAR_0x8004, Common_Movement_WalkInPlaceFasterUp)
	waitmovement(0)
	setvar(VAR_QUEST_INTRO_STATE, 2)
	releaseall
	end
}

text(local) Text_PlayersHouse_1F_Mom_ItsNiceInHere {
	"Mom: See, {PLAYER}?\n"
	"Isn't it nice in here, too?"
}

text(local) Text_PlayersHouse_1F_Mom_MoversAndGift {
	"The mover's Pok\emon do all the work\n"
	"of moving us in and cleaning up after.\l"
	"This is so convenient!\p"
	"{PLAYER}, your room is upstairs.\n"
	"Go check it out, dear!\p"
	"Your Dad bought you a new clock\n"
	"to mark our move here, just like\l"
	"every young trainer wants\.\l"
	"Don't worry, I got a gift you will\l"
	"actually like!"
}

script(local) Script_PlayersHouse_1F_SetMovingBoxes {
	setmetatile(5, 4, METATILE_BrendansMaysHouse_MovingBox_Open, TRUE)
	setmetatile(5, 2, METATILE_BrendansMaysHouse_MovingBox_Closed, TRUE)
	return
}

text Text_PlayersHouse_1F_GoOpenGift {
	"Mom: {PLAYER}.\p"
	"Go open my gift up in your room, honey."
}

text Text_PlayersHouse_1F_Mom_ArentYouInterestedInRoom {
	"Mom: Well, {PLAYER}?\p"
	"Aren't you interested in seeing your\n"
	"very own room?"
}

