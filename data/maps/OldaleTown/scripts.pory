mapscripts OldaleTown_MapScripts {
	MAP_SCRIPT_ON_TRANSITION: OldaleTown_OnTransition
}

script(local) OldaleTown_OnTransition {
	call(Common_EventScript_SetupRivalGfxId)
	setflag(FLAG_VISITED_OLDALE_TOWN)
	if(flag(FLAG_ADVENTURE_STARTED) == FALSE) {
		call(OldaleTown_EventScript_BlockWestEntrance)
	}
	if(flag(FLAG_RECEIVED_POTION_OLDALE) == FALSE) {
		call(OldaleTown_EventScript_MoveMartEmployee)
	}
	if(flag(FLAG_ADVENTURE_STARTED) == TRUE) {
		call(OldaleTown_EventScript_SetOldaleState)
	}
	end
}

// This script seems pointless because nothing uses VAR_OLDALE_TOWN_STATE
script OldaleTown_EventScript_SetOldaleState {
	setvar(VAR_OLDALE_TOWN_STATE, 1)
}

script OldaleTown_EventScript_BlockWestEntrance {
	setobjectxyperm(LOCALID_FOOTPRINTS_MAN, 1, 11)
	setobjectmovementtype(LOCALID_FOOTPRINTS_MAN, MOVEMENT_TYPE_FACE_LEFT)
	return
}

script OldaleTown_EventScript_MoveMartEmployee {
	setobjectxyperm(LOCALID_OLDALE_MART_EMPLOYEE, 13, 14)
	setobjectmovementtype(LOCALID_OLDALE_MART_EMPLOYEE, MOVEMENT_TYPE_FACE_DOWN)
	return
}

script OldaleTown_EventScript_TownSign {
	msgbox(OldaleTown_Text_TownSign, MSGBOX_SIGN)
	end
}

script OldaleTown_EventScript_Girl {
	msgbox(OldaleTown_Text_SavingMyProgress, MSGBOX_NPC)
	end
}

script OldaleTown_EventScript_MartEmployee {
	lock
	faceplayer
	if(flag(FLAG_RECEIVED_POTION_OLDALE) || flag(FLAG_TEMP_1)) {
		msgbox(OldaleTown_Text_PotionExplanation)
		releaseall
		end
	}
	setflag(FLAG_TEMP_1)
	playbgm(MUS_FOLLOW_ME, FALSE)
	msgbox(OldaleTown_Text_IWorkAtPokemonMart)
	closemessage
	switch(var(VAR_FACING)) {
		case DIR_SOUTH: call(OldaleTown_EventScript_GoToMartSouth)
		case DIR_NORTH: call(OldaleTown_EventScript_GoToMartNorth)
		case DIR_EAST:  call(OldaleTown_EventScript_GoToMartEast )
	}
	call(OldaleTown_EventScript_ExplainPokemonMart)
	fadedefaultbgm
	release
	end
}

script OldaleTown_EventScript_GoToMartSouth {
	applymovement(LOCALID_OLDALE_MART_EMPLOYEE, moves(
		walk_left
		walk_up * 2
		walk_right
		walk_up * 5
		walk_in_place_faster_down
	))
	applymovement(LOCALID_PLAYER, moves(
		delay_16 * 4
		walk_up * 5
	))
	waitmovement(0)
	return
}

script OldaleTown_EventScript_GoToMartNorth {
	applymovement(LOCALID_OLDALE_MART_EMPLOYEE, moves(
		walk_up * 7
		walk_in_place_faster_down
	))
	applymovement(LOCALID_PLAYER, moves(
		walk_up * 7
	))
	waitmovement(0)
	return
}

script OldaleTown_EventScript_GoToMartEast {
	applymovement(LOCALID_PLAYER, moves(
		walk_right
		walk_up * 6
	))
	applymovement(LOCALID_OLDALE_MART_EMPLOYEE, moves(
		walk_up * 7
		walk_in_place_faster_down
	))
	waitmovement(0)
	return
}

script OldaleTown_EventScript_ExplainPokemonMart {
	msgbox(OldaleTown_Text_ThisIsAPokemonMart)
	giveitem(ITEM_POTION)
	if(var(VAR_RESULT) == FALSE) {
		msgbox(gText_TooBadBagIsFull)
		return
	} 
	msgbox(OldaleTown_Text_PotionExplanation)
	setflag(FLAG_RECEIVED_POTION_OLDALE)
	return
}

script OldaleTown_EventScript_FootprintsMan {
	lock
	faceplayer
	if(flag(FLAG_ADVENTURE_STARTED) == TRUE) {
		msgbox(OldaleTown_Text_FinishedSketchingFootprints)
	} else {
		msgbox(OldaleTown_Text_DiscoveredFootprints)
		closemessage
		applymovement(LOCALID_FOOTPRINTS_MAN, Common_Movement_FaceOriginalDirection)
	}
	release
	end
}

script OldaleTown_EventScript_BlockedPath {
	lockall
	call(Movement_OldaleTown_PlayerStepBack)
	call(Movement_OldaleTown_FootprintMan_BackUp)
	waitmovement(0)
	msgbox(OldaleTown_Text_WaitDontComeInHere)
	closemessage
	call(Movement_OldaleTown_FootprintMan_ReturnToOrignalPosition)
	waitmovement(0)
	releaseall
}

script(local) Movement_OldaleTown_PlayerStepBack {
	applymovement(LOCALID_PLAYER, moves(
		delay_8
		walk_right
	))
}

script(local) Movement_OldaleTown_FootprintMan_BackUp {
	applymovement(LOCALID_FOOTPRINTS_MAN, moves(
		walk_fast_up
		walk_in_place_faster_left
		lock_facing_direction
		walk_right
		unlock_facing_direction
	))
}

script(local) Movement_OldaleTown_FootprintMan_ReturnToOrignalPosition {
	applymovement(LOCALID_FOOTPRINTS_MAN, moves(
		walk_down
		walk_left
	))
}

script OldaleTown_EventScript_Rival {
	lockall
	applymovement(LOCALID_OLDALE_RIVAL, Common_Movement_FacePlayer)
	waitmovement(0)
	call(OldaleTown_RivalLetsGoBack)
	call(OldaleTown_EventScript_RivalFinish)
	releaseall
}

script OldaleTown_RivalLetsGoBack {
	if(checkplayergender == MALE) {
		msgbox(OldaleTown_Text_MayLetsGoBack)
	} else {
		msgbox(OldaleTown_Text_BrendanLetsGoBack)
	}
	closemessage
	return
}

script OldaleTown_EventScript_RivalFinish {
	closemessage
	call(OldaleTown_EventScript_DoExitMovement)
	removeobject(LOCALID_OLDALE_RIVAL)
	//Advance to Rival in Lab
	setvar(VAR_RIVAL_STATE, 4)
	setflag(FLAG_HIDE_OLDALE_TOWN_RIVAL)
	return
}

script OldaleTown_EventScript_DoExitMovement {
	// Make player look south if not already looking south.
	if(var(VAR_FACING) != DIR_SOUTH) {
		applymovement(LOCALID_PLAYER, moves(
			delay_8
			delay_4
			walk_in_place_faster_down
		))
	}
	applymovement(LOCALID_OLDALE_RIVAL, moves( walk_down * 7))
	waitmovement(0)
	return
}


script OldaleTown_EventScript_RivalTrigger1 {
	lockall
	applymovement(LOCALID_OLDALE_RIVAL, moves( walk_left * 2))
	waitmovement(0)
	applymovement(LOCALID_PLAYER, Common_Movement_WalkInPlaceFasterRight)
	waitmovement(0)
	call(OldaleTown_RivalLetsGoBack)
	call(OldaleTown_EventScript_DoExitMovement)
	call(OldaleTown_EventScript_RivalFinish)
	releaseall
	end
}

script OldaleTown_EventScript_RivalTrigger2 {
	lockall
	applymovement(LOCALID_OLDALE_RIVAL, moves( walk_left ))
	waitmovement(0)
	applymovement(LOCALID_PLAYER, Common_Movement_WalkInPlaceFasterRight)
	waitmovement(0)
	call(OldaleTown_RivalLetsGoBack)
	call(OldaleTown_EventScript_DoExitMovement)
	call(OldaleTown_EventScript_RivalFinish)
	releaseall
	end
}

script OldaleTown_EventScript_RivalTrigger3 {
	lockall
	applymovement(LOCALID_OLDALE_RIVAL, moves( face_left ))
	waitmovement(0)
	applymovement(LOCALID_PLAYER, Common_Movement_WalkInPlaceFasterRight)
	waitmovement(0)
	call(OldaleTown_RivalLetsGoBack)
	call(OldaleTown_EventScript_DoExitMovement)
	call(OldaleTown_EventScript_RivalFinish)
	releaseall
	end
}

text(local) OldaleTown_Text_TownSign {
	"Oldale Town\n"
	"\qoWhere things start off scarce.\qc"
}

text(local) OldaleTown_Text_BrendanLetsGoBack {
	"Brendan: I'm heading back to my dad's\n"
	"Lab now.\l"
	"{PLAYER}, you should hustle back, too."
}

text(local) OldaleTown_Text_MayLetsGoBack {
	"May: {PLAYER}{KUN}!\n"
	"Over here!\l"
	"Let's hurry home!"
}

text(local) OldaleTown_Text_FinishedSketchingFootprints {
	"I finished sketching the footprints of\n"
	"a rare Pok\emon.\p"
	"But it turns out they were only my\n"
	"own footprints\."
}

text(local) OldaleTown_Text_DiscoveredFootprints {
	"I just discovered the footprints of\n"
	"a rare Pok\emon!\p"
	"Wait until I finish sketching\n"
	"them, okay?"
}

text(local) OldaleTown_Text_WaitDontComeInHere {
	"Aaaaah! Wait!\n"
	"Please don't come in here.\p"
	"I just discovered the footprints of\n"
	"a rare Pok\emon!\p"
	"Wait until I finish sketching\n"
	"them, okay?"
}

text(local) OldaleTown_Text_PotionExplanation {
	"A Potion can be used anytime, so it's\n"
	"even more useful than a Pok\emon Center\l"
	"in certain situations."
}

text(local) OldaleTown_Text_ThisIsAPokemonMart {
	"This is a Pok\emon Mart.\n"
	"Just look for our blue roof.\p"
	"We sell a variety of goods including\n"
	"Pok\e Balls for catching Pok\emon.\p"
	"Here, I'd like you to have this as\n"
	"a promotional item."
}

text(local) OldaleTown_Text_IWorkAtPokemonMart {
	"Hi!\n"
	"I work at a Pok\emon Mart.\p"
	"Can I get you to come with me?"
}

text(local) OldaleTown_Text_SavingMyProgress {
	"I want to take a rest, so I'm saving my\n"
	"progress."
}