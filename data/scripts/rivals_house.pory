script RivalsHouse_2F_EventScript_MeetRivalWest {
    if(checkplayergender == MALE) {
        applymovement(LOCALID_RIVALS_HOUSE_2F_RIVAL, moves(
            walk_right * 5
            walk_in_place_faster_down
        ))
    } else {
        applymovement(LOCALID_RIVALS_HOUSE_2F_RIVAL, moves(
            walk_left * 2
            walk_down
            walk_in_place_faster_left
        ))
    }
    waitmovement(0)
    if(checkplayergender == MALE) {
        applymovement(LOCALID_PLAYER, Common_Movement_WalkInPlaceFasterUp)
    } else {
        applymovement(LOCALID_PLAYER, Common_Movement_WalkInPlaceFasterRight)
    }
    waitmovement(0)
    if(checkplayergender == MALE) {
        msgbox(Text_RivalsHouse_2F_May_WhoAreYou)
    } else {
        msgbox(Text_RivalsHouse_2F_Brendan_WhoAreYou)
    }
    closemessage
    if(checkplayergender == MALE) {
        applymovement(LOCALID_PLAYER, moves(
            delay_16 * 2
            walk_in_place_faster_right
        ))
        applymovement(LOCALID_RIVALS_HOUSE_2F_RIVAL, moves(
            walk_up
            walk_right * 2
            walk_in_place_faster_up
        ))
    } else {
        applymovement(LOCALID_PLAYER, moves(
            delay_8
            delay_16
            walk_in_place_faster_up
            delay_16 * 2
            walk_in_place_faster_left
        ))
        applymovement(LOCALID_RIVALS_HOUSE_2F_RIVAL, moves(
            walk_up * 2
            walk_left * 5
            walk_in_place_faster_up
        ))
    }
    waitmovement(0)
    return
}

