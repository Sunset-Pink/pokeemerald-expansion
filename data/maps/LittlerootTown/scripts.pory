raw`
LittlerootTown_EventScript_SetRivalLeftForRoute103::
	setflag FLAG_RIVAL_LEFT_FOR_ROUTE103
	return

LittlerootTown_EventScript_MoveRivalFromOldale::
	setvar VAR_OLDALE_RIVAL_STATE, 2
	setflag FLAG_HIDE_OLDALE_TOWN_RIVAL
	return

LittlerootTown_EventScript_SetExitedHouseAfterLatiSSTicketEvent::
	setvar VAR_RIVAL_HOUSE_STATE, 5
	return

LittlerootTown_EventScript_SetTwinPos::
	goto_if_eq VAR_LITTLEROOT_TOWN_STATE, 0, LittlerootTown_EventScript_SetTwinGuardingRoutePos
	setobjectxyperm LOCALID_LITTLEROOT_TWIN, 10, 1
	setobjectmovementtype LOCALID_LITTLEROOT_TWIN, MOVEMENT_TYPE_FACE_UP
	return

LittlerootTown_EventScript_SetTwinGuardingRoutePos::
	setobjectxyperm LOCALID_LITTLEROOT_TWIN, 7, 2
	setobjectmovementtype LOCALID_LITTLEROOT_TWIN, MOVEMENT_TYPE_FACE_DOWN
	return

LittlerootTown_EventScript_GoodLuck::
	msgbox LittlerootTown_Text_GoodLuckCatchingPokemon, MSGBOX_DEFAULT
	release
	end

LittlerootTown_EventScript_NeedPokemonTriggerLeft::
	lockall
	applymovement LOCALID_LITTLEROOT_TWIN, LittlerootTown_Movement_TwinApproachPlayerLeft
	waitmovement 0
	call LittlerootTown_EventScript_DangerousWithoutPokemon
	applymovement LOCALID_LITTLEROOT_TWIN, LittlerootTown_Movement_TwinReturnLeft
	waitmovement 0
	releaseall
	end

LittlerootTown_EventScript_DangerousWithoutPokemon::
	msgbox Text_LittlerootTown_Twin_PokemonWillJumpOut, MSGBOX_DEFAULT
	closemessage
	applymovement LOCALID_LITTLEROOT_TWIN, LittlerootTown_Movement_TwinPushPlayerFromRoute
	applymovement LOCALID_PLAYER, LittlerootTown_Movement_PushPlayerBackFromRoute
	waitmovement 0
	msgbox LittlerootTown_Text_DangerousIfYouDontHavePokemon, MSGBOX_DEFAULT
	closemessage
	return

LittlerootTown_Movement_TwinApproachPlayerLeft:
	face_right
	delay_8
	disable_jump_landing_ground_effect
	jump_in_place_right
	delay_8
	walk_fast_right
	walk_fast_right
	walk_fast_right
	walk_fast_right
	walk_fast_up
	walk_fast_up
	walk_fast_left
	face_down
	step_end

LittlerootTown_Movement_TwinPushPlayerFromRoute:
	walk_down
	step_end

LittlerootTown_Movement_TwinReturnLeft:
	walk_right
	walk_down
	walk_down
	walk_left
	walk_left
	walk_left
	walk_left
	walk_up
	walk_in_place_faster_down
	step_end

LittlerootTown_Movement_PushPlayerBackFromRoute:
	lock_facing_direction
	walk_down
	unlock_facing_direction
	step_end

LittlerootTown_EventScript_NeedPokemonTriggerRight::
	lockall
	applymovement LOCALID_LITTLEROOT_TWIN, LittlerootTown_Movement_TwinApproachPlayerRight
	waitmovement 0
	call LittlerootTown_EventScript_DangerousWithoutPokemon
	applymovement LOCALID_LITTLEROOT_TWIN, LittlerootTown_Movement_TwinReturnRight
	waitmovement 0
	releaseall
	end

LittlerootTown_Movement_TwinApproachPlayerRight:
	face_right
	delay_8
	disable_jump_landing_ground_effect
	jump_in_place_right
	delay_8
	walk_fast_right
	walk_fast_right
	walk_fast_right
	walk_fast_up
	walk_fast_up
	walk_fast_right
	face_down
	step_end

LittlerootTown_Movement_TwinReturnRight:
	walk_left
	walk_down
	walk_left
	walk_left
	walk_left
	walk_in_place_faster_down
	step_end

	
LittlerootTown_Text_DangerousIfYouDontHavePokemon:
	.string "It's dangerous if you don't have\n"
	.string "your own POKéMON.$"


LittlerootTown_Text_GoodLuckCatchingPokemon:
	.string "Are you going to catch POKéMON?\n"
	.string "Good luck!$"
`

mapscripts LittlerootTown_MapScripts {
	MAP_SCRIPT_ON_TRANSITION: Script_LittlerootTown_OnTransition
	MAP_SCRIPT_ON_FRAME_TABLE [
		VAR_QUEST_INTRO_STATE, 1: Script_LittlerootTown_Intro_StepOffTruck
	]
	//MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE []
}

//LittlerootTown_OnTransition:
//	call_if_eq VAR_RIVAL_HOUSE_STATE, 4, LittlerootTown_EventScript_SetExitedHouseAfterLatiSSTicketEvent
//  call_if_eq VAR_OLDALE_RIVAL_STATE, 1, LittlerootTown_EventScript_MoveRivalFromOldale
//	call_if_eq VAR_LITTLEROOT_RIVAL_STATE, 3, LittlerootTown_EventScript_SetRivalLeftForRoute103
//	end


script(local) Script_LittlerootTown_OnTransition {
	setflag(FLAG_VISITED_LITTLEROOT_TOWN)
	call(Common_EventScript_SetupRivalGfxId)
	if(checkplayergender == FEMALE) {
		setobjectxyperm(LOCALID_LITTLEROOT_MOM, 14, 8)
	}
	end
}

script Script_LittlerootTown_Intro_StepOffTruck {
	lockall
	if(checkplayergender == MALE) {
		setvar(VAR_0x8004, 5)
		setvar(VAR_0x8005, 8)
	} else {
		setvar(VAR_0x8004, 14)
		setvar(VAR_0x8005, 8)
	}
	call(Script_LittlerootTown_Intro_GoInsideWithMom)
	if(checkplayergender == MALE) {
		setflag(FLAG_HIDE_LITTLEROOT_TOWN_BRENDANS_HOUSE_TRUCK)
		warpsilent(MAP_LITTLEROOT_TOWN_BRENDANS_HOUSE_1F, 8 ,8)
	} else {
		setflag(FLAG_HIDE_LITTLEROOT_TOWN_MAYS_HOUSE_TRUCK)
		warpsilent(MAP_LITTLEROOT_TOWN_MAYS_HOUSE_1F, 2, 8)
	}
	waitstate
	releaseall
	end
}

script Script_LittlerootTown_Intro_OpenDoor {
	opendoor(VAR_0x8004, VAR_0x8005)
	waitdooranim
	return
}

script Script_LittlerootTown_Intro_CloseDoor {
	closedoor(VAR_0x8004, VAR_0x8005)
	waitdooranim
	return
}

script Script_LittlerootTown_Intro_GoInsideWithMom {
	delay(15)
	playse(SE_LEDGE)
	applymovement(LOCALID_PLAYER, moves(
		jump_right
		delay_16 *3
	))
	waitmovement(0)
	call(Script_LittlerootTown_Intro_OpenDoor)
	addobject(LOCALID_LITTLEROOT_MOM)
	applymovement(LOCALID_LITTLEROOT_MOM, moves(
		walk_down
	))
	waitmovement(0)
	call(Script_LittlerootTown_Intro_CloseDoor)
	delay(10)
	applymovement(LOCALID_LITTLEROOT_MOM, moves(
		walk_down
		walk_in_place_faster_left
	))
	waitmovement(0)
	msgbox(Text_LittlerootTown_Mom_OurNewHome)
	closemessage
	applymovement(LOCALID_LITTLEROOT_MOM, moves(
		delay_16
		delay_8
		walk_up
	))
	applymovement(LOCALID_PLAYER, moves(
		delay_16
		delay_8
		walk_right
		walk_in_place_faster_up
	))
	waitmovement(0)
	call(Script_LittlerootTown_Intro_OpenDoor)
	applymovement(LOCALID_LITTLEROOT_MOM, moves(
		walk_up
		set_invisible
	))
	applymovement(LOCALID_PLAYER, moves(
		walk_up *2
	))
	waitmovement
	setflag(FLAG_HIDE_LITTLEROOT_TOWN_MOM_OUTSIDE)
	setvar(VAR_QUEST_INTRO_STATE, 1)
	hideplayer
	call(Script_LittlerootTown_Intro_CloseDoor)
	clearflag(FLAG_HIDE_LITTLEROOT_TOWN_FAT_MAN)
	clearflag(FLAG_HIDE_MAP_NAME_POPUP)
	return
}

script Script_LittlerootTown_Interact_FatMan {
	msgbox(Text_LittlerootTown_FatMan_UsePCToStoreItems, MSGBOX_NPC)
	end
}

text(local) Text_LittlerootTown_FatMan_UsePCToStoreItems {
	"If you use a PC, you can store items\n"
	"and Pokemon.\p"
	"The power of science is staggering!"
}

script Script_LittlerootTown_Interact_Boy {
	msgbox(Text_LittlerootTown_Boy_ProfBitch, MSGBOX_NPC)
	end
}

text(local) Text_LittlerootTown_Boy_ProfBitch {
	"Prof. Birch tries to spend time\n"
	"in the wild. But he is absolutely\l"
	"useless in the field.\p"
	"One time he got absolutely swarmed\n"
	"by some Zigzagoons. Talk about useless,\l"
	"might as well call him, Prof. Bitch."
}
text(local) Text_LittlerootTown_Mom_OurNewHome {
	"Mom: {PLAYER}, we're here, honey!\p"
	"It must be tiring riding with our things\n"
	"in the moving truck.\p"
	"Well, this is Littleroot Town.\p"
	"How do you like it?\n"
	"This is our new home!\p"
	"It has a quaint feel, but it seems to be\n"
	"an easy place to live, don't you think?\p"
	"And, you get your own room, {PLAYER}!\n"
	"Let's go inside.$"
}

script Script_LittlerootTown_Interact_TownSign {
	msgbox(Text_LittlerootTown_TownSign, MSGBOX_SIGN)
	end
}

text Text_LittlerootTown_TownSign {
	"Littleroot Town\n"
	"\qoA town that can't be shaded any hue.\qc"
}

script Script_LittlerootTown_Interact_LabSign {
	msgbox(Text_LittlerootTown_LabSign, MSGBOX_SIGN)
	end
}

text Text_LittlerootTown_LabSign {
	"Prof. Birch's Pok\emon Lab."
}

script Script_LittlerootTown_Interact_BrendansHouseSign {
	if(checkplayergender == MALE) {
		msgbox(Text_LittlerootTown_PlayersSign, MSGBOX_SIGN)
	} else {
		msgbox(Text_LittlerootTown_BirchsSign, MSGBOX_SIGN)
	}
}

script Script_LittlerootTown_Interact_MaysHouseSign {
	if(checkplayergender == FEMALE) {
		msgbox(Text_LittlerootTown_PlayersSign, MSGBOX_SIGN)
	} else {
		msgbox(Text_LittlerootTown_BirchsSign, MSGBOX_SIGN)
	}
}

text Text_LittlerootTown_PlayersSign {
	"{PLAYER}'s House."
}

text Text_LittlerootTown_BirchsSign {
	"Prof. Birch's House."
}

script Script_LittlerootTown_Interact_Twin {
	lock
	faceplayer
	if(flag(FLAG_ADVENTURE_STARTED)) {
		goto(LittlerootTown_EventScript_GoodLuck)
	} else {
		msgbox(Text_LittlerootTown_Twin_PokemonWillJumpOut)
	}
	releaseall
	end
}
text(local) Text_LittlerootTown_Twin_PokemonWillJumpOut {
	"Um, um, um!\p"
	"If you go outside and go in the grass,\n"
	"wild Pok\emon will jump out!"
}
