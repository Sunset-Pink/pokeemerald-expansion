mapscripts SlateportCity_Mart_MapScripts {}
raw`

SlateportCity_Mart_EventScript_Clerk::
	lock
	faceplayer
	message gText_HowMayIServeYou
	waitmessage
	pokemart SlateportCity_Mart_Pokemart
	msgbox gText_PleaseComeAgain, MSGBOX_DEFAULT
	release
	end


SlateportCity_Mart_EventScript_BlackBelt::
	msgbox SlateportCity_Mart_Text_SomeItemsOnlyAtMart, MSGBOX_NPC
	end

SlateportCity_Mart_EventScript_Man::
	msgbox SlateportCity_Mart_Text_GreatBallIsBetter, MSGBOX_NPC
	end
`

mart SlateportCity_Mart_Pokemart {
	ITEM_POKE_BALL
	ITEM_GREAT_BALL
	ITEM_POTION
	ITEM_SUPER_POTION
	ITEM_ANTIDOTE
	ITEM_PARALYZE_HEAL
	ITEM_ESCAPE_ROPE
	ITEM_REPEL
	ITEM_HARBOR_MAIL
}

text(local) SlateportCity_Mart_Text_SomeItemsOnlyAtMart {
	"The Market does have some interesting\n"
	"merchandise.\p"
	"But there are some items you can only\n"
	"get at a Pok\emon Mart."
}

text(local) SlateportCity_Mart_Text_GreatBallIsBetter {
	"A Great Ball is better than a Pok\e Ball\n"
	"at catching Pok\emon.\p"
	"With this, I should be able to get that\n"
	"elusive Pok\emon\."
}