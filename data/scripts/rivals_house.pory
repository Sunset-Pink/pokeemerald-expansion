
text(local) Text_RivalsHouse_1F_RivalsMom_OhYoureTheNewNeighbor {
    "Oh, hello. And you are?\p"
    "\. \. \. \. \. \. \. \. \.\n"
    "\. \. \. \. \. \. \. \. \.\p"
    "Oh, you're {PLAYER}{KUN}, our new next-door\n"
    "neighbor! Hi!\p"
    "We have a {STR_VAR_1} about the same\n"
    "age as you.\p"
    "Our {STR_VAR_1} was excited about making\n"
    "Our {STR_VAR_1} was excited about making\n"
    "a new friend.\p"
    "Our {STR_VAR_1} is upstairs, I think.$"
}

script Script_RivalsHouse_1F_Interact_RivalMom {
    lock
    faceplayer
    if(flag(FLAG_DEFEATED_RIVAL_ROUTE103)) {
        msgbox(Text_RivalsHouse_1F_RivalsMom_ShouldGoHome)
    } elif(flag(FLAG_SYS_POKEMON_GET)) {
        msgbox(Text_RivalsHouse_1F_RivalsMom_WentOutToRoute103)
    } elif(var(VAR_RIVAL_STATE) == 1) {
        msgbox(Text_RivalsHouse_1F_RivalsMom_TooBusyToNoticeVisit)
    } else {
        special(GetRivalSonDaughterString)
        msgbox(Text_RivalsHouse_1F_RivalsMom_LikeChildLikeFather)
    }
    release
    end
}

text(local) Text_RivalsHouse_1F_RivalsMom_LikeChildLikeFather {
    "Like child, like father.\p"
    "My husband is as wild about Pok\emon\n"
    "as our child.\p"
    "If he's not at his Lab, he's likely\n"
    "scrabbling about in grassy places.$"
}

text(local) Text_RivalsHouse_1F_RivalsMom_TooBusyToNoticeVisit {
    "That {RIVAL}!\p"
    "I guess our child is too busy with\n"
    "Pok\emon to notice that you came\l"
    "to visit, {PLAYER}{KUN}."
}

text(local) Text_RivalsHouse_1F_RivalsMom_WentOutToRoute103 {
    "Oh, {RIVAL} went out to Route 103\n"
    "just a little while ago.\p"
    "Like farther, like child.\n"
    "{RIVAL} can't stay quietly at home."
}

text(local) Text_RivalsHouse_1F_RivalsMom_ShouldGoHome {
    "I think it's wonderful for people to \n"
    "travel with Pok\emon.\p"
    "But you should go home every so often\n"
    "to let your mother know you're okay.\p"
    "She might not say it, but I'm sure she\n"
    "worries about you, {PLAYER}{KUN}."
}

script Script_RivalsHouse_1F_Interact_RivalSibling {
    lockall
    faceplayer
    special(GetPlayerBigGuyGirlString)
    msgbox(Text_RivalsHouse_1F_RivalSibling_DoYouHavePokemon)
    release
    end
}

text(local) Text_RivalsHouse_1F_RivalSibling_DoYouHavePokemon {
    "Hi, neighbor!\p"
    "Do you already have your\n"
    "own Pok\emon?"
}

script Script_RivalsHouse_2F_Interact_GameCube {
    msgbox(Text_RivalsHouse_2F_GameCube, MSGBOX_SIGN)
    return
}

text(local) Text_RivalsHouse_2F_GameCube {
	"It's a Nintendo GameCube.\p"
	"A Game Boy Advance is connected to\n"
	"serve as the Controller."
}

script Script_RivalsHouse_2F_Interact_Notebook {
    msgbox(Text_RivalsHouse_2F_Notebook, MSGBOX_SIGN)
    return
}

text(local) Text_RivalsHouse_2F_Notebook {
    "{PLAYER} flipped open the notebook.\p"
    "Adventure Rule No. 1\n"
    "Open the Menu with Start.\p"
    "Adventure Rule No. 2\n"
    "Record your progress with Save.\p"
    "The remaining pages are blank\."
}

text(local) Text_RivalsHouse_2F_Rival_GettingRead {
    "Pok\emon fully restored\.\n"
    "Items all packed, and\."
}
	

script RivalsHouse_2F_EventScript_Rival {
    lockall
    if(flag(FLAG_MET_RIVAL_LILYCOVE) == TRUE) {
        goto(RivalsHouse_2F_EventScript_RivalPostLilycove)
    }
    msgbox(Text_RivalsHouse_2F_Rival_GettingRead)
    releaseall
    end
}

script RivalsHouse_2F_EventScript_RivalPostLilycove {
	applymovement(VAR_LAST_TALKED, Common_Movement_FacePlayer)
	waitmovement(0)
    if(checkplayergender == MALE) {
        if(flag(FLAG_MET_RIVAL_IN_HOUSE_AFTER_LILYCOVE) == TRUE) {
            msgbox(RivalsHouse_2F_Text_MayWhereShouldIGoNext)
        } else {
            msgbox(RivalsHouse_2F_Text_MayJustCheckingMyPokedex)
        }
    } else {
        if(flag(FLAG_MET_RIVAL_IN_HOUSE_AFTER_LILYCOVE) == TRUE) {
            msgbox(RivalsHouse_2F_Text_BrendanWhereShouldIGoNext)
        } else {
            msgbox(RivalsHouse_2F_Text_BrendanJustCheckingMyPokedex)
        }
    }
    setflag(FLAG_MET_RIVAL_IN_HOUSE_AFTER_LILYCOVE)
    releaseall
    end
}

text(local) RivalsHouse_2F_Text_MayJustCheckingMyPokedex {
	"May: {PLAYER}{KUN}!\p"
	"I was just checking my Pok\eDex.\p"
	"There's still a lot of Pok\emon that\n"
	"I've seen but haven't caught.\p"
	"And there are many others that\n"
	"I think will evolve.\p"
	"I wonder where I should go catch\n"
	"some Pok\emon next?"
}

text(local) RivalsHouse_2F_Text_MayWhereShouldIGoNext {
	"May: I wonder where I should go catch\n"
	"some Pok\emon next?\p"
	"Wouldn't it be funny if we ran into each\n"
	"other, {PLAYER}{KUN}?"
}

text(local) RivalsHouse_2F_Text_BrendanJustCheckingMyPokedex {
	"Brendan: Hey, it's {PLAYER}.\p"
	"I was just checking out my Pok\eDex.\p"
	"There are still many Pok\emon that\n"
	"I need to catch, I know, but this\l"
	"is looking pretty good.\p"
	"Checking this Pok\eDex out gives me\n"
	"the urge to hit the road again."
}

text(local) RivalsHouse_2F_Text_BrendanWhereShouldIGoNext {
	"Brendan: I'm having a hard time deciding\n"
	"where I should catch Pok\emon next.\p"
	"Hey, {PLAYER}, if I see you while I'm out\n"
	"catching Pok\emon, I can pitch you a\l"
	"battle if you'd like."
}



script LittlerootTown_RivalsHouse_2F_EventScript_TurnOffPlayerPC {
    if(checkplayergender == MALE ) {
        setvar(VAR_0x8004, PC_LOCATION_MAYS_HOUSE)
    } else {
        setvar(VAR_0x8004, PC_LOCATION_BRENDANS_HOUSE)
    }
    playse(SE_PC_OFF)
    special(DoPCTurnOffEffect)
    releaseall
    end
}

script RivalsHouse_2F_EventScript_RivalsPokeBall {
    lockall
    if(var(VAR_RIVAL_STATE) == 0) {
        call(RivalsHouse_2F_EventScript_MeetRival)
    } else {
        msgbox(RivalsHouse_2F_Text_ItsRivalsPokeBall)
    }
    releaseall
    end
}

text(local) RivalsHouse_2F_Text_ItsRivalsPokeBall {
	"It's {RIVAL}'s Pok\e Ball!\p"
	"Better leave it right where it is."
}


script RivalsHouse_2F_EventScript_MeetRival {
    delay(10)
	addobject(LOCALID_RIVALS_HOUSE_2F_RIVAL)
    if(checkplayergender == MALE) {
        applymovement(LOCALID_RIVALS_HOUSE_2F_RIVAL, moves(
            walk_down * 2
            walk_in_place_faster_right
        ))
    } else {
        applymovement(LOCALID_RIVALS_HOUSE_2F_RIVAL, moves(
            walk_down * 2
            walk_in_place_faster_left
        ))
    }
	waitmovement(0)
	playse(SE_PIN)
    applymovement(LOCALID_RIVALS_HOUSE_2F_RIVAL, Common_Movement_ExclamationMark)
    waitmovement(0)
    applymovement(LOCALID_RIVALS_HOUSE_2F_RIVAL, Common_Movement_Delay48)
    waitmovement(0)
    delay(10)
    if(checkplayergender) {
        playbgm(MUS_ENCOUNTER_MAY, TRUE)
    } else {
        playbgm(MUS_ENCOUNTER_BRENDAN, TRUE)
    }
    switch(var(VAR_FACING)) {
        case DIR_NORTH: call(RivalsHouse_2F_EventScript_MeetRivalNorth)
        case DIR_SOUTH: call(RivalsHouse_2F_EventScript_MeetRivalSouth)
        case DIR_WEST: call(RivalsHouse_2F_EventScript_MeetRivalWest)
        case DIR_EAST: call(RivalsHouse_2F_EventScript_MeetRivalEast)
    }
    setvar(VAR_RIVAL_STATE, 1)
    if(checkplayergender == MALE) {
        setflag(FLAG_HIDE_LITTLEROOT_TOWN_MAYS_HOUSE_2F_POKE_BALL)
        clearflag(FLAG_HIDE_LITTLEROOT_TOWN_MAYS_HOUSE_RIVAL_BEDROOM)
    } else {
        setflag(FLAG_HIDE_LITTLEROOT_TOWN_BRENDANS_HOUSE_2F_POKE_BALL)
        clearflag(FLAG_HIDE_LITTLEROOT_TOWN_BRENDANS_HOUSE_RIVAL_BEDROOM)
    }
    savebgm(MUS_DUMMY)
    fadedefaultbgm
    releaseall
    end
}


script RivalsHouse_2F_EventScript_MeetRivalNorth {
    if(checkplayergender == MALE) {
        applymovement(LOCALID_RIVALS_HOUSE_2F_RIVAL, moves(
            Walk_right * 2
            walk_down * 2
            walk_right
        ))
    } else {
        applymovement(LOCALID_RIVALS_HOUSE_2F_RIVAL, moves(
            walk_left * 2
            walk_down * 2
            walk_left
        ))
    }
    waitmovement(0)
    if(checkplayergender == MALE) {
        applymovement(LOCALID_PLAYER, Common_Movement_WalkInPlaceFasterLeft)
    } else {
        applymovement(LOCALID_PLAYER, Common_Movement_WalkInPlaceFasterRight)
    }
    waitmovement(0)
    if(checkplayergender == MALE) {
        msgbox(Text_RivalsHouse_2F_May_WhoAreYou)
    } else {
        msgbox(Text_RivalsHouse_2F_Brendan_WhoAreYou)
    }
    closemessage
    if(checkplayergender == MALE) {
        applymovement(LOCALID_PLAYER, moves(
            delay_16
            walk_in_place_faster_up
            delay_16 * 4
            walk_in_place_faster_left
        ))
        applymovement(LOCALID_RIVALS_HOUSE_2F_RIVAL, moves(
            walk_up * 3
            walk_in_place_faster_right
            walk_right * 4
            walk_in_place_faster_up
        ))
    } else {
        applymovement(LOCALID_PLAYER, moves(
            delay_16
            walk_in_place_faster_up
            delay_16 * 4
            walk_in_place_faster_right
        ))
        applymovement(LOCALID_RIVALS_HOUSE_2F_RIVAL, moves(
            walk_up * 3
            walk_in_place_faster_left
            walk_left * 4
            walk_in_place_faster_up
        ))
    }
    waitmovement(0)
    return
}

