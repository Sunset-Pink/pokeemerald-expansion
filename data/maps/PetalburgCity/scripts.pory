text(local) PetalburgCity_Text_WhereIsWally {
	"Where has our Wally gone?\p"
	"We have to leave for Verdanturf Town\n"
	"very soon\."
}

text(local) PetalburgCity_Text_AreYouRookieTrainer {
	"Hiya! Are you maybe\.\n"
	"A rookie Trainer?\p"
	"Do you know what Pok\emon Trainers\n"
	"do when they reach a new town?\p"
	"They first check what kind of Gym\n"
	"is in the town."
}

text(local) PetalburgCity_Text_ThisIsPetalburgGym {
	"See? This is Petalburg City's Gym."
}

text(local) PetalburgCity_Text_ThisIsGymSign {
	"This is the Gym's sign. Look for it\n"
	"whenever you're looking for a Gym."
}

text(local) PetalburgCity_Text_WaterReflection {
	"My face is reflected in the water.\p"
	"It's a shining grin full of hope\.\p"
	"Or it could be a look of somber silence\n"
	"struggling with fear\.\p"
	"What do you see reflected in your face?"
}

text(local) PetalburgCity_Text_FullPartyExplanation {
	"Let's say you have six Pok\emon.\n"
	"If you catch another one\.\p"
	"It is automatically sent to a Storage\n"
	"Box over a PC connection."
}

text(local) PetalburgCity_Text_GymSign {
	"Petalburg City Pok\emon Gym\n"
	"Leader: Norman\l"
	"\qoA man in pursuit of power!\qc"
}

text(local) PetalburgCity_Text_CitySign {
	"Petalburg City\n"
	"\qoWhere people mingle with nature.\qc"
}

text(local) PetalburgCity_Text_WallyHouseSign {
	"Wally's House"
}

text(local) PetalburgCity_Text_AreYouATrainer {
	"Excuse me!\p"
	"Let me guess, from the way you're\n"
	"dressed, are you a Pok\emon Trainer?"
}

text(local) PetalburgCity_Text_WellMaybeNot {
	"\. \. \. \. \. \.\p"
	"Well, maybe not.\n"
	"Your clothes aren't all that dirty.\p"
	"You're either a rookie Trainers,\n"
	"or maybe you're just an ordinary kid."
}

text(local) PetalburgCity_Text_ImLookingForTalentedTrainers {
	"I'm roaming the land in search of\n"
	"talented Trainers.\p"
	"I'm sorry to have taken your time."
}