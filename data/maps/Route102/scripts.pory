text(local) Route102_Text_WatchMeCatchPokemon {
	"Wally: {PLAYER}\.\n"
	"Pok\emon hide in tall grass like this,\l"
	"don't they?\p"
	"Please watch me and see if I can\n"
	"catch one properly.\p"
	"\.Whoa!"
}

text(local) Route102_Text_WallyIDidIt {
	"Wally: I did it\. It's my\.\n"
	"My Pok\emon!"
}

text(local) Route102_Text_LetsGoBack {
	"{PLAYER}, thank you!\n"
	"Let's go back to the Gym!"
}

text(local) Route102_Text_ImNotVeryTall {
	"I'm\.not very tall, so I sink right\n"
	"into tall grass.\p"
	"The grass goes up my nose and\.\n"
	"Fwafwafwafwafwa\.\p"
	"Fwatchoo!"
}

text(local) Route102_Text_CatchWholeBunchOfPokemon {
	"I'm going to catch a whole bunch of\n"
	"Pok\emon!"
}

text(local) Route102_Text_RouteSignOldale {
	"Route 102\n"
	"{RIGHT_ARROW} Oldale Town"
}

text(local) Route102_Text_RouteSignPetalburg {
	"Route 102\n"
	"{LEFT_ARROW} Petalburg City"
}
