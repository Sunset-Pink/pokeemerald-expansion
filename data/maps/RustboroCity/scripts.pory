script RustboroCity_EventScript_StolenGoodsScene {
    setobjectxyperm(LOCALID_RUSTBORO_DEVON_EMPLOYEE, 14, 21)
	setobjectmovementtype(LOCALID_RUSTBORO_DEVON_EMPLOYEE, MOVEMENT_TYPE_FACE_RIGHT)
	msgbox(RustboroCity_Text_OutOfTheWay)
	closemessage
	playbgm(MUS_ENCOUNTER_AQUA, FALSE)
	addobject(LOCALID_RUSTBORO_GRUNT)
	addobject(LOCALID_RUSTBORO_DEVON_EMPLOYEE)
	applymovement(LOCALID_RUSTBORO_GRUNT, moves(
        walk_faster_right * 2
        walk_fast_right * 5
        walk_fast_up * 9
    ))
	waitmovement(0)
	removeobject(LOCALID_RUSTBORO_GRUNT)
	applymovement(LOCALID_RUSTBORO_DEVON_EMPLOYEE, moves(
        walk_right * 6
	    walk_in_place_faster_up
    ))
	waitmovement(0)
	msgbox(RustboroCity_Text_WaitDontTakeMyGoods)
	closemessage
	applymovement(LOCALID_RUSTBORO_DEVON_EMPLOYEE, moves(
        walk_up * 7
    ))
	waitmovement(0)
	fadedefaultbgm
	removeobject(LOCALID_RUSTBORO_DEVON_EMPLOYEE)
	setobjectxyperm(LOCALID_RUSTBORO_DEVON_EMPLOYEE, 30, 10)
	clearflag (FLAG_HIDE_RUSTBORO_CITY_DEVON_EMPLOYEE_1)
	setflag(FLAG_DEVON_GOODS_STOLEN)
	setvar(VAR_RUSTBORO_CITY_STATE, 2)
	setvar(VAR_RUSTURF_TUNNEL_STATE, 2)
	setvar(VAR_ROUTE116_STATE, 1)
	clearflag(FLAG_HIDE_ROUTE_116_MR_BRINEY)
	clearflag(FLAG_HIDE_RUSTURF_TUNNEL_PEEKO)
	clearflag(FLAG_HIDE_RUSTURF_TUNNEL_AQUA_GRUNT)
	setflag(FLAG_HIDE_BRINEYS_HOUSE_MR_BRINEY)
	setflag(FLAG_HIDE_BRINEYS_HOUSE_PEEKO)
	releaseall
	return
}

script RustboroCity_EventScript_DevonEmployee1 {
	lock
	faceplayer
    if(flag(FLAG_RECOVERED_DEVON_GOODS)) {
        waitse
        setvar(VAR_TEMP_1, 4)
        goto(RustboroCity_EventScript_ReturnGoods)
    } else {
        msgbox(RustboroCity_Text_ShadyCharacterTookOffTowardsTunnel)
    }
	release
	end
}

