script Script_LittlerootTown_ProfessorBirchsLab_Interact_Aide_InformGen {
	switch(var(VAR_STARTER_SELECTION)) {
		case 0: 
			msgbox(Text_Aide_Gen1)
		case 1: 
			msgbox(Text_Aide_Gen2)
		case 2: 
			msgbox(Text_Aide_Gen3)
		case 3: 
			msgbox(Text_Aide_Gen4)
		case 4: 
			msgbox(Text_Aide_Gen5)
		case 5: 
			msgbox(Text_Aide_Gen6)
		case 6: 
			msgbox(Text_Aide_Gen7)
		case 7: 
			msgbox(Text_Aide_Gen8)
		case 8: 
			msgbox(Text_Aide_Gen9)
		default:
			msgbox("WTF did you do to see this message!?")
	}
}

