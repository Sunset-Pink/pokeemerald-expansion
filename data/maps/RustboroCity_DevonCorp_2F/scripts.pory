script RustboroCity_DevonCorp_2F_EventScript_MatchCallScientist {
	lock
	faceplayer
	call(RustboroCity_DevonCorp_2F_EventScript_TryAdvanceFossileReady)
	if(var(VAR_RUSTBORO_CITY_STATE) == 6) {
		msgbox(RustboroCity_DevonCorp_2F_Text_WhatToWorkOnNext)
	} else {
		msgbox(RustboroCity_DevonCorp_2F_Text_DevelopNewPokenavFeature)
	}
	release
	end
}

text(local) RustboroCity_DevonCorp_2F_Text_DeviceForTalkingToPokemon {
	"We're developing a device for talking\n"
	"with Pok\emon.\p"
	"But we haven't had much success\."
}

text(local) RustboroCity_DevonCorp_2F_Text_DevelopingNewBalls {
	"I'm developing new kinds of\n"
	"Pok\e Balls\.\p"
	"But I haven't made much headway\."
}

text(local) RustboroCity_DevonCorp_2F_Text_WeFinallyMadeNewBalls {
	"We finally made new kinds of\n"
	"Pok\e Balls!\p"
	"The Repeat Ball makes it easier to\n"
	"catch Pok\emon you've caught before.\p"
	"The Timer Ball gets better at catching\n"
	"Pok\emon the longer a battle runs.\p"
	"Both are proudly developed by\n"
	"the Devon Corporation.\p"
	"Please give them a try!"
}

text(local) RustboroCity_DevonCorp_2F_Text_IMadePokenav {
	"I made the Pok\eNav!\p"
	"As an engineer, I feel blessed to have\n"
	"made something so great!"
}

text(local) RustboroCity_DevonCorp_2F_Text_WowThatsAPokenav {
	"Oh, wow!\n"
	"That's a Pok\eNav!\p"
	"It came about as a result of our\n"
	"President's desire to learn about\l"
	"the feelings of Pok\emon.\p"
	"Would you like me to describe its\n"
	"features in detail?\p"
	"No, no. I think you'll find out just by\n"
	"trying the Pok\eNav out."
}

text(local) RustboroCity_DevonCorp_2F_Text_DeviceToVisualizePokemonDreams {
	"I'm trying to develop a device that\n"
	"visually reproduces the dreams of\l"
	"Pok\emon\.\p"
	"But it's not going well."
}

text(local) RustboroCity_DevonCorp_2F_Text_DevelopDeviceToResurrectFossils {
	"I've been trying to develop a device\n"
	"that resurrects Pok\emon from fossils\.\p"
	"And, it's working!"
}

text(local) RustboroCity_DevonCorp_2F_Text_WantToBringFossilBackToLife {
	"Wait! That thing you have there\.\n"
	"Is that a Pok\emon fossil?\p"
	"Would you like to bring that Pok\emon\n"
	"back to life?\p"
	"I can with my newly developed\n"
	"Fossil Regenerator."
}

text(local) RustboroCity_DevonCorp_2F_Text_OhIsThatSo {
	"Oh, is that so?\p"
	"Devon's technological expertise\n"
	"is outstanding, I tell you."
}

text(local) RustboroCity_DevonCorp_2F_Text_TwoFossilsPickOne {
	"Oh, now that's a surprise!\n"
	"You have not one, but two, fossils?\p"
	"Unfortunately, my machine can only\n"
	"regenerate one Pok\emon at a time.\p"
	"Would you like to pick one of your\n"
	"fossils for regeneration?"
}

text(local) RustboroCity_DevonCorp_2F_Text_WhichFossil {
	"Which fossil would you like to \n"
	"regenerate?"
}

text(local) RustboroCity_DevonCorp_2F_Text_HandedFossilToResearcher {
	"Excellent!\n"
	"Let's do this right away.\p"
	"{PLAYER} handed the {STR_VAR_1} to\n"
	"the Devon Researcher."
}

text(local) RustboroCity_DevonCorp_2F_Text_FossilRegeneratorTakesTime {
	"The Fossil Regenerator, which I made,\n"
	"is incredible.\p"
	"But it has one drawback--it takes\n"
	"a long time to work.\p"
	"So, uh\. How about you go for a stroll\n"
	"and look around for a while?"
}

text(local) RustboroCity_DevonCorp_2F_Text_FossilizedMonBroughtBackToLife {
	"Thanks for waiting!\p"
	"Your fossilized Pok\emon has been\n"
	"brought back to life!\p"
	"The fossil was an ancient Pok\emon.\n"
	"{STR_VAR_2}, it was!"
}

text(local) RustboroCity_DevonCorp_2F_Text_ReceivedMonFromResearcher {
	"{PLAYER} received {STR_VAR_2} from\n"
	"the Devon Researcher."
}

text(local) RustboroCity_DevonCorp_2F_Text_DevelopNewPokenavFeature {
	"I'm trying to develop a new feature\n"
	"for the Pok\eNav\.\p"
	"But it's not going well."
}

text(local) RustboroCity_DevonCorp_2F_Text_WhatToWorkOnNext {
	"Well, now what shall I work on\n"
	"developing next?\p"
	"Our company allows us to make our\n"
	"inspirations into reality.\p"
	"One couldn't ask for a better\n"
	"environment as an engineer."
}

