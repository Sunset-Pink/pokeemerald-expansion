mapscripts RustboroCity_Flat2_1F_MapScripts {}

script RustboroCity_Flat2_1F_EventScript_OldWoman {
	msgbox(RustboroCity_Flat2_1F_Text_DevonWorkersLiveHere, MSGBOX_NPC)
	end
}

script RustboroCity_Flat2_1F_EventScript_Skitty {
	lock
	faceplayer
	waitse
	playmoncry(SPECIES_SKITTY, CRY_MODE_NORMAL)
	msgbox(RustboroCity_Flat2_1F_Text_Skitty)
	waitmoncry
	release
	end
}

text(local) RustboroCity_Flat2_1F_Text_DevonWorkersLiveHere {
	"Devon Corporation's workers live in\n"
	"this building."
}

text(local) RustboroCity_Flat2_1F_Text_Skitty {
	"Skitty: Gyaaaah!"
}

