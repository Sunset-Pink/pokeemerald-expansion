	"Prof. Birch: Hello there!\n"
	"I'm Prof. Birch, and you must\l"
	"be {PLAYER}. I have heard alot\l"
	"about you from your Mom.\p"
	"You just missed my son, {RIVAL},\n"
	"he stopped by and grabbed one of my\l"
	"starters before rushing out of here.\p"
	"I told him to be on the lookout for a\n"
    "trainer named {PLAYER}, who just moved\l"
    "into the house next door!\p"
    "I hope the two of you can be friends\n"
    "who can start a new Pokémon journey\l"
    "together.\p"
	"I agreed to give you a Pok\emon, as\n"
	"part of a welcome gift, your Mom\l"
	"put together. How about this, if\l"
	"you can beat {RIVAL}, I will gift\l"
	"you a Pok\edex as well.\p" 
    "I'll tell you which Starter he chose\n"
    "after you pick yours, it wouldn't be\l"
    "fair if you knew before you picked!\p"
	"I can let you choose from any\n"
	"Generation of Starter Pok\emon, just\l"
	"ask me if you want to change them.\l"
	"Also my aide might be able to tell\l"
	"you more about each starter choice."
}

script Script_ProfBirch_Interact_Starter_ChangeSelection {
	if(flag(FLAG_MONOTYPE_STARTERS)) {
		msgbox(Text_LittlerootTown_ProfessorBirchsLab_Birch_Starter_ChangeMonotype)
		waitmessage
		call(Script_ProfBirch_Interact_Starter_TypeBased)
	} else {
		msgbox(Text_LittlerootTown_ProfessorBirchsLab_Birch_Starter_ChangeGeneration)
		waitmessage
		call(Script_ProfBirch_Interact_Starter_GenBased)
	}
}

script Script_ProfBirch_Interact_Starter_GenBased {
	dynmultipush("Gen 1", 0)
	dynmultipush("Gen 2", 1)
	dynmultipush("Gen 3", 2)
	dynmultipush("Gen 4", 3)
	dynmultipush("Gen 5", 4)
	dynmultipush("Gen 6", 5)
	dynmultipush("Gen 7", 6)
	dynmultipush("Gen 8", 7)
	dynmultipush("Gen 9", 8)
	dynmultipush("Cancel", MULTI_B_PRESSED)
	dynmultistack(0, 0, FALSE, 6, FALSE, 0, NULL)

	if(var(VAR_RESULT) != MULTI_B_PRESSED) {
		copyvar(VAR_TEMP_0, VAR_RESULT)
	}
	call(Script_ProfBirch_Interact_Starter_SayShowing_Gen)
	return
}

script Script_ProfBirch_Interact_Starter_TypeBased {
	msgbox(Text_ProfBirch_Starter_AnyType)
	dynmultipush("Fighting", 0)
	dynmultipush("Flying", 1)
	dynmultipush("Poison", 2)
	dynmultipush("Ground", 3)
	dynmultipush("Rock", 4)
	dynmultipush("Bug", 5)
	dynmultipush("Ghost", 6)
	dynmultipush("Steel", 7)
	dynmultipush("Electric", 8)
	dynmultipush("Psychic", 9)
	dynmultipush("Ice", 10)
	dynmultipush("Dragon", 11)
	dynmultipush("Dark", 12)
	dynmultipush("Normal", 13)
	dynmultipush("Fairy", 14)
	dynmultipush("Cancel", MULTI_B_PRESSED)
	dynmultistack(0, 0, FALSE, 6, FALSE, 0, NULL)

	if(var(VAR_RESULT) != MULTI_B_PRESSED) {
		copyvar(VAR_TEMP_0, VAR_RESULT)
	}
	call(Script_ProfBirch_Interact_Starter_SayShowing_Mono)
	return
}

text(local) Text_ProfBirch_Starter_AnyType {
	"I can let you choose from any\n"
	"Type of Starter Pok\emon, just\l"
	"ask me if you want to change them.\l"
	"Also my aide might be able to tell\l"
	"you more about each starter choice."
}

script Script_ProfBirch_Interact_Starter_SayShowing_Gen {
	switch(var(VAR_TEMP_0)) {
		case 0:
			msgbox(Text_ProfBirch_Starters_Gen_1)
		case 1:
			msgbox(Text_ProfBirch_Starters_Gen_2)
		case 2:
			msgbox(Text_ProfBirch_Starters_Gen_3)
		case 3:
			msgbox(Text_ProfBirch_Starters_Gen_4)
		case 4:
			msgbox(Text_ProfBirch_Starters_Gen_5)
		case 5:
			msgbox(Text_ProfBirch_Starters_Gen_6)
		case 6:
			msgbox(Text_ProfBirch_Starters_Gen_7)
		case 7:
			msgbox(Text_ProfBirch_Starters_Gen_8)
		case 8:
			msgbox(Text_ProfBirch_Starters_Gen_9)
		default:
			msgbox("Now showing starters.")
	}
	return
}

