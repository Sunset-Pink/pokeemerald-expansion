text(local) Route104_Text_TrainerTipsDoubleBattles {
	"Trainer Tips\p"
	"In the Hoenn region there are pairs\n"
	"of Trainers who challenge others\l"
	"for 2-on-2 Pok\emon battles called\l"
	"Double Battles.\p"
	"In a Double Battle, the Trainer must\n"
	"send out two Pok\emon, the one at the\l"
	"left of the list and the top one.\l"
	"Watch how Pok\emon are lined up."
}

text(local) Route104_Text_MayWeShouldRegister {
	"May: Oh, hi, {PLAYER}{KUN}!\p"
	"Devon upgraded your Pok\eNav with\n"
	"the Match Call system, huh?\p"
	"We should register each other so we\n"
	"can get in contact anytime."
}

text(local) Route104_Text_RegisteredMay {
	"{PLAYER} registered May\n"
	"in the Pok\eNav."
}

text(local) Route104_Text_MayHowsYourPokedex {
	"May: Oh, by the way, {PLAYER}{KUN},\n"
	"how's your Pok\edex coming along?"
}

text(local) Route104_Text_MayMinesDecentLetsBattle {
	"Mine's looking pretty decent.\n"
	"So\.\l"
	"How about a little battle?"
}

text(local) Route104_Text_MayHaventRaisedPokemon {
	"May: Oh, what's the matter?\p"
	"Haven't you caught or raised your\n"
	"Pok\emon very much?\p"
	"That's not very good for a Trainer!"
}

text(local) Route104_Text_MayLetsBattle {
	"May: So, what do you think?\n"
	"How about a little battle here?"
}

text(local) Route104_Text_MayIntro {
	"May: You just became a Trainer,\n"
	"{PLAYER}{KUN}. I'm not going to lose!"
}

text(local) Route104_Text_MayDefeat {
	"Yikes!\n"
	"You're better than I expected!"
}

text(local) Route104_Text_MayPostBattle {
	"May: I can tell you've gotten pretty\n"
	"good with the way you handle Pok\emon.\p"
	"But instead of only making them\n"
	"battle, you should be like Mr. Briney.\p"
	"It's important to become friends with\n"
	"Pok\emon, too."
}

text(local) Route104_Text_BrendanWeShouldRegister {
	"Brendan: Oh, hey, {PLAYER}!\p"
	"Cool, you had Devon install the Match\n"
	"Call system on your Pok\eNav!\p"
	"Let's register each other in our\n"
	"Pok\eNavs so we can keep in touch."
}

text(local) Route104_Text_RegisteredBrendan {
	"{PLAYER} registered Brendan\n"
	"in the Pok\eNav."
}

text(local) Route104_Text_BrendanHowsYourPokedex {
	"Brendan: {PLAYER}, how's your Pok\edex?\n"
	"Have you filled in any pages yet?"
}

text(local) Route104_Text_BrendanDoingGreatLetsBattle {
	"Me, I'm doing great!\p"
	"Want to check out how good I am with\n"
	"a battle?"
}

text(local) Route104_Text_BrendanNoConfidence {
	"Brendan: What's the matter? Don't have\n"
	"any confidence in your Pok\emon?"
}

text(local) Route104_Text_BrendanLetsBattle {
	"Brendan: What's up?\n"
	"Want to have a battle with me?"
}

text(local) Route104_Text_BrendanIntro {
	"Brendan: I know you just became\n"
	"a Trainer, but I won't go easy!"
}

text(local) Route104_Text_BrendanDefeat {
	"Hmm\.\n"
	"You're pretty good."
}

text(local) Route104_Text_BrendanPostBattle {
	"Brendan: You've gotten pretty decent\n"
	"at handling Pok\emon.\p"
	"But, you know, you shouldn't just be\n"
	"making Pok\emon battle.\p"
	"Like Mr. Briney, it's important to\n"
	"become friends with your Pok\emon."
}
