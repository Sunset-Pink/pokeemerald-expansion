}
raw`.endif`

raw`.if OW_BERRY_PESTS == TRUE`
script BerryTree_EventScript_CheckForPests {
	specialvar(VAR_RESULT, ObjectEventInteractionBerryHasPests)
	if(var(VAR_RESULT)) {
		call(BerryTree_EventScript_EncounterPests)
	}
	return
}

script BerryTree_EventScript_EncounterPests {
	message(BerryTree_Text_APokemonAppeared)
	waitmessage
	waitbuttonpress
	dowildbattle
	return
}

text(local) BerryTree_Text_APokemonAppeared {
