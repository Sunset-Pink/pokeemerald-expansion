script Common_EventScript_SetGymTrainers {
	switch(var(VAR_0x8008)) {
        case 1: call(RustboroCity_Gym_SetGymTrainers)
        case 2: call(DewfordTown_Gym_SetGymTrainers)
        case 3: call(MauvilleCity_Gym_SetGymTrainers)
        case 4: call(LavaridgeTown_Gym_SetGymTrainers)
        case 5: call(PetalburgCity_Gym_SetGymTrainers)
        case 6: call(FortreeCity_Gym_SetGymTrainers)
        case 7: call(MossdeepCity_Gym_SetGymTrainers)
        case 8: call(SootopolisCity_Gym_SetGymTrainers)
    }
	end
}
	
script Common_EventScript_SetGymTrainers_Frlg {
	switch(var(VAR_0x8008)) {
        case 1: call(EventScript_SetPewterGymTrainers)
        case 2: call(EventScript_SetCeruleanGymTrainers)
        case 3: call(EventScript_SetVermilionGymTrainers)
        case 4: call(EventScript_SetCeladonGymTrainers)
        case 5: call(EventScript_SetFuchsiaGymTrainers)
        case 6: call(EventScript_SetSaffronGymTrainers)
        case 7: call(EventScript_SetCinnabarGymTrainers)
        case 8: call(EventScript_SetViridianGymTrainers)
    }
	end
}

script RustboroCity_Gym_SetGymTrainers {
	settrainerflag (TRAINER_JOSH)
	settrainerflag (TRAINER_TOMMY)
	settrainerflag (TRAINER_MARC)
	return
}

