mapscripts Route104_PrettyPetalFlowerShop_MapScripts {
	MAP_SCRIPT_ON_TRANSITION: Route104_PrettyPetalFlowerShop_OnTransition
}

script(local) Route104_PrettyPetalFlowerShop_OnTransition {
	setflag(FLAG_LANDMARK_FLOWER_SHOP)
	if(!flag(FLAG_MET_PRETTY_PETAL_SHOP_OWNER) || !flag(FLAG_BADGE03_GET)) {
		setobjectxyperm(LOCALID_FLOWER_SHOP_OWNER, 4, 6)
	} else {
		setflag(FLAG_TEMP_1)
	}
	return
}

script Route104_PrettyPetalFlowerShop_EventScript_ShopOwner {
	lock
	faceplayer
	if(flag(FLAG_TEMP_1)) {
		message(gText_PlayerWhatCanIDoForYou)
		waitmessage
		pokemartdecoration2(Route104_PrettyPetalFlowerShop_Pokemart_Plants)
		msgbox(gText_PleaseComeAgain)
	} else {
		msgbox(Route104_PrettyPetalFlowerShop_Text_ThisIsPrettyPetalFlowerShop)
		if(!flag(FLAG_MET_PRETTY_PETAL_SHOP_OWNER)) {
			setflag(FLAG_MET_PRETTY_PETAL_SHOP_OWNER)
			msgbox(Route104_PrettyPetalFlowerShop_Text_IntroLearnAboutBerries, MSGBOX_YESNO)
		} else {
			msgbox(Route104_PrettyPetalFlowerShop_Text_LearnAboutBerries, MSGBOX_YESNO)
		}	
		if(var(VAR_RESULT) == YES) {
			msgbox(Route104_PrettyPetalFlowerShop_Text_BerriesExplanation)
		} else {
			msgbox(Route104_PrettyPetalFlowerShop_Text_FlowersBringHappiness)
		}
	}
	release
	return
}

mart(local) Route104_PrettyPetalFlowerShop_Pokemart_Plants {
	DECOR_RED_PLANT
	DECOR_TROPICAL_PLANT
	DECOR_PRETTY_FLOWERS
	DECOR_COLORFUL_PLANT
	DECOR_BIG_PLANT
	DECOR_GORGEOUS_PLANT
}


script Route104_PrettyPetalFlowerShop_EventScript_WailmerPailGirl {
	lock
	faceplayer
	if(!flag(FLAG_RECEIVED_WAILMER_PAIL)) {
		msgbox(Route104_PrettyPetalFlowerShop_Text_YouCanHaveThis)
		giveitem(ITEM_WAILMER_PAIL)
		if(var(VAR_RESULT) == FALSE) {
			goto(Common_EventScript_ShowBagIsFull)
		}
		setflag(FLAG_RECEIVED_WAILMER_PAIL)
	}
	msgbox(Route104_PrettyPetalFlowerShop_Text_WailmerPailExplanation)
	release
	end
}

script Route104_PrettyPetalFlowerShop_EventScript_RandomBerryGirl {
	lock
	faceplayer
	dotimebasedevents
	if(flag(FLAG_DAILY_FLOWER_SHOP_RECEIVED_BERRY)) {
		msgbox(Route104_PrettyPetalFlowerShop_Text_MachineMixesBerries)
	} else {
		msgbox(Route104_PrettyPetalFlowerShop_Text_ImGrowingFlowers)
		giverandomberry(BERRY_ID_CHERI, BERRY_ID_PERSIM)
		if(var(VAR_RESULT) == 0) {
			goto(Common_EventScript_ShowBagIsFull)
		}
		setflag(FLAG_DAILY_FLOWER_SHOP_RECEIVED_BERRY)
		msgbox(Route104_PrettyPetalFlowerShop_Text_MachineMixesBerries)
	}
	release
	return
}