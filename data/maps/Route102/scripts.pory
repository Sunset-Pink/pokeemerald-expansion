mapscripts Route102_MapScripts {}

script Route102_EventScript_LittleBoy {
	msgbox(Route102_Text_ImNotVeryTall, MSGBOX_NPC)
	end
}

script Route102_EventScript_RouteSignOldale {
	msgbox(Route102_Text_RouteSignOldale, MSGBOX_SIGN)
	end
}

script Route102_EventScript_RouteSignPetalburg {
	msgbox(Route102_Text_RouteSignPetalburg, MSGBOX_SIGN)
	end
}

script Route102_EventScript_Boy {
	msgbox(Route102_Text_CatchWholeBunchOfPokemon, MSGBOX_NPC)
	end
}

script Route102_EventScript_Calvin {
	trainerbattle_single(TRAINER_CALVIN_1, Route102_Text_CalvinIntro, Route102_Text_CalvinDefeated, Route102_EventScript_CalvinRegisterMatchCallAfterBattle)
	specialvar(VAR_RESULT, ShouldTryRematchBattle)
    if(var(VAR_RESULT) == TRUE) {
        goto(Route102_EventScript_CalvinRematch)
    }
	setvar(VAR_0x8004, TRAINER_CALVIN_1)
	specialvar(VAR_RESULT, IsTrainerRegistered)
    if(var(VAR_RESULT) == FALSE) {
        goto(Route102_EventScript_CalvinTryRegister)
    }
	msgbox(Route102_Text_CalvinPostBattle)
	release
	end
}

script Route102_EventScript_CalvinRegisterMatchCallAfterBattle {
	special(PlayerFaceTrainerAfterBattle)
	waitmovement(0)
    if(flag(FLAG_HAS_MATCH_CALL)) {
        goto(Route102_EventScript_CalvinRegisterMatchCall)
    }
	release
	end
}

script Route102_EventScript_CalvinRegisterMatchCall {
	msgbox(Route102_Text_CalvinRegisterShort)
	register_matchcall(TRAINER_CALVIN_1)
	release
	end
}

script Route102_EventScript_CalvinTryRegister {
    if(flag(FLAG_HAS_MATCH_CALL) == TRUE) {
        goto(Route102_EventScript_CalvinRegister)
    }
	msgbox(Route102_Text_CalvinPostBattle)
	release
	end
}

script Route102_EventScript_CalvinRegister {
	msgbox(Route102_Text_CalvinRegister)
	register_matchcall(TRAINER_CALVIN_1)
	release
	end
}

script Route102_EventScript_CalvinRematch {
	trainerbattle_rematch(TRAINER_CALVIN_1, Route102_Text_CalvinRematchIntro, Route102_Text_CalvinRematchDefeated)
	msgbox(Route102_Text_CalvinRematchPostBattle)
	end
}

