script Route116_EventScript_Karen {
	trainerbattle_single(TRAINER_KAREN_1, Route116_Text_KarenIntro, Route116_Text_KarenDefeat, Route116_EventScript_TryRegisterKarenAfterBattle)
	specialvar(VAR_RESULT, ShouldTryRematchBattle)
    if(var(VAR_RESULT) == TRUE) {
        trainerbattle_rematch(TRAINER_KAREN_1, Route116_Text_KarenRematchIntro, Route116_Text_KarenRematchDefeat)
	    msgbox(Route116_Text_KarenPostRematch, MSGBOX_AUTOCLOSE)
    } else {
        setvar(VAR_0x8004, TRAINER_KAREN_1)
        specialvar(VAR_RESULT, IsTrainerRegistered)
        if(var(VAR_RESULT) == FALSE) {
            if(flag(FLAG_HAS_MATCH_CALL)) {
                special(PlayerFaceTrainerAfterBattle)
                waitmovement(0)
                msgbox(Route116_Text_KarenRegister2)
                register_matchcall(TRAINER_KAREN_1)
            }
        } else {
        msgbox(Route116_Text_KarenPostBattle)
        }
    }	
	release
	end
}

script Route116_EventScript_TryRegisterKarenAfterBattle {
    if(flag(FLAG_HAS_MATCH_CALL)) {
        msgbox(Route116_Text_KarenRegister1)
	    register_matchcall(TRAINER_KAREN_1)
    }
    return
}


