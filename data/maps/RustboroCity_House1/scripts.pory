mapscripts RustboroCity_House1_MapScripts {}

script RustboroCity_House1_EventScript_Trader {
	lock
	faceplayer
    if(flag(FLAG_RUSTBORO_NPC_TRADE_COMPLETED)) {
        msgbox(RustboroCity_House1_Text_AnyPokemonCanBeCute)
    } else {
        ingame_trade(
            INGAME_TRADE_SEEDOT, 
            RustboroCity_House1_Text_IllTradeIfYouWant, 
            RustboroCity_House1_EventScript_DeclineTrade, 
            RustboroCity_House1_EventScript_NotRequestedMon,
            RustboroCity_House1_EventScript_TradeCompleted
        )
        setflag(FLAG_RUSTBORO_NPC_TRADE_COMPLETED)
    }
	release
	end
}

script RustboroCity_House1_EventScript_DeclineTrade {
	msgbox(RustboroCity_House1_Text_YouDontWantToThatsOkay)
	release
	end
}

script RustboroCity_House1_EventScript_NotRequestedMon {
	bufferspeciesname(STR_VAR_1, VAR_0x8009)
	msgbox(RustboroCity_House1_Text_DoesntLookLikeMonToMe)
	release
	end
}

script RustboroCity_House1_EventScript_TradeCompleted {
	msgbox(RustboroCity_House1_Text_AnyPokemonCanBeCute)
	release
	end
}

script RustboroCity_House1_EventScript_Hiker {
	msgbox(RustboroCity_House1_Text_AllSortsOfPlaces, MSGBOX_NPC)
	end
}

text(local) RustboroCity_House1_Text_IllTradeIfYouWant {
	"Huh? My Pok\emon is cute?\n"
	"Sure, I knew that.\p"
	"But if you really want, I'm willing\n"
	"to trade it to you.\p"
	"I'll trade you my {STR_VAR_2} for\n"
	"a {STR_VAR_1} if you want."
}

text(local) RustboroCity_House1_Text_PleaseBeGoodToMyPokemon {
	"Eheheh\.\n"
	"Please be good to my Pok\emon."
}

text(local) RustboroCity_House1_Text_DoesntLookLikeMonToMe {
	"Huh? That doesn't look anything like\n"
	"a {STR_VAR_1} to me."
}

text(local) RustboroCity_House1_Text_YouDontWantToThatsOkay {
	"Oh, if you don't want to, that's okay.\n"
	"But my Pok\emon is cute, you know\."
}

text(local) RustboroCity_House1_Text_AnyPokemonCanBeCute {
	"Any Pok\emon can be cute if you raise\n"
	"it with care and kindness."
}

text(local) RustboroCity_House1_Text_AllSortsOfPlaces {
	"In all sorts of places, there are all\n"
	"sorts of Pok\emon and people.\p"
	"I find that fascinating, so I go to all\n"
	"sorts of places."
}

