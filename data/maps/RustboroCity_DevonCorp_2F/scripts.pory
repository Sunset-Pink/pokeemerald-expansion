	msgbox(gText_NicknameThisPokemon, MSGBOX_YESNO)
	if(var(VAR_RESULT) == YES && var(VAR_TEMP_0) == MON_GIVEN_TO_PARTY) {
		call(Common_EventScript_GetGiftMonPartySlot)
		call(Common_EventScript_NameReceivedPartyMon)
	} elif(var(VAR_RESULT) == YES && var(VAR_TEMP_0) == MON_GIVEN_TO_PC) {
		call(Common_EventScript_NameReceivedBoxMon)
	}
	if(var(VAR_TEMP_0) == MON_GIVEN_TO_PC) {
		call(Common_EventScript_TransferredToPC)
	}
	return
}

script RustboroCity_DevonCorp_2F_EventScript_ReceivedTirtouga {
	setvar(VAR_TEMP_TRANSFERRED_SPECIES, SPECIES_TIRTOUGA)
	givemon(VAR_TEMP_TRANSFERRED_SPECIES, 20)
	if(var(VAR_RESULT) == MON_CANT_GIVE) {
		call(Common_EventScript_NoMoreRoomForPokemon)
		return
	}
	if(var(VAR_RESULT) == MON_GIVEN_TO_PARTY) {
		setvar(VAR_TEMP_0, MON_GIVEN_TO_PARTY)
