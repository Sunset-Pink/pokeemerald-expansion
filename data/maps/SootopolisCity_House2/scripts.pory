mapscripts SootopolisCity_House2_MapScripts {}

script SootopolisCity_House2_EventScript_ExpertF {
	lock
	faceplayer
	msgbox(SootopolisCity_House2_Text_DidYouKnowAboutMtPyreOrbs, MSGBOX_YESNO)
	call_if_eq(VAR_RESULT, YES, SootopolisCity_House2_EventScript_KnowAboutOrbs)
	call_if_eq(VAR_RESULT, NO, SootopolisCity_House2_EventScript_DontKnowAboutOrbs)
	release
	end
}

script SootopolisCity_House2_EventScript_KnowAboutOrbs {
	msgbox(SootopolisCity_House2_Text_YesTwoOrbsSideBySide)
	return
}

script SootopolisCity_House2_EventScript_DontKnowAboutOrbs {
	msgbox(SootopolisCity_House2_Text_OughtToVisitAndSee)
    return
}

text(local) SootopolisCity_House2_Text_DidYouKnowAboutMtPyreOrbs {
	"Mt. Pyre\.\p"
	"At its peak are two orbs placed side\n"
	"by side. Did you know?"
}

text(local) SootopolisCity_House2_Text_YesTwoOrbsSideBySide {
	"Yes, two orbs side by side…\p"
	"The sight of them together…\n"
	"It is somehow soothing\."
}

text(local) SootopolisCity_House2_Text_OughtToVisitAndSee {
	"Is that so?\n"
	"Perhaps you ought to visit and see\."
}

