script RustboroCity_EventScript_RivalEncounter {
    if(checkplayergender == MALE) {
        call(RustboroCity_EventScript_MayEncounter)
    } else {
        call(RustboroCity_EventScript_BrendanEncounter)
    }
	end
}

script RustboroCity_EventScript_RestoreBgm {
	savebgm(MUS_DUMMY)
	fadedefaultbgm
	return
}

script RustboroCity_EventScript_MayEncounter {
    if(flag(FLAG_DEFEATED_RIVAL_RUSTBORO)) {
        msgbox(RustboroCity_Text_MayMrBrineyHint)
        if(var(VAR_0x8008) == 0) {
            call(RustboroCity_EventScript_RestoreBgm)
        }
    } elif(flag(FLAG_MET_RIVAL_RUSTBORO)) {
        msgbox(RustboroCity_Text_MayWantToBattle, MSGBOX_YESNO)
RustboroMayBattle:
        if(var(VAR_RESULT) == YES) {
            msgbox(RustboroCity_Text_MayImNotGoingToLose)
            switch(var(VAR_STARTER_MON)) {
                case 0: trainerbattle_no_intro(TRAINER_MAY_RUSTBORO_TREECKO, RustboroCity_Text_MayDefeat)
                case 1: trainerbattle_no_intro(TRAINER_MAY_RUSTBORO_TORCHIC, RustboroCity_Text_MayDefeat)
                case 2: trainerbattle_no_intro(TRAINER_MAY_RUSTBORO_MUDKIP, RustboroCity_Text_MayDefeat)
            }
            setflag(FLAG_DEFEATED_RIVAL_RUSTBORO)
            msgbox(RustboroCity_Text_MayMrBrineyHint)
            if(var(VAR_0x8008) == 0) {
                call(RustboroCity_EventScript_RestoreBgm)
            }
        } else {
            msgbox(RustboroCity_Text_MayOhHaventRaisedPokemonEnough)
        }
    } else {
        setflag(FLAG_MET_RIVAL_RUSTBORO)
        msgbox(RustboroCity_Text_MayHiLetsRegister)
        closemessage
        delay(30)
        playfanfare(MUS_REGISTER_MATCH_CALL)
        msgbox(RustboroCity_Text_RegisteredMay)
        waitfanfare
        closemessage
        delay(30)
        setflag(FLAG_ENABLE_RIVAL_MATCH_CALL)
        setvar(VAR_RUSTBORO_CITY_STATE, 8)
        setvar(VAR_ROUTE104_STATE, 2)
        msgbox(RustboroCity_Text_MayPassedBrineyWantToBattle, MSGBOX_YESNO)
        goto(RustboroMayBattle)
    }
	releaseall
	end
}


script RustboroCity_EventScript_BrendanEncounter {
    if(flag(FLAG_DEFEATED_RIVAL_RUSTBORO)) {
        msgbox(RustboroCity_Text_BrendanMrBrineyHint)
        if(var(VAR_0x8008) == 0) {
            call(RustboroCity_EventScript_RestoreBgm)
        }
    } elif(flag(FLAG_MET_RIVAL_RUSTBORO)) {
        msgbox(RustboroCity_Text_BrendanWantToBattle, MSGBOX_YESNO)
RustboroBrendanBattle:
        if(var(VAR_RESULT) == YES) {
            msgbox(RustboroCity_Text_BrendanIWontGoEasy)
            switch(var(VAR_STARTER_MON)) {
                case 0: trainerbattle_no_intro(TRAINER_BRENDAN_RUSTBORO_TREECKO, RustboroCity_Text_BrendanDefeat)
                case 1: trainerbattle_no_intro(TRAINER_BRENDAN_RUSTBORO_TORCHIC, RustboroCity_Text_BrendanDefeat)
                case 2: trainerbattle_no_intro(TRAINER_BRENDAN_RUSTBORO_MUDKIP, RustboroCity_Text_BrendanDefeat)
            }
            setflag(FLAG_DEFEATED_RIVAL_RUSTBORO)
            msgbox(RustboroCity_Text_BrendanMrBrineyHint)
            if(var(VAR_0x8008) == 0) {
                call(RustboroCity_EventScript_RestoreBgm)
            }
        } else {
            msgbox(RustboroCity_Text_BrendanNoConfidenceInPokemon)
        }
    } else {
        setflag(FLAG_MET_RIVAL_RUSTBORO)
        msgbox(RustboroCity_Text_BrendanHiLetsRegister)
        closemessage
        delay(30)
        playfanfare(MUS_REGISTER_MATCH_CALL)
        msgbox(RustboroCity_Text_RegisteredBrendan)
        waitfanfare
        closemessage
        delay(30)
        setflag(FLAG_ENABLE_RIVAL_MATCH_CALL)
        setvar(VAR_RUSTBORO_CITY_STATE, 8)
        setvar(VAR_ROUTE104_STATE, 2)
        msgbox(RustboroCity_Text_BrendanPassedBrineyWantToBattle, MSGBOX_YESNO)
        goto(RustboroBrendanBattle)
    }
	releaseall
	end
}

