mapscripts RustboroCity_Mart_MapScripts {}

script RustboroCity_Mart_EventScript_Clerk {
	lock
	faceplayer
	message(gText_HowMayIServeYou)
	waitmessage
    if(flag(FLAG_MET_DEVON_EMPLOYEE) == FALSE) {
        pokemart(RustboroCity_Mart_Pokemart_Basic)
    } else {
        pokemart(RustboroCity_Mart_Pokemart_Expanded)
    }
    msgbox(gText_PleaseComeAgain)
    release
	end
}

mart RustboroCity_Mart_Pokemart_Basic {
    ITEM_POKE_BALL
    ITEM_POTION
    ITEM_SUPER_POTION
    ITEM_ANTIDOTE
    ITEM_PARALYZE_HEAL
    ITEM_REPEL
    ITEM_X_SPEED
    ITEM_X_ATTACK
    ITEM_X_DEFENSE
}

mart RustboroCity_Mart_Pokemart_Expanded {
	ITEM_POKE_BALL
	ITEM_TIMER_BALL
	ITEM_REPEAT_BALL
	ITEM_POTION
	ITEM_SUPER_POTION
	ITEM_ANTIDOTE
	ITEM_PARALYZE_HEAL
	ITEM_REPEL
	ITEM_X_SPEED
	ITEM_X_ATTACK
	ITEM_X_DEFENSE
}

script RustboroCity_Mart_EventScript_PokefanF {
	msgbox(RustboroCity_Mart_Text_BuyingHealsInCaseOfShroomish, MSGBOX_NPC)
	end
}

script RustboroCity_Mart_EventScript_Boy {
	msgbox(RustboroCity_Mart_Text_ShouldBuySuperPotionsInstead, MSGBOX_NPC)
	end
}

script RustboroCity_Mart_EventScript_BugCatcher {
	msgbox(RustboroCity_Mart_Text_GettingEscapeRopeJustInCase, MSGBOX_NPC)
	end
}

text(local) RustboroCity_Mart_Text_BuyingHealsInCaseOfShroomish {
	"I'm buying some Paralyz Heals and\n"
	"Antidotes.\p"
	"Just in case I run into Shroomish\n"
	"in Petalburg Woods."
}

text(local) RustboroCity_Mart_Text_ShouldBuySuperPotionsInstead {
	"My Pok\emon evolved.\n"
	"It has a lot of HP now.\p"
	"I should buy Super Potions for it\n"
	"instead of ordinary Potions."
}

text(local) RustboroCity_Mart_Text_GettingEscapeRopeJustInCase {
	"I'm getting an Escape Rope just in\n"
	"case I get lost in a cave.\p"
	"I just need to use it to get back to\n"
	"the entrance."
}

