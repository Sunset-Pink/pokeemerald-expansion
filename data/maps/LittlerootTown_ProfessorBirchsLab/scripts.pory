text(local) Text_LittlerootTown_ProfessorBirchsLab_Pokeballs_BeforeSelection {
	"Better talk to Prof. Birch\n"
	"before messing with his stuff."
}

script Script_LittlerootTown_ProfessorBirchsLab_GiveStarter {
	if(flag(FLAG_SHINY_STARTERS)) {
		givemon(VAR_0x8006, 5, shinyMode=TRUE)
	} else {
		givemon(VAR_0x8006, 5)
	}
}

script Script_LittlerootTown_ProfessorBirchsLab_Starter_PostChose {
	setvar(VAR_QUEST_INTRO_STATE, 7)
	msgbox(gText_NicknameThisPokemon, MSGBOX_YESNO)
	hidemonpic
	if(var(VAR_RESULT) == YES) {
		call(Common_EventScript_GetGiftMonPartySlot)
        call(Common_EventScript_NameReceivedPartyMon)
	}
	setflag(FLAG_SYS_POKEMON_GET)
	clearflag(FLAG_HIDE_MAP_NAME_POPUP)
	call(Rival_MoveTo_Rout103)
	switch(var(VAR_STARTER_MON)) {
		case 0:
			msgbox(Text_LittlerootTown_ProfessorBirchsLab_Birch_Starter_RivalsChoice_Torchic)
		case 1:
			msgbox(Text_LittlerootTown_ProfessorBirchsLab_Birch_Starter_RivalsChoice_Mudkip)
		case 2:
			msgbox(Text_LittlerootTown_ProfessorBirchsLab_Birch_Starter_RivalsChoice_Treecko)
	}
}

// Move Rival to Route103 after Birch mentions fighting them.
script(local) Rival_MoveTo_Rout103 {
	// hide Rival in House
	if(checkplayergender == MALE) {
		setflag(FLAG_HIDE_LITTLEROOT_TOWN_MAYS_HOUSE_RIVAL_BEDROOM)
	} else {
		setflag(FLAG_HIDE_LITTLEROOT_TOWN_BRENDANS_HOUSE_RIVAL_BEDROOM)
	}
	// Set Rival state to route 103 state.
	setvar(VAR_RIVAL_STATE, 2)
	return 
}

script Script_LittlerootTown_ProfessorBirchsLab_Interact_Aide {
	lock
	faceplayer
	if(var(VAR_QUEST_INTRO_STATE) < 5) {
		msgbox(Text_LittlerootTown_ProfessorBirchsLab_Aide_Early, MSGBOX_NPC)
	}elif(var(VAR_QUEST_INTRO_STATE) == 6) {
		if(flag(FLAG_MONOTYPE_STARTERS)) {
			call(Script_LittlerootTown_ProfessorBirchsLab_Interact_Aide_InformMono)
		} else {
			call(Script_LittlerootTown_ProfessorBirchsLab_Interact_Aide_InformGen)
		}
	} else {
		msgbox(Text_LittlerootTown_ProfessorBirchsLab_Aide_FieldWork)
	}
	release
	end
}

text(local) Text_LittlerootTown_ProfessorBirchsLab_Aide_Early {
	"Aide: Unfortunatley preperations\n"
	"aren't done yet.\l"
	"We probably would be done already\l"
	"but the Prof. had to run off to\l"
	"Route 101 this morning.\p"
	"He appearently got overwhelmed\n"
	"by some Zigzagoons and raced back here."
}

text(local) Text_LittlerootTown_ProfessorBirchsLab_Aide_FieldWork{
	"Hunh? Prof. Birch?\p"
	"The Prof's away on fieldwork.\n"
	"Ergo, he isn't here.\p"
	"Oh, let me explain what fieldwork is.\p"
	"It is to study things in the natural\n"
	"environment, like fields and mountains,\l"
	"instead of a laboratory.\p"
	"The Prof. isn't one for doing desk work.\n"
	"He's the type of person who would\l"
	"rather go outside and experience\l"
	"things than read about them here."
}

script Script_LittlerootTown_ProfessorBirchsLab_Interact_Aide_InformMono {
	switch(var(VAR_TEMP_F)) {
		case 0:  msgbox(Text_Aide_Mono_Fighting, MSGBOX_NPC)
		case 1:  msgbox(Text_Aide_Mono_Flying, MSGBOX_NPC)
		case 2:  msgbox(Text_Aide_Mono_Poison, MSGBOX_NPC)
		case 3:  msgbox(Text_Aide_Mono_Ground, MSGBOX_NPC)
		case 4:  msgbox(Text_Aide_Mono_Rock, MSGBOX_NPC)
		case 5:  msgbox(Text_Aide_Mono_Bug, MSGBOX_NPC)
		case 6:  msgbox(Text_Aide_Mono_Ghost, MSGBOX_NPC)
		case 7:  msgbox(Text_Aide_Mono_Steel, MSGBOX_NPC)
		case 8:  msgbox(Text_Aide_Mono_Electric, MSGBOX_NPC)
		case 9:  msgbox(Text_Aide_Mono_Psychic, MSGBOX_NPC)
		case 10: msgbox(Text_Aide_Mono_Ice, MSGBOX_NPC)
		case 11: msgbox(Text_Aide_Mono_Dragon, MSGBOX_NPC)
		case 12: msgbox(Text_Aide_Mono_Dark, MSGBOX_NPC)
		case 13: msgbox(Text_Aide_Mono_Normal, MSGBOX_NPC)
		case 14: msgbox(Text_Aide_Mono_Fairy, MSGBOX_NPC)
		default: msgbox("WTF did you do to see this message!?", MSGBOX_NPC)
	}
}

