script LittlerootTown_Sign_BrendansHouse {
	if(checkplayergender == MALE) {
		msgbox(LittlerootTown_HouseSign_Player_Text, MSGBOX_SIGN)
	} else {
		msgbox(LittlerootTown_HouseSign_Rival_Text, MSGBOX_SIGN)
	}
}

script LittlerootTown_Sign_MaysHouse {
	if(checkplayergender == FEMALE) {
		msgbox(LittlerootTown_HouseSign_Player_Text, MSGBOX_SIGN)
	} else {
		msgbox(LittlerootTown_HouseSign_Rival_Text, MSGBOX_SIGN)
	}
}

text(local) LittlerootTown_HouseSign_Player_Text {
	"{PLAYER}'s House."
}

text(local) LittlerootTown_HouseSign_Rival_Text {
	"Prof. Birch's House."
}

script LittlerootTown_Twin {
	lock
	faceplayer
	if(var(VAR_QUEST_INTRO_STATE) < 6) {
		msgbox(LittlerootTown_Twin_ZigzagoonHorde_Text, MSGBOX_NPC)
	}elif(flag(FLAG_ADVENTURE_STARTED)) {
		goto(LittlerootTown_EventScript_GoodLuck)
	} else {
		msgbox(Text_LittlerootTown_Twin_PokemonWillJumpOut_Text, MSGBOX_NPC)
	}
	releaseall
	end
}
text(local) Text_LittlerootTown_Twin_PokemonWillJumpOut_Text {
	"Um, um, um!\p"
	"If you go outside and go in the grass,\n"
	"wild Pok\emon will jump out!"
}

text(local) LittlerootTown_Twin_ZigzagoonHorde_Text {
	"Oh wow!\p"
	"There are so many Zigzagoons\n"
	"out to play today.\l"
	"Prof. Birch just ran back to\l"
	"to his lab, to escape them.\p"
	"Is it just me, or does that one\n"
	"in the back look a bit strange?"
}

script LittlerootTown_Twin_Reposition_ByRoute {
	setobjectxyperm(LOCALID_LITTLEROOT_TWIN 10, 2)
	setobjectmovementtype(LOCALID_LITTLEROOT_TWIN, MOVEMENT_TYPE_FACE_UP)
}

script LittlerootTown_Twin_Reposition_Default {
	setobjectxyperm(LOCALID_LITTLEROOT_TWIN, 16, 10)
	setobjectmovementtype(LOCALID_LITTLEROOT_TWIN, MOVEMENT_TYPE_WANDER_LEFT_AND_RIGHT)
}

