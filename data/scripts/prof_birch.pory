script Script_ProfBirch_Interact_Pokedex_AskForRating {
	msgbox(gBirchDexRatingText_AreYouCurious, MSGBOX_YESNO)
	if(var(VAR_RESULT) == YES) {
		call(Script_ProfBirch_Interact_Pokedex_Rate)
	} else {
		msgbox(gBirchDexRatingText_Cancel)
	}
	release
	end
}

script Script_ProfBirch_Interact_Pokedex_Rate {
	setvar(VAR_0x8004, 0)
	specialvar(VAR_RESULT, ScriptGetPokedexInfo)
	copyvar(VAR_0x8008, VAR_0x8005)
	copyvar(VAR_0x8009, VAR_0x8006)
	copyvar(VAR_0x800A, VAR_RESULT)
	buffernumberstring(STR_VAR_1, VAR_0x8008) // Num Hoenn Seen
	buffernumberstring(STR_VAR_2, VAR_0x8009) // Num Hoenn Caught
	msgbox(gBirchDexRatingText_SoYouveSeenAndCaught)
	call(Script_ProfBirch_Interact_Pokedex_Rate_Show)
	setvar(VAR_0x8004, 1)
	specialvar(VAR_RESULT, ScriptGetPokedexInfo)
	copyvar(VAR_0x8008, VAR_0x8005)
	copyvar(VAR_0x8009, VAR_0x8006)
	buffernumberstring(STR_VAR_1, VAR_0x8008) // Num National Seen
	buffernumberstring(STR_VAR_2, VAR_0x8009) // Num National Caught
	msgbox(gBirchDexRatingText_OnANationwideBasis)
	return
}

script Script_ProfBirch_Interact_Pokedex_Rate_Show {
	copyvar(VAR_0x8004, VAR_0x8009)
	special(ShowPokedexRatingMessage)
	waitmessage
	waitbuttonpress
	return
}

script Script_ProfBirch_Interact_Register {
	msgbox(MatchCall_Text_BirchRegisterCall)
	closemessage
	delay(30)
	playfanfare(MUS_REGISTER_MATCH_CALL)
	msgbox(MatchCall_Text_RegisteredBirch)
	waitfanfare
	closemessage
	delay(30)
	setflag(FLAG_ENABLE_PROF_BIRCH_MATCH_CALL)
	setvar(VAR_REGISTER_BIRCH_STATE, 2)
	release
	end
}

script Script_ProfBirch_Interact {
	lockall
	faceplayer
	if(var(VAR_QUEST_INTRO_STATE) < 5) {
		call(Script_ProfBirch_Interact_Early)
	} elif(var(VAR_QUEST_INTRO_STATE) == 5) {
		call(Script_ProfBirch_Interact_Starter)
	} elif(var(VAR_QUEST_INTRO_STATE) == 6) {
		call(Script_ProfBirch_Interact_Starter_ChangeSelection)
	}
	release
	end
}

script Script_ProfBirch_Interact_Early {
	msgbox(Text_ProfBirch_Early)
}

text(local) Text_ProfBirch_Early {
	"Prof. Birch: Oh\. Um\.\p"
	"Hi there, I am Prof. Birch.\n"
	"its nice to meet you I have heard\l"
	"all about you from your Mom.\p"
	"Sorry, I wasn't expecting you\n"
	"until after you finished moving in.\l"
	"I'm afraid I am still in the midst\l"
	"of setting things up.\p"
	"Come back once you finish moving in.\n"
	"And say Hi to your Mom for me."
}

script Script_ProfBirch_Interact_Starter {
	if(checkplayergender == MALE) {
		msgbox(Text_ProfBirch_Welcome_Male)
	} else {
		msgbox(Text_ProfBirch_Welcome_Female)
	}
	closemessage
	setvar(VAR_QUEST_INTRO_STATE, 6)
	call(Script_ProfBirch_Interact_Starter_ChangeSelection)
	return
}

text(local) Text_ProfBirch_Welcome_Male {
	"Prof. Birch: Hello there!\n"
	"I'm Prof. Birch, and you must\l"
	"be {PLAYER}. I have heard alot\l"
	"about you from your Mom.\p"
	"You just missed my daughter, {RIVAL},\n"
	"she stopped by and grabbed one of my\l"
	"starters before rushing out of here.\p"
	"I told her to be on the lookout for a\n"
    "trainer named {PLAYER}, who just moved\l"
    "into the house next door!\p"
    "I hope the two of you can be friends\n"
    "who can start a new Pokémon journey\l"
    "together.\p"
	"I agreed to give you a Pok\emon, as\n"
	"part of a welcome gift, your Mom\l"
	"put together. How about this, if\l"
	"you can beat {RIVAL}, I will gift\l"
	"you a Pok\edex as well.\p" 
    "I'll tell you which Starter she chose\n"
    "after you pick yours, it wouldn't be\l"
    "fair if you knew before you picked!\p"
	"I can let you choose from any\n"
	"Generation of Starter Pok\emon, just\l"
	"ask me if you want to change them.\l"
	"Also my aide might be able to tell\l"
	"you more about each starter choice."
}

