mapscripts LittlerootTown_MaysHouse_2F_MapScripts {
	MAP_SCRIPT_ON_TRANSITION: Script_LittlerootTown_MaysHouse_2F_OnTransition
	MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE [
		VAR_SECRET_BASE_INITIALIZED, 0: LittlerootTown_MaysHouse_2F_EventScript_CheckInitDecor
	]
}

script(local) Script_LittlerootTown_MaysHouse_2F_OnTransition {
	if(var(VAR_QUEST_INTRO_STATE) == 2 && checkplayergender == FEMALE) {
		setvar(VAR_QUEST_INTRO_STATE, 3) //Been upstairs need to accept gifts
	}

	// After Intro but before Route 103
	if(var(VAR_RIVAL_STATE) == 1 && checkplayergender == MALE) {
		setobjectxyperm(LOCALID_RIVALS_HOUSE_2F_RIVAL, 8, 2)
		setobjectmovementtype(LOCALID_RIVALS_HOUSE_2F_RIVAL, MOVEMENT_TYPE_FACE_UP)
	}

	call(SecretBase_EventScript_SetDecorationFlags)
	setvar(VAR_SECRET_BASE_INITIALIZED, 0)
	end
}

script LittlerootTown_MaysHouse_2F_EventScript_CheckInitDecor {
	if(checkplayergender == FEMALE) {
		goto(SecretBase_EventScript_InitDecorations)
	}
	end
}

script LittlerootTown_MaysHouse_2F_EventScript_PC {
	lockall
	if(checkplayergender == FEMALE) {
		call(LittlerootTown_PlayersHouse_2F_EventScript_CheckPlayersPC)
	} else {
		msgbox(gText_PokemonTrainerSchoolEmail)
	}
	releaseall
	end
}


script Script_LittlerootTown_MaysHouse_2F_Interact_GameCube {
	if(checkplayergender == FEMALE) {
		call(Script_PlayersHouse_2F_Interact_GameCube)
	} else {
		call(Script_RivalsHouse_2F_Interact_GameCube)
	}
	release
	end
}

script Script_LittlerootTown_MaysHouse_2F_Interact_Notebook {
	if(checkplayergender == FEMALE) {
		call(Script_PlayersHouse_2F_Interact_Notebook)
	} else {
		call(Script_RivalsHouse_2F_Interact_Notebook)
	}
	release
	end
}