mapscripts Route104_MapScripts {
	MAP_SCRIPT_ON_FRAME_TABLE [
		VAR_BOARD_BRINEY_BOAT_STATE, 1: Route104_EventScript_StartSailToDewford
	]
	MAP_SCRIPT_ON_TRANSITION: Route104_OnTransition
}

script Route104_EventScript_StartSailToDewford {
	lockall
	call(Route104_EventScript_SailToDewford)
	release
	return
}

script(local) Route104_OnTransition {
	call(Common_EventScript_SetupRivalGfxId)
	call(Route104_EventScript_TrySetRivalPos)
	call(Route104_EventScript_ShowOrHideWhiteHerbFlorist)
	end
}

script Route104_EventScript_ShowOrHideWhiteHerbFlorist {
	if(!flag(FLAG_MET_PRETTY_PETAL_SHOP_OWNER) || !flag(FLAG_BADGE03_GET)) {
		setflag(FLAG_HIDE_ROUTE_104_WHITE_HERB_FLORIST)
	} else {
		clearflag(FLAG_HIDE_ROUTE_104_WHITE_HERB_FLORIST)
	}
	return
}

script Route104_EventScript_TrySetRivalPos {
	if(var(VAR_BOARD_BRINEY_BOAT_STATE) >= 1 || flag(FLAG_MET_RIVAL_RUSTBORO) || !flag(FLAG_REGISTER_RIVAL_POKENAV)) {
		return
	}
	setobjectxyperm(LOCALID_ROUTE104_RIVAL, 17, 52)
	return
}


script Route104_EventScript_Rival {
	lockall
	setvar(VAR_0x8008, 1)
	applymovement(LOCALID_ROUTE104_RIVAL, Common_Movement_FacePlayer)
	waitmovement(0)
	if(checkplayergender == MALE) {
		call(Route104_EventScript_MayEncounter)
	} else {
		call(Route104_EventScript_BrendanEncounter)
	}
	releaseall
	end
}

script Route104_EventScript_RivalTrigger {
	lockall
	setflag(FLAG_HIDE_RUSTBORO_CITY_RIVAL)
	setvar(VAR_RUSTBORO_CITY_STATE, 8)
	setvar(VAR_ROUTE104_STATE, 2)
	applymovement(LOCALID_PLAYER, Common_Movement_WalkInPlaceFasterUp)
	waitmovement(0)
	delay(10)
	addobject(LOCALID_ROUTE104_RIVAL)
	clearflag(FLAG_HIDE_ROUTE_104_RIVAL)
	applymovement(LOCALID_PLAYER, moves(
		lock_facing_direction
		walk_down
		unlock_facing_direction
	))
	waitmovement(0)
	applymovement(LOCALID_ROUTE104_RIVAL, moves(walk_down))
	waitmovement(0)
	delay(20)
	setvar(VAR_0x8008, 0)
	if(checkplayergender == MALE) {
		playbgm(MUS_ENCOUNTER_MAY, TRUE)
	} else {
		playbgm(MUS_ENCOUNTER_BRENDAN, TRUE)
	}
	playse(SE_PIN)
	applymovement(LOCALID_ROUTE104_RIVAL, Common_Movement_ExclamationMark)
	waitmovement(0)
	applymovement(LOCALID_ROUTE104_RIVAL, Common_Movement_Delay48)
	waitmovement(0)
	if(checkplayergender == MALE) {
		call(Route104_EventScript_MayEncounter)
	} else {
		call(Route104_EventScript_BrendanEncounter)
	}
	releaseall
	return
}

script Route104_EventScript_MayEncounter {
	if(flag(FLAG_DEFEATED_RIVAL_ROUTE_104)) {
		msgbox(Route104_Text_MayPostBattle)
	}
	elif (flag(FLAG_REGISTER_RIVAL_POKENAV)) {
		msgbox(Route104_Text_MayLetsBattle, MSGBOX_YESNO)
		if(var(VAR_RESULT) == YES) {
			call(Route104_EventScript_BattleMay)
		} else {
			msgbox(Route104_Text_MayHaventRaisedPokemon)
		}
	} else {
		setflag(FLAG_REGISTER_RIVAL_POKENAV)
		msgbox(Route104_Text_MayWeShouldRegister)
		closemessage
		delay(30)
		playfanfare(MUS_REGISTER_MATCH_CALL)
		msgbox(Route104_Text_RegisteredMay)
		waitfanfare
		closemessage
		delay(3)
		setflag(FLAG_ENABLE_RIVAL_MATCH_CALL)
		applymovement(LOCALID_PLAYER, Route104_Movement_PlayerFaceRival)
		applymovement(LOCALID_ROUTE104_RIVAL, moves(walk_slow_left))
		msgbox(Route104_Text_MayHowsYourPokedex)
		closemessage
		waitmovement(0)
		applymovement(LOCALID_ROUTE104_RIVAL, Route104_Movement_RivalApproachPlayer)
		waitmovement(0)
		copyobjectxytoperm(LOCALID_ROUTE104_RIVAL)
		msgbox(Route104_Text_MayMinesDecentLetsBattle, MSGBOX_YESNO)
		if(var(VAR_RESULT) == YES) {
			call(Route104_EventScript_BattleMay)
		} else {
			msgbox(Route104_Text_MayHaventRaisedPokemon)
		}
	}
	call(Route104_EventScript_RestoreMusic)
	releaseall
	return
}

movement Route104_Movement_RivalApproachPlayer {
	walk_down
	face_right
}

movement Route104_Movement_PlayerFaceRival {
	delay_4
	walk_in_place_faster_left
}

script Route104_EventScript_MayAskToBattle {
	
	releaseall
	end
}

script Route104_EventScript_BattleMay {
	msgbox(Route104_Text_MayIntro)
	switch(var(VAR_STARTER_MON)) {
		case 0: trainerbattle_no_intro(TRAINER_MAY_RUSTBORO_TREECKO, Route104_Text_MayDefeat)
		case 1: trainerbattle_no_intro(TRAINER_MAY_RUSTBORO_TORCHIC, Route104_Text_MayDefeat)
		case 2: trainerbattle_no_intro(TRAINER_MAY_RUSTBORO_MUDKIP, Route104_Text_MayDefeat)
	}
	setflag(FLAG_DEFEATED_RIVAL_ROUTE_104)
	msgbox(Route104_Text_MayPostBattle)
	return
}

script Route104_EventScript_RestoreMusic {
	savebgm(MUS_DUMMY)
	fadedefaultbgm
	return
}

script Route104_EventScript_BrendanEncounter {
	if(flag(FLAG_DEFEATED_RIVAL_ROUTE_104)) {
		msgbox(Route104_Text_MayPostBattle)
	}
	elif (flag(FLAG_REGISTER_RIVAL_POKENAV)) {
		msgbox(Route104_Text_BrendanLetsBattle, MSGBOX_YESNO)
		if(var(VAR_RESULT) == YES) {
			call(Route104_EventScript_BattleBrendan)
		} else {
			msgbox(Route104_Text_BrendanNoConfidence)
		}
	} else {
		setflag(FLAG_REGISTER_RIVAL_POKENAV)
		msgbox(Route104_Text_BrendanWeShouldRegister)
		closemessage
		delay(30)
		playfanfare(MUS_REGISTER_MATCH_CALL)
		msgbox(Route104_Text_RegisteredBrendan)
		waitfanfare
		closemessage
		delay(3)
		setflag(FLAG_ENABLE_RIVAL_MATCH_CALL)
		applymovement(LOCALID_PLAYER, Route104_Movement_PlayerFaceRival)
		applymovement(LOCALID_ROUTE104_RIVAL, moves(walk_slow_left))
		msgbox(Route104_Text_BrendanHowsYourPokedex)
		closemessage
		waitmovement(0)
		applymovement(LOCALID_ROUTE104_RIVAL, Route104_Movement_RivalApproachPlayer)
		waitmovement(0)
		copyobjectxytoperm(LOCALID_ROUTE104_RIVAL)
		msgbox(Route104_Text_BrendanDoingGreatLetsBattle, MSGBOX_YESNO)
		if(var(VAR_RESULT) == YES) {
			call(Route104_EventScript_BattleBrendan)
		} else {
			msgbox(Route104_Text_BrendanNoConfidence)
		}
	}
	call(Route104_EventScript_RestoreMusic)
	releaseall
	return
}

script Route104_EventScript_BattleBrendan {
	msgbox(Route104_Text_BrendanIntro)
	switch(var(VAR_STARTER_MON)) {
		case 0: trainerbattle_no_intro(TRAINER_BRENDAN_RUSTBORO_TREECKO, Route104_Text_BrendanDefeat)
		case 1: trainerbattle_no_intro(TRAINER_BRENDAN_RUSTBORO_TORCHIC, Route104_Text_BrendanDefeat)
		case 2: trainerbattle_no_intro(TRAINER_BRENDAN_RUSTBORO_MUDKIP, Route104_Text_BrendanDefeat)
	}
	setflag(FLAG_DEFEATED_RIVAL_ROUTE_104)
	msgbox(Route104_Text_BrendanPostBattle)
	return
}

script Route104_EventScript_ExpertF {
	lock
	faceplayer
	if(!flag(FLAG_RECEIVED_CHESTO_BERRY_ROUTE_104)) {
		msgbox(Route104_Text_PlantBerriesInSoilTakeThis)
		giveitem(ITEM_CHESTO_BERRY)
		if(var(VAR_RESULT) == FALSE) {
			goto(Common_EventScript_ShowBagIsFull)
		}
		setflag(FLAG_RECEIVED_CHESTO_BERRY_ROUTE_104)
	}
	msgbox(Route104_Text_TrainersOftenMakeMonHoldBerries)
	release
	end
}

script Route104_EventScript_WhiteHerbFlorist {
	lock
	faceplayer
	if(!flag(FLAG_RECEIVED_WHITE_HERB)) {
		msgbox(Route104_Text_DontNeedThisTakeIt)
		giveitem(ITEM_WHITE_HERB)
		if(var(VAR_RESULT) == FALSE) {
			goto(Common_EventScript_ShowBagIsFull)
		}
		setflag(FLAG_RECEIVED_WHITE_HERB)
	} else {
		msgbox(Route104_Text_FlowerShopSellingSaplings)
	}
	release
	end
}

