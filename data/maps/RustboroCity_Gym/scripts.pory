script RustboroCity_Gym_EventScript_RegisterRoxanne {
	lockall
	pokenavcall(RustboroCity_Gym_Text_RoxanneRegisterCall)
	waitmessage
	delay(30)
	playfanfare(MUS_REGISTER_MATCH_CALL)
	msgbox(RustboroCity_Gym_Text_RegisteredRoxanne)
	waitfanfare
	closemessage
	delay(30)
	setflag(FLAG_ENABLE_ROXANNE_MATCH_CALL)
	clearflag(FLAG_ENABLE_ROXANNE_FIRST_CALL)
	releaseall
	end
}

text(local) RustboroCity_Gym_Text_StoneBadgeInfoTakeThis {
	"Roxanne: The Stone Badge allow you to\n"
	"use the HM move Cut outside of battle.\p"
	"Please take this with you, too."
}

script RustboroCity_Gym_EventScript_GiveRockTomb {
	giveitem(ITEM_TM_ROCK_TOMB)
	if(var(VAR_RESULT) == FALSE) {
		goto(Common_EventScript_ShowBagIsFull)
	}
	if(flag(FLAG_RECEIVED_ANY_TM)) {
		msgbox(RustboroCity_Gym_Text_ExplainRockTomb)
	} else {
		msgbox(RustboroCity_Gym_Text_ExplainRockTomb_WithReminder)
	}
	return
}

text(local) RustboroCity_Gym_Text_ExplainRockTomb {
    "Roxanne: That Technical Machine, TM39,\n"
	"contains Rock Tomb.\p"
	"It not only inflicts damage by dropping\n"
	"rocks, it also lowers Speed.\p"
	"If you use a TM, it instantly teaches\n"
	"the move to a Pok\emon.\p"
	"You can now buy more copies of the\n"
	"Rock Tomb TM, at the Rustboro Gym Store."
}
text(local) RustboroCity_Gym_Text_ExplainRockTomb_WithReminder {
    "That Technical Machine, TM39,\n"
	"contains Rock Tomb.\p"
	"It not only inflicts damage by dropping\n"
	"rocks, it also lowers Speed.\p"
	"If you use a TM, it instantly teaches\n"
	"the move to a Pok\emon.\p"
	"Remember, a TM can be used only once,\n"
	"so think before you use it."
	"You can now buy more copies of the\n"
	"Rock Tomb TM, at the Rustboro Gym Store."
}

text(local) RustboroCity_Gym_Text_RoxannePostBattle {
	"Since you are so strong, you should\n"
	"challenge other Gym Leaders.\p"
	"By battling many Trainers, you should\n"
	"learn many things."
}


script RustboroCity_Gym_EventScript_RoxanneDefeated {
	// Badge level before victory
	switch(var(VAR_STONE_BADGE_LEVEL)) {
		case 9:call(RoxanneDefeat_Master)
		case 8: call(RoxanneDefeat_Master)
		case 7: call(RoxanneDefeat_Ultra)
		case 6: call(RoxanneDefeat_Hyper)
		case 5:	call(RoxanneDefeat_Platinum)
		case 4:	call(RoxanneDefeat_Diamond)
		case 3:	call(RoxanneDefeat_Gold)
		case 2: call(RoxanneDefeat_Bronze)
		case 1:	call(RoxanneDefeat_Silver)
		case 0: call(RoxanneDefeat_Normal)
	}
	release
	end
}

script(local) RoxanneDefeat_Normal {
	message(RustboroCity_Gym_Text_ReceivedStoneBadge_Normal)
	waitmessage
	call(Common_EventScript_PlayGymBadgeFanfare)
	msgbox(RustboroCity_Gym_Text_StoneBadgeInfoTakeThis)

	// Set Rustboro City Gym Victory Result
	setflag(FLAG_BADGE01_GET)
	addvar(VAR_STONE_BADGE_LEVEL, 1)

	// Advance Rustboro City state
	setvar(VAR_RUSTBORO_CITY_STATE, 1)
	
	// Mark Trainers as cleared.
	setvar(VAR_0x8008, 1)
	call(Common_EventScript_SetGymTrainers)

	// Advance Petalburg Gym State
	addvar(VAR_PETALBURG_GYM_STATE, 1)
	if(var(VAR_PETALBURG_GYM_STATE) == 6 ) {
		call(Common_EventScript_ReadyPetalburgGymForBattle)
	}

	call(RustboroCity_Gym_EventScript_GiveRockTomb)
	return
}

script(local) RoxanneDefeat_Bronze {
	addvar(VAR_STONE_BADGE_LEVEL, 1)
	return
}

