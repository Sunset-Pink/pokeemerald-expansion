script Route104_EventScript_SailToDewford {
	setobjectsubpriority(LOCALID_ROUTE104_BRINEY, MAP_ROUTE104, 0)
	setobjectsubpriority(LOCALID_PLAYER, MAP_ROUTE104, 0)
	applymovement(LOCALID_ROUTE104_BRINEY, moves(
		walk_down * 2
	))
	waitmovement(0)
	removeobject(LOCALID_ROUTE104_BRINEY)
	applymovement(LOCALID_PLAYER, moves(
		walk_left
		walk_down * 2
	))
	waitmovement(0)
	hideobjectat(LOCALID_PLAYER, MAP_ROUTE104)
	call(Common_EventScript_PlayBrineysBoatMusic)
	if(flag(FLAG_ENABLE_NORMAN_MATCH_CALL)) {
		call(Route104_EventScript_SailToDewfordNoCall)
	} else {
		call(Route104_EventScript_SailToDewfordDadCalls)
	}
	call(Route104_EventScript_ArriveInDewford)
	return
}

script Route104_EventScript_SailToDewfordNoCall {
	applymovement(LOCALID_ROUTE104_BOAT, Route104_Movement_SailToDewford)
	applymovement(LOCALID_PLAYER, Route104_Movement_SailToDewford)
	waitmovement(0)
	return
}

script Route104_EventScript_SailToDewfordDadCalls {
	applymovement(LOCALID_ROUTE104_BOAT, Route104_Movement_SailToDewfordBeforeDadCalls)
	applymovement(LOCALID_PLAYER, Route104_Movement_SailToDewfordBeforeDadCalls)
	waitmovement(0)
	pokenavcall(Route104_Text_DadPokenavCall)
	waitmessage
	delay(30)
	playfanfare(MUS_REGISTER_MATCH_CALL)
	msgbox(Route104_Text_RegisteredDadInPokenav)
	waitfanfare
	closemessage
	delay(30)
	setflag(FLAG_ENABLE_NORMAN_MATCH_CALL)
	applymovement(LOCALID_PLAYER, Route104_Movement_SailToDewfordAfterDadCalls)
	applymovement(LOCALID_ROUTE104_BOAT, Route104_Movement_SailToDewfordAfterDadCalls, MAP_ROUTE104)
	waitmovement(LOCALID_ROUTE104_BOAT, MAP_ROUTE104)
	waitmovement(0)
	return
}

script Route104_EventScript_ArriveInDewford {
	delay(50)
	applymovement(LOCALID_PLAYER, moves(walk_down))
	waitmovement(0)
	call(Common_EventScript_StopBrineysBoatMusic)
	showobjectat(LOCALID_PLAYER, MAP_DEWFORD_TOWN)
	applymovement(LOCALID_PLAYER, moves(
		walk_down
		walk_left
		walk_in_place_faster_right
	))
	waitmovement(0)
	setobjectxyperm(LOCALID_DEWFORD_BRINEY, 12, 8)
	addobject(LOCALID_DEWFORD_BRINEY)
	setobjectsubpriority(LOCALID_DEWFORD_BRINEY, MAP_DEWFORD_TOWN, 0)
	clearflag(FLAG_HIDE_MR_BRINEY_DEWFORD_TOWN)
	applymovement(LOCALID_DEWFORD_BRINEY, moves(
		walk_down
		walk_in_place_faster_left
	))
	waitmovement(0)
	addobject(LOCALID_DEWFORD_BOAT)
	clearflag(FLAG_HIDE_MR_BRINEY_BOAT_DEWFORD_TOWN)
	call(Common_EventScript_StopBrineysBoatMusic)
	setflag(FLAG_HIDE_ROUTE_104_MR_BRINEY_BOAT)
	hideobjectat(LOCALID_ROUTE104_BOAT, MAP_ROUTE104)
	copyvar(VAR_BRINEY_LOCATION, VAR_0x8008)
	resetobjectsubpriority(LOCALID_PLAYER, MAP_ROUTE104)
	resetobjectsubpriority(LOCALID_DEWFORD_BRINEY, MAP_DEWFORD_TOWN)
	copyobjectxytoperm(LOCALID_DEWFORD_BRINEY)
	setvar(VAR_BOARD_BRINEY_BOAT_STATE, 0)
	if(!flag(FLAG_DELIVERED_STEVEN_LETTER)) {
		msgbox(Route104_Text_LandedInDewfordDeliverLetter)
	} else {
		msgbox(DewfordTown_Text_BrineyLandedInDewford)
	}
	releaseall
	end
}

movement Route104_Movement_SailToDewfordBeforeDadCalls {
	walk_down * 4
	walk_fast_down * 4
	walk_faster_down * 12
	walk_fast_down * 4
	walk_fast_right * 2
	walk_faster_right * 6
	walk_fast_right * 2
	walk_fast_down * 4
	walk_faster_down * 59
}

movement Route104_Movement_SailToDewfordAfterDadCalls {
	walk_faster_down * 24
	walk_fast_down * 4
	walk_fast_right * 4
	walk_faster_right * 41
	walk_fast_right * 4
	walk_right * 2
	walk_down * 2
	walk_fast_down * 15
	walk_down * 2
}

movement Route104_Movement_SailToDewford {
	walk_down * 4
	walk_fast_down * 4
	walk_faster_down * 12
	walk_fast_down * 4
	walk_fast_right * 2
	walk_faster_right * 6
	walk_fast_right * 2
	walk_fast_down * 4
	walk_faster_down * 83
	walk_fast_down * 4
	walk_fast_right * 4
	walk_faster_right * 40
	walk_fast_right * 4
	walk_right * 2
	walk_down * 2
	walk_fast_down * 15
	walk_down * 2
}

