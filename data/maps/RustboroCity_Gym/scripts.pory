script RustboroCity_Gym_EventScript_GymStatue {
	switch(var(VAR_STONE_BADGE_LEVEL)) {
		case 0: msgbox(RustboroCity_Gym_Text_GymStatue, MSGBOX_SIGN)
		case 1: msgbox(RustboroCity_Gym_Text_Certified_Normal, MSGBOX_SIGN)
		case 2: msgbox(RustboroCity_Gym_Text_Certified_Bronze, MSGBOX_SIGN)
		case 3: msgbox(RustboroCity_Gym_Text_Certified_Silver, MSGBOX_SIGN)
		case 4: msgbox(RustboroCity_Gym_Text_Certified_Gold, MSGBOX_SIGN)
		case 5: msgbox(RustboroCity_Gym_Text_Certified_Diamond, MSGBOX_SIGN)
		case 6: msgbox(RustboroCity_Gym_Text_Certified_Platinum, MSGBOX_SIGN)
		case 7: msgbox(RustboroCity_Gym_Text_Certified_Ultra, MSGBOX_SIGN)
		case 8: msgbox(RustboroCity_Gym_Text_Certified_Hyper, MSGBOX_SIGN)
		case 9: msgbox(RustboroCity_Gym_Text_Certified_Master, MSGBOX_SIGN)
	}
	return
}

